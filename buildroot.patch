+	for moddir in "${sysroot_modules_d}"/[0-9][0-9]*; do
+		[ -d "${moddir}" ] || continue
+		name="$(basename "${moddir}")"
+		if [ ! -e "${dracutbasedir}/modules.d/${name}" ]; then
+			ln -s "${moddir}" "${dracutbasedir}/modules.d/${name}"
+			staged_modules+=("${dracutbasedir}/modules.d/${name}")
+		fi
+	done
+	trap 'for m in "${staged_modules[@]}"; do rm -f "$m"; done' EXIT
+fi
