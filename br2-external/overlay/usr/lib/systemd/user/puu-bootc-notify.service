[Unit]
Description=Notify the operator about a pending bootc reboot
ConditionPathExists=/run/puu/upgrade-pending
After=gnome-session-initialized.target

[Service]
Type=oneshot
ExecStart=/usr/bin/notify-send --urgency=normal --expire-time=0 "System update ready" "A new Puu image is staged. Reboot to apply it."

[Install]
WantedBy=graphical-session.target
