[Unit]
Description=Watch ESP for new UKIs to re-sign
ConditionPathExists=/var/lib/sbctl/keys/db/db.key

[Path]
PathChanged=/boot/loader
PathChanged=/boot/EFI/systemd
PathChanged=/boot/EFI/BOOT

[Install]
WantedBy=multi-user.target
