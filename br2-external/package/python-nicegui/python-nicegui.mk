PYTHON_NICEGUI_VERSION = 3.18.0
PYTHON_NICEGUI_SOURCE = nicegui-$(PYTHON_NICEGUI_VERSION).tar.gz
PYTHON_NICEGUI_SITE = https://files.pythonhosted.org/packages/ed/ff/eaedb55c0ee3d75c9e9e236fd6ba045f9819db583642d8b745bce9154d2b
PYTHON_NICEGUI_SETUP_TYPE = poetry
PYTHON_NICEGUI_DEPENDENCIES = host-python-poetry-dynamic-versioning
PYTHON_NICEGUI_EXTRA_DOWNLOADS = \
	https://raw.githubusercontent.com/zauberzeug/nicegui/v$(PYTHON_NICEGUI_VERSION)/DEPENDENCIES.md
PYTHON_NICEGUI_LICENSE = MIT, Apache-2.0, MPL-2.0 or Apache-2.0, ISC, BSD-2-Clause, OFL-1.1 (bundled web assets)
PYTHON_NICEGUI_LICENSE_FILES = LICENSE DEPENDENCIES.md

define PYTHON_NICEGUI_STAGE_DEPENDENCIES_DOC
	$(INSTALL) -D -m 0644 $(PYTHON_NICEGUI_DL_DIR)/DEPENDENCIES.md $(@D)/DEPENDENCIES.md
endef
PYTHON_NICEGUI_POST_EXTRACT_HOOKS += PYTHON_NICEGUI_STAGE_DEPENDENCIES_DOC

$(eval $(python-package))
