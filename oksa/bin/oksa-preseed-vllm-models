import argparse
import fcntl
import hashlib
import json
import os
from pathlib import Path
import platform
import re
import shutil
import shlex
import stat as statmod
import subprocess
import sys
import urllib.error
import urllib.parse
import urllib.request

sys.path.insert(0, str(Path(__file__).resolve().parent))
import oksa_model_serving as ms
from oksa_calibration_state import STATUS_PATH


def notify_discovery_and_planner() -> None:
    if os.geteuid() == 0:
        subprocess.run([str(ms.resolve_helper("oksa-discover-vllm-models"))], check=True)
        subprocess.run(["systemctl", "start", "--no-block", "puu-vllm-planner.service"], check=True)


def download_with_cli(repo_id: str, revision: str, dest_dir: Path) -> bool:
    if shutil.which("hf"):
        cmd = ["hf", "download", repo_id, "--local-dir", str(dest_dir)]
        if revision and revision != "main":
            cmd.extend(["--revision", revision])
        try:
            env = os.environ.copy()
            env.setdefault("HF_HOME", "/var/lib/huggingface")
            res = subprocess.run(cmd, check=False, env=env)
            if res.returncode == 0:
                return True
        except OSError:
            pass
    return False


def model_files(repo_id: str, revision: str) -> list[dict] | None:
    rev = urllib.parse.quote(revision, safe="/")
    api_url = f"https://huggingface.co/api/models/{repo_id}/revision/{rev}?blobs=true"
    req = urllib.request.Request(api_url, headers={"User-Agent": "puu-preseed/1.0"})
    try:
        with urllib.request.urlopen(req, timeout=30) as resp:
            data = json.loads(resp.read().decode("utf-8"))
        files = []
        for sibling in data["siblings"]:
            name = sibling["rfilename"]
            if name.startswith("."):
                continue
            size = sibling["size"]
            if not ms.valid_model_file(name) or not isinstance(size, int) or size <= 0:
                raise ValueError(f"invalid model file metadata: {name!r}")
            sha256 = sibling.get("lfs", {}).get("sha256")
            blob_id = sibling.get("blobId")
            if sha256 is not None and not re.fullmatch(r"[0-9a-f]{64}", sha256):
                raise ValueError(f"invalid checksum for {name!r}")
            if blob_id is not None and not re.fullmatch(r"[0-9a-f]{40}", blob_id):
                raise ValueError(f"invalid blob ID for {name!r}")
            if sha256 is None and blob_id is None:
                raise ValueError(f"missing checksum for {name!r}")
            files.append({"path": name, "size": size, "sha256": sha256, "blob_id": blob_id})
        names = {entry["path"] for entry in files}
        if len(names) != len(files) or "config.json" not in names or not any(
            name.endswith((".safetensors", ".bin")) for name in names
        ):
            raise ValueError("repository has no config or model weights, or has duplicate files")
        return files
    except (urllib.error.URLError, OSError, ValueError, KeyError, TypeError) as exc:
        print(f"error: failed to query HF file metadata for {repo_id}: {exc}", file=sys.stderr)
        return None


def file_matches(path: Path, info: dict) -> bool:
    if not path.is_file() or path.stat().st_size != info["size"]:
        return False
    if info.get("sha256"):
        digest = hashlib.sha256()
        expected = info["sha256"]
    elif info.get("blob_id"):
        digest = hashlib.sha1(f"blob {info['size']}\0".encode())
        expected = info["blob_id"]
    else:
        return True
    with path.open("rb") as stream:
        for block in iter(lambda: stream.read(8 * 1024 * 1024), b""):
            digest.update(block)
    return digest.hexdigest() == expected


def download_with_http(repo_id: str, revision: str, dest_dir: Path, files: list[dict]) -> bool:
    rev = urllib.parse.quote(revision, safe="/")
    for info in files:
        rfilename = info["path"]
        out_path = dest_dir / rfilename
        out_path.parent.mkdir(parents=True, exist_ok=True)
        if file_matches(out_path, info):
            continue
        print(f"  Fetching {rfilename}...")
        file_url = f"https://huggingface.co/{repo_id}/resolve/{rev}/{urllib.parse.quote(rfilename, safe='/')}"
        file_req = urllib.request.Request(file_url, headers={"User-Agent": "puu-preseed/1.0"})
        tmp_path = out_path.with_name(f".{out_path.name}.tmp")
        try:
            with urllib.request.urlopen(file_req, timeout=120) as in_stream, open(tmp_path, "wb") as out_stream:
                shutil.copyfileobj(in_stream, out_stream)
            if not file_matches(tmp_path, info):
                raise ValueError(f"downloaded file has incorrect size or checksum: {rfilename}")
            tmp_path.replace(out_path)
        except (urllib.error.URLError, OSError, ValueError) as exc:
            tmp_path.unlink(missing_ok=True)
            print(f"error: failed downloading {rfilename}: {exc}", file=sys.stderr)
            return False
    return True


def write_manifest(model_dir: Path, manifest: dict) -> None:
    data = {**manifest, "files": [
        {**info, "mtime_ns": (model_dir / info["path"]).stat().st_mtime_ns}
        for info in manifest["files"]
    ]}
    ms.atomic_write_text(model_dir / ms.PRESEED_MANIFEST, json.dumps(data) + "\n")


def preseed_locked(
    catalog_file: Path | None,
    models_dir: Path,
    model_name: str,
    repo_id: str,
    revision: str,
    hf_meta: dict | None = None,
) -> bool:
    dest_dir = models_dir / model_name
    architecture = {"x86_64": "amd64", "aarch64": "arm64"}.get(platform.machine(), platform.machine())
    serving_env = ms.generate_serving_env_text(hf_meta, dest_dir) if hf_meta is not None else ""
    catalog_dir = Path(os.environ.get("PUU_VLLM_MODEL_CATALOG_DIR", "/usr/share/puu/vllm/catalog.d"))
    runtime_files = {path.absolute() for path in catalog_dir.glob("*.env")}
    if catalog_file is not None:
        catalog_file = catalog_file.absolute()
        runtime_files.add(catalog_file)
    matched_runtime = False
    matched_catalog = catalog_file is None
    for runtime_file in sorted(runtime_files):
        try:
            chain = [parent.lstat() for parent in runtime_file.parents]
            if any(info.st_uid != 0 or info.st_mode & 0o022 or not statmod.S_ISDIR(info.st_mode) for info in chain):
                raise ValueError("metadata ancestry is not root-owned and protected")
            with os.fdopen(os.open(runtime_file, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK), encoding="utf-8") as stream:
                info = os.fstat(stream.fileno())
                if info.st_uid != 0 or info.st_mode & 0o022 or not statmod.S_ISREG(info.st_mode):
                    raise ValueError("metadata is not a root-owned protected regular file")
                runtime_meta = {}
                for raw_line in stream:
                    line = raw_line.strip()
                    if line and not line.startswith("#") and "=" in line:
                        key, _, value = line.partition("=")
                        runtime_meta[key.strip()] = " ".join(shlex.split(value))
        except (OSError, ValueError) as exc:
            print(f"Ignoring untrusted model catalog {runtime_file}: {exc}", file=sys.stderr)
            if runtime_file == catalog_file:
                return False
            continue
        if (runtime_meta.get("PUU_VLLM_REPO_ID") != repo_id
                or (runtime_meta.get("PUU_VLLM_REVISION", "main") or "main") != revision
                or (runtime_file != catalog_file and not re.fullmatch(r"[0-9a-f]{40}", revision))):
            continue
        if matched_runtime:
            raise ValueError(f"duplicate runtime catalog identity: {(repo_id, revision)}")
        matched_runtime = True
        profiles = json.loads(runtime_meta.pop("PUU_VLLM_RUNTIME_PROFILES", "{}"))
        runtime_meta.update(profiles.get(architecture, {}))
        if runtime_file == catalog_file:
            matched_catalog = True
        else:
            for key in ("PUU_VLLM_MODEL_NAME", "PUU_VLLM_MODEL_PATH", "PUU_VLLM_AUTOSTART"):
                runtime_meta.pop(key, None)
        serving_env += "\n" + "\n".join(f"{key}={shlex.quote(value)}" for key, value in runtime_meta.items()) + "\n"
    if not matched_catalog:
        print(f"error: catalog identity does not match {(repo_id, revision)}", file=sys.stderr)
        return False
    serving_env += f"\nPUU_VLLM_REVISION={shlex.quote(revision)}\n"
    backup_dir = models_dir.parent / f".{model_name}.previous"
    gpu_lock_path = STATUS_PATH.parent / "lock"
    if backup_dir.exists():
        if dest_dir.exists():
            shutil.rmtree(backup_dir)
        else:
            gpu_lock_path.parent.mkdir(parents=True, exist_ok=True)
            with gpu_lock_path.open("a") as gpu_lock:
                fcntl.flock(gpu_lock, fcntl.LOCK_EX)
                with ms.preseed_publish_lock(models_dir, exclusive=True):
                    backup_dir.rename(dest_dir)
    if ms.verified_preseed(dest_dir, repo_id, revision):
        gpu_lock_path.parent.mkdir(parents=True, exist_ok=True)
        with gpu_lock_path.open("a") as gpu_lock:
            fcntl.flock(gpu_lock, fcntl.LOCK_EX)
            with ms.preseed_publish_lock(models_dir, exclusive=True):
                ms.atomic_write_text(dest_dir / "puu-serving.env", serving_env)
        print(f"Model {model_name} already present at {dest_dir}")
        return True

    files = hf_meta["files"] if hf_meta and "files" in hf_meta else model_files(repo_id, revision)
    if files is not None:
        files = [info for info in files if info["path"] not in ("puu-serving.env", ms.PRESEED_MANIFEST)]
    if files is None:
        return False
    manifest = {"repo_id": repo_id, "revision": revision, "files": files}
    print(f"Pre-seeding model {model_name} ({repo_id}) to {dest_dir}...")
    stage_dir = models_dir.parent / f".{model_name}.preseed"
    stage_dir.mkdir(parents=True, exist_ok=True)
    verified = all(file_matches(stage_dir / info["path"], info) for info in files)
    if not verified:
        verified = download_with_cli(repo_id, revision, stage_dir) and all(
            file_matches(stage_dir / info["path"], info) for info in files
        )
    if not verified:
        verified = download_with_http(repo_id, revision, stage_dir, files) and all(
            file_matches(stage_dir / info["path"], info) for info in files
        )
    if not verified:
        print(f"error: model {model_name} failed download or file verification", file=sys.stderr)
        return False

    expected = {info["path"] for info in files}
    for path in stage_dir.rglob("*"):
        relative = path.relative_to(stage_dir)
        if path.is_file() and not relative.parts[0].startswith(".") and relative.as_posix() not in expected:
            path.unlink()
    ms.atomic_write_text(stage_dir / "puu-serving.env", serving_env)
    write_manifest(stage_dir, manifest)
    gpu_lock_path.parent.mkdir(parents=True, exist_ok=True)
    with gpu_lock_path.open("a") as gpu_lock:
        fcntl.flock(gpu_lock, fcntl.LOCK_EX)
        with ms.preseed_publish_lock(models_dir, exclusive=True):
            try:
                if dest_dir.exists():
                    dest_dir.rename(backup_dir)
                stage_dir.rename(dest_dir)
            except OSError as exc:
                if backup_dir.exists() and not dest_dir.exists():
                    backup_dir.rename(dest_dir)
                print(f"error: failed to publish {model_name}: {exc}", file=sys.stderr)
                return False
    if backup_dir.exists():
        shutil.rmtree(backup_dir)
    print(f"Successfully pre-seeded {model_name}")
    return True


def preseed_target(
    models_dir: Path,
    model_name: str,
    repo_id: str,
    revision: str = "main",
    catalog_file: Path | None = None,
    force: bool = False,
) -> bool:
    if not repo_id or not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._-]*", model_name):
        print(f"error: invalid model name {model_name!r} or missing repository {repo_id!r}", file=sys.stderr)
        return False

    hf_meta = None
    if catalog_file is not None:
        meta = ms.parse_env_file(catalog_file)
        estimated_mib = ms.parse_int(meta.get("PUU_VLLM_ESTIMATED_MEMORY_MIB"), 0)
    else:
        print(f"Inspecting Hugging Face repository {repo_id} ({revision})...")
        hf_meta = ms.inspect_hf_model(repo_id, revision)
        if hf_meta is None:
            print(f"error: failed to inspect Hugging Face repository {repo_id}", file=sys.stderr)
            return False
        estimated_mib = hf_meta.get("estimated_memory_mib", 0)
        revision = hf_meta.get("resolved_revision", revision)

    if estimated_mib > 0:
        fits, reason = ms.check_model_capacity(estimated_mib)
        if not fits:
            if force:
                print(f"warning: {reason}. Proceeding due to --force (cluster/QSFP-chaining enabled).", file=sys.stderr)
            else:
                print(f"error: {reason}. Pass --force to override for multi-node QSFP clustering.", file=sys.stderr)
                return False

    models_dir.mkdir(parents=True, exist_ok=True)
    if os.environ.get("PUU_PRESEED_LOCK_HELD") == f"1:{model_name}":
        return preseed_locked(catalog_file, models_dir, model_name, repo_id, revision, hf_meta=hf_meta)
    lock_path = models_dir.parent / f".{model_name}.preseed.lock"
    with lock_path.open("w") as lock_file:
        fcntl.flock(lock_file.fileno(), fcntl.LOCK_EX)
        return preseed_locked(catalog_file, models_dir, model_name, repo_id, revision, hf_meta=hf_meta)


def preseed_model(catalog_file: Path, models_dir: Path, force: bool = False) -> bool:
    meta = ms.parse_env_file(catalog_file)
    model_name = meta.get("PUU_VLLM_MODEL_NAME") or catalog_file.stem
    repo_id = meta.get("PUU_VLLM_REPO_ID", "")
    revision = meta.get("PUU_VLLM_REVISION", "main") or "main"
    return preseed_target(models_dir, model_name, repo_id, revision, catalog_file=catalog_file, force=force)


def main() -> None:
    parser = argparse.ArgumentParser(description="Preseed vLLM models from catalog or Hugging Face")
    parser.add_argument(
        "models",
        nargs="*",
        help="Specific model names or Hugging Face repository IDs to preseed",
    )
    parser.add_argument("--repo-id", help="Hugging Face repository ID (e.g. org/model)")
    parser.add_argument("--name", help="Custom model name (default: derived from repo-id)")
    parser.add_argument("--revision", default="main", help="Model git revision (default: main)")
    parser.add_argument("--force", action="store_true", help="Download model even if exceeding host capacity (for QSFP clustering)")
    parser.add_argument(
        "--catalog-dir",
        type=Path,
        default=Path(os.environ.get("PUU_VLLM_MODEL_CATALOG_DIR", "/usr/share/puu/vllm/catalog.d")),
    )
    parser.add_argument(
        "--models-dir",
        type=Path,
        default=Path(os.environ.get("PUU_VLLM_MODELS_DIR", str(ms.MODELS_DIR))),
    )
    args = parser.parse_args()

    catalog_dir = args.catalog_dir
    models_dir = args.models_dir

    if args.repo_id:
        name = ms.normalize_storage_id(args.repo_id, args.name)
        if not name:
            sys.exit("error: invalid model storage ID")
        success = preseed_target(models_dir, name, args.repo_id, args.revision, force=args.force)
        if success:
            notify_discovery_and_planner()
        sys.exit(0 if success else 1)

    if args.models:
        success = True
        for item in args.models:
            env_file = catalog_dir / f"{item}.env"
            if env_file.is_file():
                if not preseed_model(env_file, models_dir, force=args.force):
                    success = False
                else:
                    notify_discovery_and_planner()
            elif "/" in item:
                name = ms.normalize_storage_id(item, args.name)
                if not name:
                    sys.exit("error: invalid model storage ID")
                if not preseed_target(models_dir, name, item, args.revision, force=args.force):
                    success = False
                else:
                    notify_discovery_and_planner()
            else:
                sys.exit(f"error: catalog model not found: {item}")
        sys.exit(0 if success else 1)

    if not catalog_dir.is_dir():
        print(f"Catalog directory {catalog_dir} does not exist, skipping pre-seeding.")
        sys.exit(0)

    candidates = []
    for env_file in sorted(catalog_dir.glob("*.env")):
        meta = ms.parse_env_file(env_file)
        if not ms.parse_bool(meta.get("PUU_VLLM_AUTOSTART"), False):
            continue
        try:
            prio = int(meta.get("PUU_VLLM_AUTOSTART_PRIORITY", "0"))
        except ValueError:
            prio = 0
        candidates.append((prio, env_file))
    candidates.sort(key=lambda item: item[0], reverse=True)
    target_files = [item[1] for item in candidates]

    if not target_files:
        print("No models to preseed.")
        sys.exit(0)

    success = True
    for catalog_file in target_files:
        if not preseed_model(catalog_file, models_dir, force=args.force):
            success = False
        else:
            notify_discovery_and_planner()

    if not success:
        sys.exit(1)


if __name__ == "__main__":
    main()
