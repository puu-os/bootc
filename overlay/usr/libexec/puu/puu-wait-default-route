import os
from pathlib import Path
import sys
import time


def has_default_ipv4_route(procfs_root: Path) -> bool:
    route_file = procfs_root / "net" / "route"
    if not route_file.is_file():
        return False
    try:
        with route_file.open(encoding="utf-8", errors="replace") as f:
            next(f, None)
            for line in f:
                parts = line.split()
                if len(parts) > 7 and parts[1] == "00000000" and parts[7] == "00000000":
                    return True
    except OSError:
        pass
    return False


def main() -> None:
    timeout = 120
    if len(sys.argv) > 1:
        try:
            timeout = int(sys.argv[1])
        except ValueError:
            sys.stderr.write(f"error: invalid timeout: {sys.argv[1]}\n")
            sys.exit(2)

    procfs_root = Path("/proc")
    poll_interval = float(os.environ.get("PUU_ROUTE_POLL_INTERVAL", "1.0"))

    start_time = time.monotonic()
    while time.monotonic() - start_time < timeout:
        if has_default_ipv4_route(procfs_root):
            sys.exit(0)
        time.sleep(poll_interval)

    sys.exit("timed out waiting for an IPv4 default route")


if __name__ == "__main__":
    main()
