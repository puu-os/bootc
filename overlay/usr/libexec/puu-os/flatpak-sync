from pathlib import Path
import subprocess
import sys
import tempfile


def parse_manifest(path: Path) -> list[str]:
    refs = set()
    with path.open(encoding="utf-8") as f:
        for line in f:
            stripped = line.split("#", 1)[0].strip()
            if stripped:
                refs.add(stripped)
    return sorted(refs)


def get_installed_apps(flatpak_bin: Path) -> set[str]:
    proc = subprocess.run(
        [str(flatpak_bin), "list", "--system", "--app", "--columns=application"],
        capture_output=True,
        text=True,
        check=True,
    )
    return {line.strip() for line in proc.stdout.splitlines() if line.strip()}



def run_flatpak(flatpak_bin: Path, *args: str) -> None:
    subprocess.run(
        [str(flatpak_bin), *args, "--system", "--noninteractive", "--assumeyes"],
        check=True,
    )


def write_state(state_path: Path, refs: list[str]) -> None:
    state_dir = state_path.parent
    state_dir.mkdir(mode=0o700, parents=True, exist_ok=True)
    try:
        state_dir.chmod(0o700)
    except OSError:
        pass
    content = "".join(f"{ref}\n" for ref in refs)
    with tempfile.NamedTemporaryFile("w", dir=state_dir, delete=False, encoding="utf-8") as tmp:
        tmp.write(content)
        tmp_path = Path(tmp.name)
    tmp_path.chmod(0o600)
    tmp_path.replace(state_path)


def main() -> None:
    manifest_path = Path("/usr/share/puu-os/flatpaks.list")
    if not manifest_path.is_file():
        sys.exit(0)

    remote = "flathub"
    state_dir = Path("/var/lib/puu")
    state_path = state_dir / "flatpaks.managed"
    flatpak_bin = Path("/usr/bin/flatpak")

    current_refs = parse_manifest(manifest_path)
    if current_refs:
        run_flatpak(flatpak_bin, "install", "--or-update", remote, *current_refs)

    if state_path.is_file():
        previous_refs = {
            line.strip()
            for line in state_path.read_text(encoding="utf-8").splitlines()
            if line.strip()
        }
        installed_apps = get_installed_apps(flatpak_bin)
        removed = sorted((previous_refs - set(current_refs)) & installed_apps)
        if removed:
            run_flatpak(flatpak_bin, "uninstall", *removed)

    write_state(state_path, current_refs)

    run_flatpak(flatpak_bin, "update")
    run_flatpak(flatpak_bin, "uninstall", "--unused")


if __name__ == "__main__":
    main()
