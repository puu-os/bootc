[Unit]
Description=Stage a bootc upgrade and surface a reboot prompt
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=30min
StartLimitBurst=3

[Service]
Type=oneshot
ExecStart=/usr/libexec/puu-os/bootc-upgrade
Restart=on-failure
RestartSec=5min
