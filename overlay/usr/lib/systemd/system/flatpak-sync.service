[Unit]
Description=Reconcile system Flatpaks against the Puu manifest
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=30min
StartLimitBurst=3

[Service]
Type=oneshot
ExecStart=/usr/libexec/puu-os/flatpak-sync
Restart=on-failure
RestartSec=5min
