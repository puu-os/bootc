[Unit]
Description=Watch ESP for new UKIs to re-sign
ConditionPathExists=/var/lib/sbctl/keys/db/db.key

[Path]
PathChanged=/efi/EFI/Linux
PathChanged=/efi/EFI/PUU
PathChanged=/efi/EFI/systemd
PathChanged=/efi/EFI/BOOT

[Install]
WantedBy=multi-user.target
