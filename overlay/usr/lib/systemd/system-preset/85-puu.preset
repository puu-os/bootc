enable puu-live-setup.service
enable postgresql.service
enable puu-postgresql.service
enable k3s.service
enable puu-k3s-addons.service
enable puu-vllm-discovery.timer
enable puu-model-serving-labeler.timer
enable puu-nvlink-topology.timer
enable puu-vllm-planner.timer
enable puu-vllm-preseed.service
enable nvidia-cdi-refresh.service
enable nvidia-cdi-refresh.path
enable iwd.service
enable avahi-daemon.service
disable containerd.service
enable sshd.service
enable systemd-resolved.service
enable systemd-timesyncd.service
enable ModemManager.service
enable NetworkManager.service
enable gdm.service
enable bluetooth.service
enable bolt.service
enable rtkit-daemon.service
# Audio runs in the user session (see user-preset), not system-wide.
disable pipewire.*
disable pipewire-pulse.*
disable pipewire-manager.socket
disable wireplumber.service
enable upower.service
enable colord.service
enable usbguard-dbus.service
enable sbctl-sign-uki.path
enable puu-bootc-upgrade.timer
disable bootc-fetch-apply-updates.timer
enable fwupd-refresh.timer
# Automatically mark successful boot for systemd-boot rollback.
enable systemd-bless-boot.service
enable systemd-boot-update.service
enable puu-firstboot-homectl.service
disable systemd-firstboot.service
disable systemd-homed-firstboot.service
enable flatpak-sync.timer
disable systemd-networkd.service
disable systemd-networkd-wait-online.service
