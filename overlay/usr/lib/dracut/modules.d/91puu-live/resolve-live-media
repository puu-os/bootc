set -euo pipefail

fail() {
  echo "puu-live-media: $*" >&2
  exit 1
}

declare -A ids=()
iso_label=""
read -r -a cmdline < /proc/cmdline
for arg in "${cmdline[@]}"; do
  case "${arg}" in
    root=*) role=live; id=${arg#root=live:LABEL=} ;;
    puu.boot-partuuid=*) role=boot; id=${arg#*=} ;;
    puu.payload-partuuid=*) fail "raw payload PARTUUID is unsupported; ISO media is required" ;;
    puu.iso=*)
      [[ -z ${iso_label} ]] || fail "duplicate ISO identifier on command line"
      iso_label=${arg#*=}
      [[ ${iso_label} =~ ^PUU_[0-9A-F]{24}$ ]] || fail "invalid ISO identifier"
      continue
      ;;
    *) continue ;;
  esac
  [[ ! -v ids[${role}] ]] || fail "duplicate ${role} identifier on command line"
  ids[${role}]=${id}
done
[[ -v ids[boot] ]] || fail "missing boot PARTUUID"
[[ ${ids[boot]} =~ ^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$ ]] || fail "invalid boot PARTUUID"
[[ -n ${iso_label} ]] || fail "missing ISO identifier"
[[ ${ids[live]-} == "${iso_label}" ]] || fail "inconsistent ISO command line"

efivars=/sys/firmware/efi/efivars
[[ -d ${efivars} ]] || fail "UEFI boot provenance is unavailable"
mounted_efivars=0
if ! mountpoint -q "${efivars}"; then
  mount -t efivarfs -o ro,nosuid,nodev,noexec efivarfs "${efivars}"
  mounted_efivars=1
fi
efi_bytes=$(od -An -v -tx1 "${efivars}/StubDevicePartUUID-4a67b082-0a4c-41cf-b6c7-440b29bb8c4f")
read -r -a bytes <<< "${efi_bytes//$'\n'/ }"
((${#bytes[@]} == 78)) || fail "invalid boot partition EFI variable length"
[[ ${bytes[76]} == 00 && ${bytes[77]} == 00 ]] || fail "unterminated boot partition EFI variable"
boot_uuid=""
for ((i = 4; i < 76; i += 2)); do
  [[ ${bytes[i + 1]} == 00 ]] || fail "invalid boot partition EFI variable encoding"
  printf -v char '%b' "\\x${bytes[i]}"
  boot_uuid+=${char}
done
if ((mounted_efivars)); then
  umount "${efivars}"
fi
[[ ${boot_uuid,,} == "${ids[boot]}" ]] || fail "UKI was not loaded from its expected boot partition"

udevadm settle
payload=/run/puu-installer/payload
livedev=$(readlink -f /run/initramfs/livedev)
[[ -b ${livedev} ]] || fail "dracut selected no live block device"
type=$(lsblk --nodeps --noheadings --output TYPE "${livedev}")
case "${type}" in
  disk|rom) medium=${livedev} ;;
  part)
    medium=$(lsblk --nodeps --noheadings --paths --output PKNAME "${livedev}")
    medium=$(readlink -f "${medium}")
    ;;
  *) fail "unsupported ISO live device type ${type}" ;;
esac
[[ -b ${medium} ]] || fail "ISO has no physical backing medium"
/usr/libexec/puu-live-iso "${medium}" "${ids[boot]}" "${iso_label}" || fail "ISO boot metadata validation failed"
declare -A seen=()
matches=0
media=$(lsblk --all --list --noheadings --paths --output NAME,TYPE)
while read -r device type; do
  [[ ${type} == disk || ${type} == rom ]] || continue
  device=$(readlink -f "${device}")
  [[ ! -v seen[${device}] ]] || continue
  seen[${device}]=1
  if /usr/libexec/puu-live-iso "${device}" "${ids[boot]}" "${iso_label}" 2>/dev/null; then
    matches=$((matches + 1))
  fi
done <<< "${media}"
((matches == 1)) || fail "ambiguous ISO boot medium; remove duplicate installer media"
live_mount=$(findmnt --noheadings --raw --output SOURCE,FSTYPE --mountpoint /run/initramfs/live) || fail "live ISO is not mounted"
read -r live_source live_type <<< "${live_mount}"
[[ ${live_type} == iso9660 && $(readlink -f "${live_source}") == "${livedev}" ]] || fail "live root is not on the validated ISO medium"
[[ -f /run/initramfs/live/LiveOS/squashfs.img && -f /run/initramfs/live/payload/image.tar && -f /run/initramfs/live/payload/image.manifest ]] || fail "ISO has no live root or installer payload"
mkdir -p "${payload}"
mount --bind /run/initramfs/live/payload "${payload}"
mount -o remount,bind,ro,nosuid,nodev,noexec "${payload}"
echo "puu-live-media: ISO=${medium} root=${livedev} payload=${payload}"
