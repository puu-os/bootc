[Unit]
Description=Lightweight Kubernetes
Documentation=https://k3s.io
Wants=network-online.target nvidia-cdi-refresh.service
After=network-online.target nvidia-cdi-refresh.service
ConditionKernelCommandLine=!puu.live

[Install]
WantedBy=multi-user.target

[Service]
Type=notify
EnvironmentFile=-/usr/lib/systemd/system/k3s.service.env
EnvironmentFile=-/etc/systemd/system/k3s.service.env
KillMode=process
Delegate=yes
LimitNOFILE=1048576
LimitNPROC=infinity
LimitCORE=infinity
TasksMax=infinity
TimeoutStartSec=0
Restart=always
RestartSec=5s
ExecStartPre=-/sbin/modprobe br_netfilter
ExecStartPre=-/sbin/modprobe overlay
ExecStartPre=/usr/libexec/puu/wait-default-route
ExecStart=/usr/bin/k3s $K3S_EXEC
