config BR2_PACKAGE_PYTHON_NICEGUI
	bool "python-nicegui"
	depends on BR2_PACKAGE_PYTHON3
	depends on BR2_PACKAGE_HOST_RUSTC_TARGET_ARCH_SUPPORTS
	depends on BR2_TOOLCHAIN_HAS_SYNC_4
	depends on BR2_USE_MMU
	depends on !BR2_STATIC_LIBS
	depends on BR2_TOOLCHAIN_HAS_THREADS_NPTL
	depends on BR2_TOOLCHAIN_GCC_AT_LEAST_4_9
	select BR2_PACKAGE_PYTHON3_SSL
	select BR2_PACKAGE_PYTHON_AIOFILES
	select BR2_PACKAGE_PYTHON_AIOHTTP
	select BR2_PACKAGE_PYTHON_ANYIO
	select BR2_PACKAGE_PYTHON_CERTIFI
	select BR2_PACKAGE_PYTHON_DOCUTILS
	select BR2_PACKAGE_PYTHON_DOTENV
	select BR2_PACKAGE_PYTHON_FASTAPI
	select BR2_PACKAGE_PYTHON_H11
	select BR2_PACKAGE_PYTHON_HTTPTOOLS
	select BR2_PACKAGE_PYTHON_HTTPX
	select BR2_PACKAGE_PYTHON_IDNA
	select BR2_PACKAGE_PYTHON_IFADDR
	select BR2_PACKAGE_PYTHON_ITSDANGEROUS
	select BR2_PACKAGE_PYTHON_JINJA2
	select BR2_PACKAGE_PYTHON_MARKDOWN2
	select BR2_PACKAGE_PYTHON_MULTIDICT
	select BR2_PACKAGE_PYTHON_MULTIPART
	select BR2_PACKAGE_PYTHON_ORJSON
	select BR2_PACKAGE_PYTHON_PYDANTIC_CORE
	select BR2_PACKAGE_PYTHON_PYGMENTS
	select BR2_PACKAGE_PYTHON_PYYAML
	select BR2_PACKAGE_PYTHON_SOCKETIO
	select BR2_PACKAGE_PYTHON_TINYCSS2
	select BR2_PACKAGE_PYTHON_TYPING_EXTENSIONS
	select BR2_PACKAGE_PYTHON_UVICORN
	select BR2_PACKAGE_PYTHON_UVLOOP
	select BR2_PACKAGE_PYTHON_WATCHFILES
	select BR2_PACKAGE_PYTHON_WEBSOCKETS
	help
	  Web-based user interfaces with bundled browser assets, including
	  Uvicorn's standard and Socket.IO's asyncio-client dependencies.

	  https://nicegui.io
