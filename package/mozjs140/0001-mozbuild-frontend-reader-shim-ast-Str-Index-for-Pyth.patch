+if not hasattr(ast, 'Str'):
+    class _AstStr(ast.Constant):
+        def __init__(self, s=None):
+            super().__init__(value=s)
+    ast.Str = _AstStr
+if not hasattr(ast, 'Index'):
+    ast.Index = lambda value: value
