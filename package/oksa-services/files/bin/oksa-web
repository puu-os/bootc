<script>
let currentTab = 'monitoring';
let pollInterval = null;

function escapeHTML(value) {
  return String(value ?? '').replace(/[&<>"']/g, char => ({'&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'}[char]));
}

function showToast(msg) {
  const t = document.getElementById('toast');
  t.textContent = msg;
  t.style.display = 'block';
  setTimeout(() => { t.style.display = 'none'; }, 3500);
}

function switchTab(tab) {
  currentTab = tab;
  document.querySelectorAll('.nav-tab').forEach(b => b.classList.remove('active'));
  document.querySelectorAll('.tab-content').forEach(c => c.classList.remove('active'));
  const btn = Array.from(document.querySelectorAll('.nav-tab')).find(b => b.getAttribute('onclick').includes(tab));
  if (btn) btn.classList.add('active');
  const panel = document.getElementById('tab-' + tab);
  if (panel) panel.classList.add('active');

  if (tab === 'monitoring') loadMonitoring();
  if (tab === 'models') loadModels();
  if (tab === 'users') usersView.refresh();
  if (tab === 'settings') loadSettings();
}

function metricLevel(pct) {
  return pct >= 90 ? 'crit' : pct >= 75 ? 'warn' : 'ok';
}

function setMetricLevel(id, level) {
  const el = document.getElementById(id);
  el.classList.toggle('warn', level === 'warn');
  el.classList.toggle('crit', level === 'crit');
}

function usageBar(pct) {
  const level = metricLevel(pct);
  return '<span class="bar"><span class="bar-track"><span class="bar-fill' + (level !== 'ok' ? ' ' + level : '') + '" style="width:' + Math.min(Math.round(pct), 100) + '%"></span></span>' + Math.round(pct) + '%</span>';
}

async function loadMonitoring() {
  const panel = document.getElementById('tab-monitoring');
  if (panel.dataset.loading) return;
  panel.dataset.loading = 'true';
  const hostStatus = document.getElementById('host-status');
  const updated = document.getElementById('mon-updated');
  let partial = false;
  const numeric = (value, maximum = Infinity) => typeof value === 'number' && Number.isFinite(value) && value >= 0 && value <= maximum;
  const number = (value, format = String, maximum = Infinity, integer = false) => {
    if (!numeric(value, maximum) || (integer && !Number.isInteger(value))) {
      partial = true;
      return 'Unavailable';
    }
    return format(value);
  };
  const text = value => {
    if (typeof value !== 'string' || !value.trim()) { partial = true; return 'Unavailable'; }
    return value === '-' ? 'None' : value;
  };
  try {
    const res = await fetch('/api/status', {signal: AbortSignal.timeout(60000)});
    if (!res.ok) throw new Error('status unavailable');
    const data = await res.json();
    if (data.ok !== true || !data.status || typeof data.status !== 'object' || Array.isArray(data.status)) throw new Error('invalid status');
    const s = data.status;
    hostStatus.textContent = 'Admin API: reachable';
    hostStatus.classList.remove('offline');
    hostStatus.classList.add('online');

    const mem = s.host_memory || {};
    document.getElementById('host-mem-val').textContent = number(mem.used_mib) + ' / ' + number(mem.total_mib > 0 ? mem.total_mib : null) + ' MiB';
    document.getElementById('host-mem-sub').textContent = number(mem.used_pct, value => value + '% memory used', 100);
    setMetricLevel('host-mem-val', numeric(mem.used_pct, 100) ? metricLevel(mem.used_pct) : 'ok');

    document.getElementById('active-model-val').textContent = text(s.active_model);
    document.getElementById('active-model-sub').textContent = 'Selected: ' + text(s.selected_model);
    let inference = 'Unavailable';
    if (s.model_status === 'stopped') inference = 'Stopped';
    else if (s.model_status === 'no-model') inference = 'No model loaded';
    else if (s.model_status === 'not-ready') inference = 'Model not ready';
    else if (s.model_status === 'ready') {
      if (s.gateway_status === 'ready') inference = 'Ready';
      else if (s.gateway_status === 'authentication-required') inference = 'Unverified — gateway authentication required';
      else inference = 'Gateway unavailable';
    }
    if (inference === 'Unavailable' || !['ready', 'authentication-required', 'unreachable'].includes(s.gateway_status)) partial = true;
    document.getElementById('inference-status').textContent = 'Inference: ' + inference;

    const m = s.metrics || {};
    document.getElementById('inf-requests-val').textContent = number(m.running_requests, String, Infinity, true) + ' / ' + number(m.waiting_requests, String, Infinity, true);
    setMetricLevel('inf-requests-val', numeric(m.waiting_requests) && m.waiting_requests > 0 ? 'warn' : 'ok');
    document.getElementById('inf-requests-sub').textContent = numeric(m.waiting_requests) && m.waiting_requests > 0 ? 'Running / Waiting (queued)' : 'Running / Waiting';
    document.getElementById('kv-cache-val').textContent = number(m.kv_cache_usage_pct, value => value + '%', 100);
    setMetricLevel('kv-cache-val', numeric(m.kv_cache_usage_pct, 100) ? metricLevel(m.kv_cache_usage_pct) : 'ok');

    const gBody = document.getElementById('gpus-body');
    gBody.replaceChildren();
    if (!Array.isArray(s.gpus)) { partial = true; tableMessage(gBody, 6, 'GPU data unavailable'); }
    else if (!s.gpus.length) tableMessage(gBody, 6, 'No GPUs reported');
    else s.gpus.forEach(g => {
      if (!g || typeof g !== 'object') { partial = true; return; }
      const row = tableRow(gBody, [number(g.index, value => '[' + value + ']', Infinity, true), text(g.name), '', '', '', '']).parentElement;
      if (numeric(g.gpu_util_pct, 100)) row.cells[2].innerHTML = usageBar(g.gpu_util_pct);
      else row.cells[2].textContent = number(g.gpu_util_pct, String, 100);
      const used = number(g.memory_used_mib, value => String(Math.round(value)));
      const total = number(g.memory_total_mib > 0 ? g.memory_total_mib : null, value => String(Math.round(value)));
      row.cells[3].textContent = used + ' / ' + total + ' MiB';
      if (numeric(g.memory_used_mib) && numeric(g.memory_total_mib) && g.memory_total_mib > 0 && g.memory_used_mib <= g.memory_total_mib) {
        row.cells[3].innerHTML = usageBar(g.memory_used_mib / g.memory_total_mib * 100) + ' ' + used + ' / ' + total + ' MiB';
      }
      row.cells[4].textContent = number(g.temperature_c, value => value + '°C');
      row.cells[5].textContent = number(g.power_w, value => value.toFixed(1) + ' W');
      row.cells[4].classList.add('num');
      row.cells[5].classList.add('num');
    });

    const wBody = document.getElementById('workloads-body');
    wBody.replaceChildren();
    if (!Array.isArray(s.workloads)) { partial = true; tableMessage(wBody, 4, 'Workload data unavailable'); }
    else if (!s.workloads.length) tableMessage(wBody, 4, 'No workloads reported');
    else s.workloads.forEach(w => {
      if (!w || typeof w !== 'object') { partial = true; return; }
      const row = tableRow(wBody, [text(w.name), '', '', '']).parentElement;
      const pill = document.createElement('span');
      pill.className = 'pill ' + (w.phase === 'Running' && w.ready === true ? 'ok' : 'insufficient');
      pill.textContent = text(w.phase);
      row.cells[1].replaceChildren(pill);
      if (typeof w.ready === 'boolean') row.cells[2].textContent = w.ready ? 'Yes' : 'No';
      else { partial = true; row.cells[2].textContent = 'Unavailable'; }
      row.cells[3].textContent = number(w.restarts, String, Infinity, true);
      row.cells[3].classList.add('num');
    });

    panel.dataset.updatedAt = new Date().toISOString();
    panel.dataset.stale = 'false';
    updated.textContent = 'Updated ' + new Date(panel.dataset.updatedAt).toLocaleTimeString() + (partial ? ' · Some readings unavailable' : '');
  } catch (err) {
    hostStatus.textContent = 'Admin API: unavailable';
    hostStatus.classList.remove('online');
    hostStatus.classList.add('offline');
    if (panel.dataset.updatedAt) {
      panel.dataset.stale = 'true';
      updated.textContent = 'Stale · Last successful update ' + new Date(panel.dataset.updatedAt).toLocaleTimeString();
    } else {
      for (const id of ['host-mem-val', 'active-model-val', 'inf-requests-val', 'kv-cache-val']) document.getElementById(id).textContent = 'Unavailable';
      document.getElementById('inference-status').textContent = 'Inference: Unavailable';
      tableMessage(document.getElementById('gpus-body'), 6, 'GPU data unavailable');
      tableMessage(document.getElementById('workloads-body'), 4, 'Workload data unavailable');
      updated.textContent = 'Update failed · No successful readings';
    }
  } finally {
    delete panel.dataset.loading;
  }
}

let cachedModels = null;

async function loadModels() {
  try {
    const data = await api('/api/models');
    cachedModels = data.models || [];
    const mBody = document.getElementById('models-body');
    mBody.replaceChildren();
    const active = cachedModels.find(model => model.active);
    document.getElementById('models-stop').disabled = !active;
    document.getElementById('models-summary').textContent = active
      ? 'Serving ' + active.name
      : data.serving_enabled === false
        ? 'Serving is stopped. No model is loaded.'
        : 'No model is serving.';
    if (!cachedModels.length) { tableMessage(mBody, 6, 'No models installed'); return checkPullStatus(); }
    cachedModels.forEach(model => {
      const row = mBody.insertRow();
      row.insertCell().innerHTML = '<strong>' + escapeHTML(model.name) + '</strong>';
      row.insertCell().textContent = model.repo_id;
      row.insertCell().textContent = formatMiB(model.storage_mib);
      row.insertCell().textContent = model.quantization || 'none';
      const state = row.insertCell();
      const statePill = document.createElement('span');
      statePill.className = 'pill ' + (model.active ? 'active' : model.capabilities === 'ok' ? 'ok' : 'insufficient');
      statePill.textContent = model.active ? 'Serving' : model.capabilities === 'ok' ? 'Ready' : 'Insufficient VRAM';
      state.append(statePill);
      const actions = row.insertCell();
      if (model.active) actionButton(actions, 'Stop', false, button => stopServing(button));
      else actionButton(actions, 'Start', false, button => startModel(model.id, button));
      if (model.removable !== false) actionButton(actions, 'Delete', true, button => removeModel(model.id, button));
    });
    checkPullStatus();
  } catch (err) {
    tableMessage(document.getElementById('models-body'), 6, 'Unable to load models: ' + err.message);
  }
}

function formatMiB(value) {
  const mib = Number(value) || 0;
  if (!mib) return '-';
  return mib >= 1024 ? (mib / 1024).toFixed(1) + ' GiB' : Math.round(mib) + ' MiB';
}

let pullWasRunning = false;

async function checkPullStatus() {
  try {
    const data = await api('/api/models/pull/status');
    const p = data.pull;
    const pCard = document.getElementById('pull-status-card');
    if (p && (p.running || p.complete || p.error)) {
      pCard.style.display = 'block';
      document.getElementById('pull-repo-text').textContent = p.running
        ? 'Downloading ' + p.repo_id
        : p.error ? 'Download failed' : 'Completed ' + p.repo_id;
      const summary = document.getElementById('pull-summary');
      summary.textContent = p.running ? 'In progress' : p.error ? 'The download stopped early. Review the log.' : 'The model is now available in the catalog.';
      summary.style.color = p.error ? 'var(--danger)' : '';
      updatePullLog(p.progress || p.error || '');
      if (pullWasRunning && !p.running) loadModels();
      pullWasRunning = !!p.running;
    } else {
      pCard.style.display = 'none';
    }
  } catch (err) {}
}

function updatePullLog(text) {
  const log = document.getElementById('pull-log-text');
  if (text && log.textContent !== text) log.textContent = text;
  document.getElementById('pull-log-toggle').hidden = !log.textContent;
}

function togglePullLog() {
  const log = document.getElementById('pull-log-text');
  log.hidden = !log.hidden;
  document.getElementById('pull-log-toggle').textContent = log.hidden ? 'Show Log' : 'Hide Log';
}

async function startModel(name, button) {
  if (button) button.disabled = true;
  try {
    const d = await api('/api/models/start', {
      method: 'POST',
      headers: {'Content-Type': 'application/json'},
      body: JSON.stringify({name: name})
    });
    showToast(d.message);
    await loadModels();
  } catch (err) { alert(err.message); }
  finally { if (button) button.disabled = false; }
}

async function stopServing(button) {
  if (button) button.disabled = true;
  try {
    const d = await api('/api/models/stop', {
      method: 'POST',
      headers: {'Content-Type': 'application/json'},
      body: JSON.stringify({})
    });
    showToast(d.message);
    await loadModels();
  } catch (err) { alert(err.message); }
  finally { if (button) button.disabled = false; }
}

async function removeModel(name, button) {
  if (button?.disabled || !confirm('Remove model ' + name + '? If it is serving, it will be stopped first.')) return;
  const error = document.getElementById('models-error');
  error.textContent = '';
  if (button) button.disabled = true;
  try {
    const d = await api('/api/models/' + encodeURIComponent(name), {method: 'DELETE'});
    if (d.reconciled === false) error.textContent = d.warning;
    else showToast(d.message);
    await loadModels();
  } catch (err) { error.textContent = err.message; }
  finally {
    if (button) button.disabled = false;
    if (button?.isConnected) button.focus();
    else (error.textContent ? error : document.getElementById('models-summary')).focus();
  }
}

function openAddModal() {
  const modal = document.getElementById('add-modal');
  if (modal.dataset.busy === 'starting') return;
  modal.resetInspection();
  openDialog('add-modal');
}

function openDialog(id) {
  const modal = document.getElementById(id);
  modal.opener = document.activeElement;
  modal.classList.add('open');
  modal.querySelector('input:not(:disabled), select:not(:disabled), button, [role="dialog"]').focus();
}


function closeModal(id) {
  const modal = document.getElementById(id);
  if (modal.querySelector('form')?.dataset.busy) return;
  if (id === 'add-modal') modal.resetInspection();
  modal.classList.remove('open');
  modal.load = null;
  if (id === 'key-result-modal') {
    document.getElementById('created-key-token').textContent = '';
    document.getElementById('copy-status').textContent = '';
    window.getSelection()?.removeAllRanges();
  }
  modal.opener?.focus();
}

document.addEventListener('keydown', event => {
  const modal = document.querySelector('.modal-overlay.open [role="dialog"]');
  if (!modal) return;
  if (event.key === 'Escape') closeModal(modal.parentElement.id);
  if (event.key !== 'Tab') return;
  const focusable = Array.from(modal.querySelectorAll('input, select, button, [tabindex="0"]')).filter(el => !el.disabled && el.getClientRects().length);
  const first = focusable[0], last = focusable[focusable.length - 1];
  if (!focusable.length) {
    event.preventDefault();
    modal.focus();
  } else if (!modal.contains(document.activeElement)) {
    event.preventDefault();
    (event.shiftKey ? last : first).focus();
  } else if (event.shiftKey && (document.activeElement === first || document.activeElement === modal)) {
    event.preventDefault();
    last?.focus();
  } else if (!event.shiftKey && document.activeElement === last) {
    event.preventDefault();
    first?.focus();
  }
});

document.getElementById('key-model-access').addEventListener('change', () => {
  document.getElementById('key-model-selector').hidden = document.getElementById('key-model-access').value === 'all';
});
document.getElementById('key-model-search').addEventListener('input', event => {
  const query = event.target.value.toLowerCase();
  document.querySelectorAll('#key-models label').forEach(label => {
    label.hidden = !label.textContent.toLowerCase().includes(query);
  });
});
document.getElementById('key-models').addEventListener('change', () => {
  const count = document.querySelectorAll('#key-models input:checked').length;
  document.getElementById('key-model-count').textContent = count + ' models selected';
});

{
  const modal = document.getElementById('add-modal');
  const form = document.getElementById('download-form');
  const button = document.getElementById('btn-pull');
  modal.resetInspection = () => {
    modal.controller?.abort();
    modal.controller = null;
    modal.load = Symbol();
    modal.inspection = null;
    delete modal.dataset.busy;
    delete form.dataset.busy;
    form.setAttribute('aria-busy', 'false');
    form.querySelectorAll('input, button').forEach(control => { control.disabled = false; });
    button.textContent = 'Download';
    button.classList.remove('btn-danger');
    document.getElementById('inspect-result').hidden = true;
    document.getElementById('add-error').textContent = '';
  };
  form.addEventListener('input', () => {
    if (modal.dataset.busy !== 'starting') modal.resetInspection();
  });
  button.addEventListener('click', event => {
    if (event.detail > 1) event.preventDefault();
  });
  form.addEventListener('keydown', event => {
    if (event.key === 'Enter' && event.repeat) event.preventDefault();
  });
  form.addEventListener('submit', event => {
    event.preventDefault();
    startPull(button);
  });
}

async function startPull(button) {
  const modal = document.getElementById('add-modal');
  const form = document.getElementById('download-form');
  const dialog = modal.querySelector('[role="dialog"]');
  if (modal.dataset.busy || !modal.classList.contains('open')) return;
  const snapshot = () => ({
    repo_id: document.getElementById('add-repo').value.trim(),
    name: document.getElementById('add-name').value.trim() || undefined,
    revision: document.getElementById('add-rev').value.trim() || 'main'
  });
  const input = snapshot();
  const key = JSON.stringify(input);
  const error = document.getElementById('add-error');
  if (!input.repo_id) { error.textContent = 'Enter a Hugging Face repository ID.'; return; }
  const confirmed = modal.inspection?.key === key ? modal.inspection : null;
  modal.inspection = null;
  const load = Symbol();
  modal.load = load;
  const current = () => modal.load === load && modal.classList.contains('open') && JSON.stringify(snapshot()) === key;
  const controller = new AbortController();
  modal.controller = controller;
  const timeout = setTimeout(() => controller.abort(), 60000);
  modal.dataset.busy = 'checking';
  form.setAttribute('aria-busy', 'true');
  error.textContent = '';
  const buttonFocused = document.activeElement === button;
  button.disabled = true;
  if (buttonFocused) dialog.focus();
  button.textContent = confirmed ? 'Starting download…' : 'Checking compatibility…';
  if (!confirmed) document.getElementById('inspect-result').hidden = true;
  let starting = false;
  try {
    let target = confirmed?.target;
    if (!confirmed) {
      const d = await api('/api/models/inspect', {
        method: 'POST', headers: {'Content-Type': 'application/json'}, signal: controller.signal,
        body: JSON.stringify({repo_id: input.repo_id, revision: input.revision})
      });
      if (!current()) return;
      const m = d.metadata;
      if (typeof d.fits !== 'boolean' || !m || typeof m.repo_id !== 'string' || !m.repo_id || typeof m.resolved_revision !== 'string' || !/^[0-9a-f]{40}$/i.test(m.resolved_revision)) throw new Error('The compatibility check did not resolve an exact model revision. Retry Download.');
      target = {repo_id: m.repo_id, name: input.name, revision: m.resolved_revision};
      if (!d.fits) {
        modal.inspection = {key, target};
        const targetText = document.getElementById('inspect-target');
        targetText.textContent = m.repo_id + ' @ ' + m.resolved_revision.slice(0, 12);
        targetText.title = m.resolved_revision;
        document.getElementById('inspect-arch').textContent = Array.isArray(m.architectures) && m.architectures.length ? m.architectures.join(', ') : 'unknown';
        document.getElementById('inspect-storage').textContent = formatMiB(m.storage_mib);
        document.getElementById('inspect-vram').textContent = formatMiB(m.estimated_memory_mib);
        const fit = document.getElementById('inspect-fit');
        fit.className = 'inspect-fit insufficient';
        fit.textContent = typeof d.reason === 'string' ? d.reason : 'This model exceeds the available memory.';
        document.getElementById('inspect-result').hidden = false;
        return;
      }
    }
    if (!current()) return;
    starting = true;
    modal.dataset.busy = 'starting';
    form.dataset.busy = 'true';
    form.querySelectorAll('input, button').forEach(control => { control.disabled = true; });
    dialog.focus();
    button.textContent = 'Starting download…';
    const d = await api('/api/models/pull', {
      method: 'POST', headers: {'Content-Type': 'application/json'}, signal: controller.signal,
      body: JSON.stringify({...target, force: Boolean(confirmed)})
    });
    delete form.dataset.busy;
    closeModal('add-modal');
    showToast(d.message);
    await loadModels();
  } catch (err) {
    if (modal.load === load) {
      error.textContent = starting && (err.name === 'AbortError' || err instanceof TypeError)
        ? 'Could not confirm whether the download started. Check Download Activity before retrying.'
        : err.name === 'AbortError' ? 'The compatibility check timed out. Retry Download.' : err.message;
    }
  } finally {
    clearTimeout(timeout);
    if (modal.load === load) {
      delete modal.dataset.busy;
      delete form.dataset.busy;
      modal.controller = null;
      form.setAttribute('aria-busy', 'false');
      form.querySelectorAll('input, button').forEach(control => { control.disabled = false; });
      button.textContent = modal.inspection ? 'Download anyway' : 'Download';
      button.classList.toggle('btn-danger', Boolean(modal.inspection));
      if (document.activeElement === dialog) button.focus();
    }
  }
}

async function api(path, options) {
  const response = await fetch(path, options);
  const data = await response.json();
  if (!response.ok || !data.ok) {
    const error = data.error;
    throw new Error(typeof error === 'string' ? error : error ? JSON.stringify(error) : 'Request failed: ' + response.status);
  }
  return data;
}

function tableMessage(body, columns, message) {
  body.replaceChildren();
  const cell = body.insertRow().insertCell();
  cell.colSpan = columns;
  cell.textContent = message;
}

function tableRow(body, values) {
  const row = body.insertRow();
  values.forEach(value => { row.insertCell().textContent = value; });
  return row.insertCell();
}

function actionButton(cell, text, danger, action) {
  const button = document.createElement('button');
  button.type = 'button';
  button.className = 'btn btn-sm' + (danger ? ' btn-danger' : '');
  button.textContent = text;
  button.addEventListener('click', () => action(button));
  cell.append(button);
}

const usersView = {
  users: null,
  keys: null,
  selected: null,
  load: 0,

  keyStatus(key) {
    if (key.blocked) return 'Blocked';
    if (key.expires) {
      const expiry = Date.parse(key.expires);
      if (!Number.isFinite(expiry)) return 'Expiry unknown';
      if (expiry <= Date.now()) return 'Expired';
    }
    return 'Enabled';
  },

  renderUsers() {
    const body = document.getElementById('users-body');
    body.replaceChildren();
    const query = document.getElementById('users-search').value.trim().toLowerCase();
    const users = (this.users || []).filter(user =>
      [user.user_id, user.user_email].some(value => String(value || '').toLowerCase().includes(query)));
    if (!users.length) {
      tableMessage(body, 3, this.users === null ? 'Users unavailable.' : query ? 'No matching users.' : 'No users. Create a user to issue API keys.');
      return;
    }
    const counts = new Map();
    (this.keys || []).forEach(key => {
      if (this.keyStatus(key) === 'Enabled') counts.set(key.user_id, (counts.get(key.user_id) || 0) + 1);
    });
    users.forEach(user => {
      const row = body.insertRow();
      const identity = row.insertCell();
      identity.dataset.label = 'User ID';
      const link = document.createElement('button');
      link.type = 'button';
      link.className = 'user-link';
      link.textContent = user.user_id;
      link.addEventListener('click', () => this.showUser(user));
      identity.append(link);
      const email = row.insertCell();
      email.dataset.label = 'Email';
      email.textContent = user.user_email || '—';
      const count = row.insertCell();
      count.dataset.label = 'Enabled keys';
      count.textContent = this.keys === null ? 'Unavailable' : String(counts.get(user.user_id) || 0);
    });
  },

  showUser(user) {
    this.selected = user.user_id;
    document.getElementById('users-list').hidden = true;
    document.getElementById('user-detail').hidden = false;
    document.getElementById('user-heading').textContent = user.user_id;
    document.getElementById('user-detail-email').textContent = user.user_email || 'No email address';
    document.getElementById('user-heading').focus();
    this.refresh();
  },

  showList() {
    this.selected = null;
    document.getElementById('user-detail').hidden = true;
    document.getElementById('users-list').hidden = false;
    document.getElementById('users-search').focus();
    this.refresh();
  },

  async refresh() {
    const load = ++this.load;
    const uid = this.selected;
    const status = document.getElementById('users-status');
    const error = document.getElementById('keys-error');
    const body = document.getElementById('keys-body');
    status.textContent = uid === null ? 'Loading users...' : '';
    error.textContent = '';
    document.getElementById('keys-count').textContent = '';
    this.keys = null;
    if (uid === null) this.renderUsers();
    else tableMessage(body, 5, 'Loading API keys...');
    const [users, keys] = await Promise.allSettled([
      api('/api/users'),
      api('/api/keys' + (uid === null ? '' : '?user_id=' + encodeURIComponent(uid)))
    ]);
    if (load !== this.load) return;
    if (users.status === 'fulfilled' && Array.isArray(users.value.users)) {
      this.users = users.value.users;
      if (uid !== null) {
        const user = this.users.find(user => user.user_id === uid);
        if (!user) { this.showList(); return; }
        document.getElementById('user-detail-email').textContent = user.user_email || 'No email address';
      }
      status.textContent = '';
    } else {
      const message = 'Unable to refresh users: ' + (users.reason?.message || 'Invalid users response');
      if (uid === null) status.textContent = message;
      else error.textContent = message;
    }
    if (keys.status === 'fulfilled' && Array.isArray(keys.value.keys)) {
      this.keys = keys.value.keys;
    } else {
      const message = 'Unable to load API keys: ' + (keys.reason?.message || 'Invalid keys response');
      if (uid === null) status.textContent += (status.textContent ? ' ' : '') + message;
      else error.textContent += (error.textContent ? ' ' : '') + message;
    }
    if (uid === null) { this.renderUsers(); return; }
    if (this.keys === null) { tableMessage(body, 5, 'API keys unavailable. Use Refresh to retry.'); return; }
    body.replaceChildren();
    const owned = this.keys.filter(key => key.user_id === uid);
    document.getElementById('keys-count').textContent = owned.length === 1 ? '1 key' : owned.length + ' keys';
    if (!owned.length) tableMessage(body, 5, 'No API keys for this user. Create a key to grant API access.');
    owned.forEach(key => {
      const models = Array.isArray(key.models) && key.models.length ? key.models.join(', ') : 'All models (including future models)';
      const expiry = key.expires ? Date.parse(key.expires) : null;
      const expires = expiry === null ? 'Never' : Number.isFinite(expiry) ? new Date(expiry).toLocaleString() : 'Unknown';
      const actions = tableRow(body, [key.key_alias || key.key_name || 'Unnamed key', models, this.keyStatus(key), expires]);
      actionButton(actions, 'Revoke', true, button => this.revokeKey(key, uid, button));
      actions.lastElementChild.disabled = !key.token;
      Array.from(actions.parentElement.cells).forEach((cell, index) => {
        cell.dataset.label = ['Name', 'Models', 'Status', 'Expires', 'Actions'][index];
      });
    });
  },

  openUserModal() {
    if (document.getElementById('user-form').dataset.busy) return;
    document.getElementById('user-form').reset();
    document.getElementById('user-error').textContent = '';
    document.getElementById('user-submit').disabled = false;
    openDialog('user-modal');
  },

  async submitCreateUser() {
    const form = document.getElementById('user-form');
    const button = document.getElementById('user-submit');
    if (form.dataset.busy || !form.reportValidity()) return;
    const uid = document.getElementById('user-id').value.trim();
    const error = document.getElementById('user-error');
    if (!uid) { error.textContent = 'User ID is required'; return; }
    const email = document.getElementById('user-email').value.trim() || undefined;
    form.dataset.busy = 'true';
    button.disabled = true;
    error.textContent = '';
    try {
      await api('/api/users', {
        method: 'POST',
        headers: {'Content-Type': 'application/json'},
        body: JSON.stringify({user_id: uid, email})
      });
      delete form.dataset.busy;
      closeModal('user-modal');
      showToast('Created user ' + uid);
      this.showUser({user_id: uid, user_email: email});
    } catch (err) { error.textContent = err.message; }
    finally { delete form.dataset.busy; button.disabled = false; }
  },

  async deleteUser(button) {
    const uid = this.selected;
    if (uid === null || button.disabled || !confirm('Delete user ' + uid + ' and ALL their API keys? This cannot be undone.')) return;
    button.disabled = true;
    const create = document.getElementById('user-create-key');
    create.disabled = true;
    try {
      await api('/api/users/' + encodeURIComponent(uid), {method: 'DELETE'});
      showToast('Removed user and their API keys');
      if (this.selected === uid) this.showList();
      else this.refresh();
    } catch (err) {
      await this.refresh();
      if (this.selected === uid) {
        const error = document.getElementById('keys-error');
        error.textContent = err.message + (error.textContent ? ' ' + error.textContent : '');
      } else showToast(err.message);
    } finally { button.disabled = false; create.disabled = false; }
  },

  async openKeyModal() {
    const form = document.getElementById('key-form');
    if (this.selected === null || form.dataset.busy) return;
    form.reset();
    const modal = document.getElementById('key-modal');
    const load = Symbol();
    modal.load = load;
    modal.userId = this.selected;
    document.getElementById('key-owner').textContent = 'User: ' + modal.userId;
    const models = document.getElementById('key-models');
    const error = document.getElementById('key-error');
    models.textContent = 'Loading installed models...';
    document.getElementById('key-model-selector').hidden = true;
    document.getElementById('key-model-count').textContent = '0 models selected';
    document.getElementById('key-submit').disabled = false;
    error.textContent = '';
    openDialog('key-modal');
    try {
      const data = await api('/api/models');
      if (modal.load !== load) return;
      if (!Array.isArray(data.models)) throw new Error('Invalid models response');
      models.replaceChildren();
      data.models.forEach(model => {
        const label = document.createElement('label');
        label.className = 'model-chip';
        const checkbox = document.createElement('input');
        checkbox.type = 'checkbox';
        checkbox.value = model.name;
        label.append(checkbox, document.createTextNode(' ' + model.name));
        models.append(label);
      });
      if (!data.models.length) models.textContent = 'No models installed.';
    } catch (err) {
      if (modal.load === load) models.textContent = 'Unable to load models: ' + err.message + '. Close and reopen this form to retry, or choose All models.';
    }
  },

  async submitCreateKey() {
    const form = document.getElementById('key-form');
    const button = document.getElementById('key-submit');
    if (button.disabled || form.dataset.busy || !form.reportValidity()) return;
    const uid = document.getElementById('key-modal').userId;
    const alias = document.getElementById('key-alias').value.trim();
    const selected = document.getElementById('key-model-access').value === 'selected';
    const models = selected ? Array.from(document.querySelectorAll('#key-models input:checked'), checkbox => checkbox.value) : [];
    const error = document.getElementById('key-error');
    if (!uid || uid !== this.selected) { error.textContent = 'Open the user again before creating a key.'; return; }
    if (!alias) { error.textContent = 'Key name is required.'; return; }
    if (selected && !models.length) { error.textContent = 'Select at least one model, or choose All models.'; return; }
    const duration = document.getElementById('key-duration').value.trim() || undefined;
    form.dataset.busy = 'true';
    button.disabled = true;
    error.textContent = '';
    try {
      const data = await api('/api/keys', {
        method: 'POST',
        headers: {'Content-Type': 'application/json'},
        body: JSON.stringify({user_id: uid, alias, models, duration})
      });
      this.refresh();
      if (!data.key || typeof data.key.key !== 'string' || !data.key.key) throw new Error('Key created, but the API returned no secret. Revoke it and try again.');
      delete form.dataset.busy;
      closeModal('key-modal');
      document.getElementById('created-key-token').textContent = data.key.key;
      document.getElementById('copy-status').textContent = '';
      openDialog('key-result-modal');
      document.getElementById('key-result-modal').opener = document.getElementById('user-create-key');
    } catch (err) { error.textContent = err.message; }
    finally { delete form.dataset.busy; button.disabled = false; }
  },

  async revokeKey(key, uid, button) {
    if (button.disabled || !confirm('Revoke key ' + (key.key_alias || key.key_name || 'Unnamed key') + ' for user ' + uid + '? Applications using it will lose access.')) return;
    const restoreFocus = document.activeElement === button;
    button.disabled = true;
    try {
      await api('/api/keys/' + encodeURIComponent(key.token), {method: 'DELETE'});
      showToast('API key revoked');
      await this.refresh();
      if (restoreFocus && this.selected === uid && currentTab === 'users' && !document.querySelector('.modal-overlay.open')) {
        document.getElementById('user-create-key').focus();
      }
    } catch (err) {
      if (this.selected === uid) document.getElementById('keys-error').textContent = err.message;
      else showToast(err.message);
    } finally { button.disabled = false; }
  }
};

document.getElementById('users-search').addEventListener('input', () => usersView.renderUsers());
document.getElementById('user-form').addEventListener('submit', event => {
  event.preventDefault();
  usersView.submitCreateUser();
});
document.getElementById('key-form').addEventListener('submit', event => {
  event.preventDefault();
  usersView.submitCreateKey();
});

async function copyKey() {
  const token = document.getElementById('created-key-token');
  const text = token.textContent;
  if (!text) return;
  try {
    if (!navigator.clipboard) throw new Error('Clipboard unavailable');
    await navigator.clipboard.writeText(text);
    if (token.textContent === text) document.getElementById('copy-status').textContent = 'Copied API key to clipboard';
  } catch (err) {
    if (token.textContent !== text) return;
    const range = document.createRange();
    range.selectNodeContents(token);
    const selection = window.getSelection();
    selection.removeAllRanges();
    selection.addRange(range);
    document.getElementById('copy-status').textContent = 'Automatic copy unavailable. Key selected; press Ctrl+C or use your browser’s Copy command.';
  }
}

function showEffectiveUserAgent(value) {
  document.getElementById('settings-effective').textContent = 'Effective User-Agent: ' + value;
}

async function loadSettings() {
  const input = document.getElementById('settings-contact');
  const error = document.getElementById('settings-error');
  error.textContent = '';
  try {
    const data = await api('/api/settings');
    input.value = (data.settings && data.settings.http_user_agent_contact) || '';
    showEffectiveUserAgent(data.effective_user_agent || '-');
  } catch (err) {
    error.textContent = err.message;
  }
}

async function storeSettings(contact, button) {
  const error = document.getElementById('settings-error');
  if (button.disabled) return;
  button.disabled = true;
  error.textContent = '';
  try {
    const data = await api('/api/settings', {
      method: 'POST',
      headers: {'Content-Type': 'application/json'},
      body: JSON.stringify({http_user_agent_contact: contact})
    });
    document.getElementById('settings-contact').value = (data.settings && data.settings.http_user_agent_contact) || '';
    showEffectiveUserAgent(data.effective_user_agent || '-');
    showToast(data.applied ? 'Saved outbound HTTP contact' : 'Saved outbound HTTP contact (applies at next install)');
  } catch (err) { error.textContent = err.message; }
  finally { button.disabled = false; }
}

function saveSettings(button) {
  storeSettings(document.getElementById('settings-contact').value.trim(), button);
}

function clearSettings(button) {
  document.getElementById('settings-contact').value = '';
  storeSettings('', button);
}

setInterval(() => {
  if (currentTab === 'monitoring') loadMonitoring();
  if (currentTab === 'models') checkPullStatus();
}, 2500);

loadMonitoring();
</script>
</body>
</html>
"""


def main() -> None:
    parser = argparse.ArgumentParser(description="OKSA Web")
    parser.add_argument("--host", default="0.0.0.0", help="Listen host address (default: 0.0.0.0)")
    parser.add_argument("--port", type=int, default=8088, help="Listen port (default: 8088)")
    args = parser.parse_args()

    class ThreadedHTTPServer(socketserver.ThreadingMixIn, http.server.HTTPServer):
        daemon_threads = True

    server_address = (args.host, args.port)
    httpd = ThreadedHTTPServer(server_address, OksaWebHandler)
    print(f"OKSA Web service listening on http://{args.host}:{args.port}")
    try:
        httpd.serve_forever()
    except KeyboardInterrupt:
        print("\nShutting down OKSA Web service.")
        httpd.server_close()


if __name__ == "__main__":
    main()
