import argparse
import http.server
import json
import os
from pathlib import Path
import re
import shutil
import socketserver
import subprocess
import sys
import threading
import time
import urllib.parse

libexec_dir = Path("/usr/libexec/puu")
for directory in (Path(__file__).resolve().parent, libexec_dir):
    if directory.is_dir() and str(directory) not in sys.path:
        sys.path.insert(0, str(directory))
import oksa_model_serving as ms

state_dir = Path(os.environ.get("PUU_VLLM_STATE_DIR", "/var/lib/puu/vllm"))


def resolve_helper(name: str) -> Path:
    installed = libexec_dir / name
    if installed.is_file():
        return installed
    sibling = Path(__file__).resolve().parent / name
    if sibling.is_file():
        return sibling
    return installed


discover_bin = resolve_helper("oksa-discover-vllm-models")
planner_bin = resolve_helper("oksa-plan-vllm-workloads")
preseed_bin = resolve_helper("oksa-preseed-vllm-models")

pull_lock = threading.Lock()
pull_state = {
    "running": False,
    "repo_id": None,
    "model_name": None,
    "progress": "",
    "error": None,
    "complete": False,
    "started_at": 0,
    "ended_at": 0,
}


def control_files() -> tuple[Path, Path]:
    selected = Path(os.environ.get("PUU_VLLM_SELECTED_MODEL_FILE", str(state_dir / "selected-model")))
    disabled = Path(os.environ.get("PUU_VLLM_SERVING_DISABLED_FILE", str(state_dir / "serving.disabled")))
    return selected, disabled


def run_discover() -> None:
    if os.geteuid() == 0 and discover_bin.is_file() and os.access(discover_bin, os.X_OK):
        subprocess.run([str(discover_bin)], check=False)


def check_capabilities(model_name: str) -> bool:
    if not planner_bin.is_file() or not os.access(planner_bin, os.X_OK):
        return False
    import tempfile
    with tempfile.TemporaryDirectory() as tmp_dir:
        check_dir = Path(tmp_dir)
        manifests_dir = check_dir / "manifests"
        manifests_dir.mkdir(parents=True, exist_ok=True)
        env = dict(
            os.environ,
            PUU_K3S_MANIFEST_DIR=str(manifests_dir),
            PUU_VLLM_SELECTED_MODEL=model_name,
            PUU_VLLM_REQUIRE_SELECTED_MODEL="true",
            PUU_VLLM_IGNORE_SERVING_DISABLED="true",
            PUU_VLLM_ACTIVE_MODEL_FILE=str(check_dir / "active-model"),
        )
        res = subprocess.run([str(planner_bin)], env=env, capture_output=True)
        return res.returncode == 0


def get_models_metadata() -> dict[str, dict]:
    models_json_path = state_dir / "models.json"
    meta = {}
    if models_json_path.is_file():
        try:
            data = json.loads(models_json_path.read_text(encoding="utf-8"))
            if isinstance(data, list):
                for item in data:
                    if isinstance(item, dict) and "name" in item:
                        meta[item["name"]] = item
        except (OSError, ValueError):
            pass
    return meta


def collect_models_list() -> dict:
    run_discover()
    active_model_file = Path(os.environ.get("PUU_VLLM_ACTIVE_MODEL_FILE", str(state_dir / "active-model")))
    active_model = ms.read_first_line(active_model_file)
    selected_file, disabled_file = control_files()
    serving_enabled = not disabled_file.exists()
    selected_model = ms.read_first_line(selected_file)

    meta_map = get_models_metadata()
    models = []
    for name, path, env_path in ms.read_models_list(state_dir / "models.list"):
        meta = meta_map.get(name, {})
        cap = "ok" if check_capabilities(name) else "insufficient"
        models.append({
            "name": name,
            "repo_id": meta.get("repo_id") or "-",
            "storage_mib": meta.get("storage_mib") or 0,
            "quantization": meta.get("quantization") or "none",
            "capabilities": cap,
            "active": (name == active_model),
            "selected": (name == selected_model),
        })

    return {
        "ok": True,
        "active_model": active_model,
        "selected_model": selected_model,
        "serving_enabled": serving_enabled,
        "models": models,
    }


def background_pull_worker(repo_id: str, name: str | None, revision: str, force: bool) -> None:
    global pull_state
    with pull_lock:
        pull_state["running"] = True
        pull_state["repo_id"] = repo_id
        pull_state["model_name"] = name
        pull_state["progress"] = "Starting download..."
        pull_state["error"] = None
        pull_state["complete"] = False
        pull_state["started_at"] = time.time()
        pull_state["ended_at"] = 0

    cmd = [str(preseed_bin), "--repo-id", repo_id, "--revision", revision]
    if name:
        cmd.extend(["--name", name])
    if force:
        cmd.append("--force")

    try:
        proc = subprocess.Popen(
            cmd,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            text=True,
            bufsize=1,
        )
        output_lines = []
        if proc.stdout:
            for line in iter(proc.stdout.readline, ""):
                output_lines.append(line.strip())
                if len(output_lines) > 20:
                    output_lines.pop(0)
                with pull_lock:
                    pull_state["progress"] = line.strip()
            proc.stdout.close()
        proc.wait()

        with pull_lock:
            pull_state["running"] = False
            pull_state["ended_at"] = time.time()
            if proc.returncode == 0:
                pull_state["complete"] = True
                pull_state["progress"] = "Model download completed successfully."
            else:
                pull_state["complete"] = False
                pull_state["error"] = f"Download process exited with code {proc.returncode}"
    except Exception as exc:
        with pull_lock:
            pull_state["running"] = False
            pull_state["ended_at"] = time.time()
            pull_state["error"] = str(exc)

    run_discover()


class OksaWebHandler(http.server.BaseHTTPRequestHandler):
    server_version = "OksaWeb/1.0"

    def send_json(self, status: int, data: dict) -> None:
        payload = json.dumps(data).encode("utf-8")
        self.send_response(status)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(payload)))
        self.send_header("Cache-Control", "no-cache, no-store, must-revalidate")
        self.send_header("Access-Control-Allow-Origin", "*")
        self.send_header("Access-Control-Allow-Methods", "GET, POST, DELETE, OPTIONS")
        self.send_header("Access-Control-Allow-Headers", "Content-Type, Authorization")
        self.end_headers()
        self.wfile.write(payload)

    def read_json_body(self) -> dict | None:
        try:
            content_length = int(self.headers.get("Content-Length", 0))
            if content_length <= 0:
                return {}
            raw_data = self.rfile.read(content_length).decode("utf-8")
            return json.loads(raw_data)
        except Exception:
            return None

    def do_OPTIONS(self) -> None:
        self.send_response(204)
        self.send_header("Access-Control-Allow-Origin", "*")
        self.send_header("Access-Control-Allow-Methods", "GET, POST, DELETE, OPTIONS")
        self.send_header("Access-Control-Allow-Headers", "Content-Type, Authorization")
        self.end_headers()

    def do_GET(self) -> None:
        parsed = urllib.parse.urlparse(self.path)
        path = parsed.path
        query = urllib.parse.parse_qs(parsed.query)

        if path in ("/", "/index.html"):
            payload = HTML_PAGE.encode("utf-8")
            self.send_response(200)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.send_header("Content-Length", str(len(payload)))
            self.end_headers()
            self.wfile.write(payload)
            return

        if path == "/api/status":
            status_data = ms.collect_serving_status()
            self.send_json(200, {"ok": True, "status": status_data})
            return

        if path == "/api/users":
            ok, users = ms.litellm_user_list()
            self.send_json(200 if ok else 500, {
                "ok": ok,
                "users": users if ok else [],
                "error": None if ok else str(users)
            })
            return

        if path.startswith("/api/users/"):
            user_id = urllib.parse.unquote(path[len("/api/users/"):])
            ok, user_info = ms.litellm_user_info(user_id)
            self.send_json(200 if ok else 404, {
                "ok": ok,
                "user": user_info if ok else None,
                "error": None if ok else str(user_info)
            })
            return

        if path == "/api/keys":
            user_id = query.get("user_id", [None])[0]
            ok, keys = ms.litellm_key_list(user_id=user_id)
            self.send_json(200 if ok else 500, {
                "ok": ok,
                "keys": keys if ok else [],
                "error": None if ok else str(keys)
            })
            return

        if path == "/api/models":
            self.send_json(200, collect_models_list())
            return

        if path == "/api/models/pull/status":
            with pull_lock:
                state_copy = dict(pull_state)
            self.send_json(200, {"ok": True, "pull": state_copy})
            return

        self.send_json(404, {"ok": False, "error": "Not Found"})

    def do_POST(self) -> None:
        parsed = urllib.parse.urlparse(self.path)
        path = parsed.path
        body = self.read_json_body()
        if body is None:
            self.send_json(400, {"ok": False, "error": "Invalid JSON body"})
            return

        if path == "/api/users":
            user_id = body.get("user_id")
            if not user_id:
                self.send_json(400, {"ok": False, "error": "user_id is required"})
                return
            email = body.get("email")
            budget = body.get("budget")
            if budget is not None:
                try:
                    budget = float(budget)
                except ValueError:
                    self.send_json(400, {"ok": False, "error": "budget must be a number"})
                    return
            ok, res = ms.litellm_user_create(user_id, email=email, max_budget=budget)
            self.send_json(200 if ok else 400, {
                "ok": ok,
                "result": res if ok else None,
                "error": None if ok else str(res)
            })
            return

        if path == "/api/keys":
            user_id = body.get("user_id")
            if not user_id:
                self.send_json(400, {"ok": False, "error": "user_id is required"})
                return
            alias = body.get("alias")
            models = body.get("models")
            if isinstance(models, str):
                models = [m.strip() for m in models.split(",") if m.strip()]
            spend = body.get("spend")
            if spend is not None:
                try:
                    spend = float(spend)
                except ValueError:
                    self.send_json(400, {"ok": False, "error": "spend must be a number"})
                    return
            duration = body.get("duration")
            ok, res = ms.litellm_key_create(
                user_id,
                alias=alias,
                models=models,
                max_budget=spend,
                duration=duration,
            )
            self.send_json(200 if ok else 400, {
                "ok": ok,
                "key": res if ok else None,
                "error": None if ok else str(res)
            })
            return

        if path == "/api/models/inspect":
            repo_id = body.get("repo_id")
            if not repo_id:
                self.send_json(400, {"ok": False, "error": "repo_id is required"})
                return
            revision = body.get("revision", "main")
            meta = ms.inspect_hf_model(repo_id, revision)
            if not meta:
                self.send_json(404, {"ok": False, "error": f"Failed to fetch metadata for {repo_id}"})
                return
            mem_mib = meta.get("estimated_memory_mib", 0)
            fits, reason = ms.check_model_capacity(mem_mib)
            self.send_json(200, {
                "ok": True,
                "metadata": meta,
                "fits": fits,
                "reason": reason
            })
            return

        if path == "/api/models/pull":
            repo_id = body.get("repo_id")
            if not repo_id:
                self.send_json(400, {"ok": False, "error": "repo_id is required"})
                return
            name = body.get("name")
            revision = body.get("revision", "main")
            force = bool(body.get("force", False))

            with pull_lock:
                if pull_state["running"]:
                    self.send_json(409, {"ok": False, "error": "Another model download is currently running"})
                    return

            thread = threading.Thread(
                target=background_pull_worker,
                args=(repo_id, name, revision, force),
                daemon=True,
            )
            thread.start()
            self.send_json(200, {"ok": True, "message": f"Download started for {repo_id}"})
            return

        if path == "/api/models/start":
            model_name = body.get("name")
            if not model_name:
                self.send_json(400, {"ok": False, "error": "name is required"})
                return
            if not check_capabilities(model_name):
                self.send_json(400, {"ok": False, "error": "Model has insufficient host capabilities"})
                return
            state_dir.mkdir(parents=True, exist_ok=True)
            selected_model_file, serving_disabled_file = control_files()
            ms.atomic_write_text(selected_model_file, f"{model_name}\n")
            serving_disabled_file.unlink(missing_ok=True)
            env = dict(os.environ, PUU_VLLM_SELECTED_MODEL=model_name, PUU_VLLM_REQUIRE_SELECTED_MODEL="true")
            res = subprocess.run([str(planner_bin)], env=env, capture_output=True)
            if res.returncode != 0:
                self.send_json(500, {"ok": False, "error": "Failed to activate model workload"})
                return
            self.send_json(200, {"ok": True, "message": f"Model {model_name} activated"})
            return

        if path == "/api/models/stop":
            state_dir.mkdir(parents=True, exist_ok=True)
            selected_model_file, serving_disabled_file = control_files()
            selected_model_file.unlink(missing_ok=True)
            ms.atomic_write_text(serving_disabled_file, "")
            res = subprocess.run([str(planner_bin)], capture_output=True)
            if res.returncode != 0:
                self.send_json(500, {"ok": False, "error": "Failed to stop model workload"})
                return
            self.send_json(200, {"ok": True, "message": "Model serving stopped"})
            return

        self.send_json(404, {"ok": False, "error": "Not Found"})

    def do_DELETE(self) -> None:
        parsed = urllib.parse.urlparse(self.path)
        path = parsed.path

        if path.startswith("/api/users/"):
            user_id = urllib.parse.unquote(path[len("/api/users/"):])
            ok, res = ms.litellm_user_delete(user_id)
            self.send_json(200 if ok else 400, {
                "ok": ok,
                "message": res if ok else None,
                "error": None if ok else str(res)
            })
            return

        if path.startswith("/api/keys/"):
            key_or_alias = urllib.parse.unquote(path[len("/api/keys/"):])
            ok, res = ms.litellm_key_delete(key_or_alias)
            self.send_json(200 if ok else 400, {
                "ok": ok,
                "message": res if ok else None,
                "error": None if ok else str(res)
            })
            return

        if path.startswith("/api/models/"):
            model_name = urllib.parse.unquote(path[len("/api/models/"):])
            if (not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._-]*", model_name)
                    or not (ms.MODELS_DIR / model_name).resolve().is_relative_to(ms.MODELS_DIR.resolve())):
                self.send_json(400, {"ok": False, "error": "Invalid model name"})
                return
            active_model_file = Path(os.environ.get("PUU_VLLM_ACTIVE_MODEL_FILE", str(state_dir / "active-model")))
            if ms.read_first_line(active_model_file) == model_name:
                selected_model_file, serving_disabled_file = control_files()
                selected_model_file.unlink(missing_ok=True)
                ms.atomic_write_text(serving_disabled_file, "")
                subprocess.run([str(planner_bin)], capture_output=True)

            model_dir = ms.MODELS_DIR / model_name
            if model_dir.exists():
                shutil.rmtree(model_dir)
            env_file = state_dir / "models.d" / f"{model_name}.env"
            env_file.unlink(missing_ok=True)
            run_discover()
            subprocess.run([str(planner_bin)], capture_output=True)
            self.send_json(200, {"ok": True, "message": f"Model {model_name} deleted"})
            return

        self.send_json(404, {"ok": False, "error": "Not Found"})


