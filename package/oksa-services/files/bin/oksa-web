<script>
let currentTab = 'monitoring';
let pollInterval = null;

function escapeHTML(value) {
  return String(value ?? '').replace(/[&<>"']/g, char => ({'&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'}[char]));
}

function showToast(msg) {
  const t = document.getElementById('toast');
  t.textContent = msg;
  t.style.display = 'block';
  setTimeout(() => { t.style.display = 'none'; }, 3500);
}

function switchTab(tab) {
  currentTab = tab;
  document.querySelectorAll('.nav-tab').forEach(b => b.classList.remove('active'));
  document.querySelectorAll('.tab-content').forEach(c => c.classList.remove('active'));
  const btn = Array.from(document.querySelectorAll('.nav-tab')).find(b => b.getAttribute('onclick').includes(tab));
  if (btn) btn.classList.add('active');
  const panel = document.getElementById('tab-' + tab);
  if (panel) panel.classList.add('active');

  if (tab === 'monitoring') loadMonitoring();
  if (tab === 'models') loadModels();
  if (tab === 'users') { loadUsers(); loadKeys(); }
}

async function loadMonitoring() {
  try {
    const res = await fetch('/api/status');
    const data = await res.json();
    if (!data.ok) return;
    const s = data.status;

    if (s.host_memory) {
      document.getElementById('host-mem-val').textContent = s.host_memory.used_mib + ' / ' + s.host_memory.total_mib + ' MiB';
      document.getElementById('host-mem-sub').textContent = s.host_memory.used_pct + '% memory used';
    }

    document.getElementById('active-model-val').textContent = s.active_model || 'None';
    document.getElementById('active-model-sub').textContent = 'Selected: ' + (s.selected_model || 'None');

    const m = s.metrics || {};
    document.getElementById('inf-requests-val').textContent = (m.running_requests || 0) + ' / ' + (m.waiting_requests || 0);
    document.getElementById('kv-cache-val').textContent = (m.kv_cache_usage_pct || 0) + '%';

    const gBody = document.getElementById('gpus-body');
    if (s.gpus && s.gpus.length > 0) {
      gBody.innerHTML = s.gpus.map(g => `
        <tr>
          <td>[${escapeHTML(g.index)}]</td>
          <td><strong>${escapeHTML(g.name || 'NVIDIA')}</strong></td>
          <td>${escapeHTML(g.gpu_util_pct || 0)}%</td>
          <td>${Math.round(g.memory_used_mib || 0)} MiB</td>
          <td>${Math.round(g.memory_total_mib || 0)} MiB</td>
          <td>${escapeHTML(g.temperature_c || 0)}°C</td>
          <td>${g.power_w ? Number(g.power_w).toFixed(1) + 'W' : '-'}</td>
        </tr>
      `).join('');
    } else {
      gBody.innerHTML = '<tr><td colspan="7" style="text-align:center; color:var(--text-muted);">No GPU data</td></tr>';
    }

    const wBody = document.getElementById('workloads-body');
    if (s.workloads && s.workloads.length > 0) {
      wBody.innerHTML = s.workloads.map(w => `
        <tr>
          <td>${escapeHTML(w.name)}</td>
          <td><span class="pill ${w.phase === 'Running' ? 'ok' : 'insufficient'}">${escapeHTML(w.phase)}</span></td>
          <td>${w.ready ? 'Yes' : 'No'}</td>
          <td>${escapeHTML(w.restarts || 0)}</td>
        </tr>
      `).join('');
    } else {
      wBody.innerHTML = '<tr><td colspan="4" style="text-align:center; color:var(--text-muted);">No workloads reported</td></tr>';
    }
  } catch (err) {}
}

let cachedModels = null;

async function loadModels() {
  try {
    const data = await api('/api/models');
    cachedModels = data.models || [];
    const mBody = document.getElementById('models-body');
    mBody.replaceChildren();
    const active = cachedModels.find(model => model.active);
    document.getElementById('models-stop').disabled = !active;
    document.getElementById('models-summary').textContent = active
      ? 'Serving ' + active.name
      : data.serving_enabled === false
        ? 'Serving is stopped. No model is loaded.'
        : 'No model is serving.';
    if (!cachedModels.length) { tableMessage(mBody, 6, 'No models installed'); return checkPullStatus(); }
    cachedModels.forEach(model => {
      const row = mBody.insertRow();
      row.insertCell().innerHTML = '<strong>' + escapeHTML(model.name) + '</strong>';
      row.insertCell().textContent = model.repo_id;
      row.insertCell().textContent = formatMiB(model.storage_mib);
      row.insertCell().textContent = model.quantization || 'none';
      const state = row.insertCell();
      const statePill = document.createElement('span');
      statePill.className = 'pill ' + (model.active ? 'active' : model.capabilities === 'ok' ? 'ok' : 'insufficient');
      statePill.textContent = model.active ? 'Serving' : model.capabilities === 'ok' ? 'Ready' : 'Insufficient VRAM';
      state.append(statePill);
      const actions = row.insertCell();
      if (model.active) actionButton(actions, 'Stop', false, button => stopServing(button));
      else actionButton(actions, 'Start', false, button => startModel(model.id, button));
      if (model.removable !== false) actionButton(actions, 'Delete', true, button => removeModel(model.id, button));
    });
    checkPullStatus();
  } catch (err) {
    tableMessage(document.getElementById('models-body'), 6, 'Unable to load models: ' + err.message);
  }
}

function formatMiB(value) {
  const mib = Number(value) || 0;
  if (!mib) return '-';
  return mib >= 1024 ? (mib / 1024).toFixed(1) + ' GiB' : Math.round(mib) + ' MiB';
}

let pullWasRunning = false;

async function checkPullStatus() {
  try {
    const data = await api('/api/models/pull/status');
    const p = data.pull;
    const pCard = document.getElementById('pull-status-card');
    if (p && (p.running || p.complete || p.error)) {
      pCard.style.display = 'block';
      document.getElementById('pull-repo-text').textContent = p.running
        ? 'Downloading ' + p.repo_id
        : p.error ? 'Download failed' : 'Completed ' + p.repo_id;
      const summary = document.getElementById('pull-summary');
      summary.textContent = p.running ? 'In progress' : p.error ? 'The download stopped early. Review the log.' : 'The model is now available in the catalog.';
      summary.style.color = p.error ? 'var(--danger)' : '';
      updatePullLog(p.progress || p.error || '');
      if (pullWasRunning && !p.running) loadModels();
      pullWasRunning = !!p.running;
    } else {
      pCard.style.display = 'none';
    }
  } catch (err) {}
}

function updatePullLog(text) {
  const log = document.getElementById('pull-log-text');
  if (text && log.textContent !== text) log.textContent = text;
  document.getElementById('pull-log-toggle').hidden = !log.textContent;
}

function togglePullLog() {
  const log = document.getElementById('pull-log-text');
  log.hidden = !log.hidden;
  document.getElementById('pull-log-toggle').textContent = log.hidden ? 'Show Log' : 'Hide Log';
}

async function startModel(name, button) {
  if (button) button.disabled = true;
  try {
    const d = await api('/api/models/start', {
      method: 'POST',
      headers: {'Content-Type': 'application/json'},
      body: JSON.stringify({name: name})
    });
    showToast(d.message);
    await loadModels();
  } catch (err) { alert(err.message); }
  finally { if (button) button.disabled = false; }
}

async function stopServing(button) {
  if (button) button.disabled = true;
  try {
    const d = await api('/api/models/stop', {
      method: 'POST',
      headers: {'Content-Type': 'application/json'},
      body: JSON.stringify({})
    });
    showToast(d.message);
    await loadModels();
  } catch (err) { alert(err.message); }
  finally { if (button) button.disabled = false; }
}

async function removeModel(name, button) {
  if (!confirm('Remove model ' + name + '?')) return;
  if (button) button.disabled = true;
  try {
    const d = await api('/api/models/' + encodeURIComponent(name), { method: 'DELETE' });
    showToast(d.message);
    await loadModels();
  } catch (err) { alert(err.message); }
  finally { if (button) button.disabled = false; }
}

function openAddModal() {
  document.getElementById('add-error').textContent = '';
  document.getElementById('inspect-result').hidden = true;
  document.getElementById('force-group').style.display = 'none';
  document.getElementById('btn-pull').disabled = true;
  openDialog('add-modal');
}

function openDialog(id) {
  const modal = document.getElementById(id);
  modal.opener = document.activeElement;
  modal.classList.add('open');
  modal.querySelector('input:not(:disabled), select:not(:disabled), button, [role="dialog"]').focus();
}

function openUserModal() {
  if (document.getElementById('user-form').dataset.busy) return;
  document.getElementById('user-form').reset();
  document.getElementById('user-error').textContent = '';
  document.getElementById('user-submit').disabled = false;
  openDialog('user-modal');
}

async function openKeyModal(userId = '') {
  const form = document.getElementById('key-form');
  if (form.dataset.busy) return;
  form.reset();
  const modal = document.getElementById('key-modal');
  const load = Symbol();
  modal.load = load;
  const users = document.getElementById('key-user-id');
  const models = document.getElementById('key-models');
  const error = document.getElementById('key-error');
  users.replaceChildren();
  users.disabled = true;
  models.replaceChildren();
  document.getElementById('key-model-selector').hidden = true;
  document.getElementById('key-model-count').textContent = '0 models selected';
  document.getElementById('key-submit').disabled = true;
  error.textContent = 'Loading users and installed models...';
  openDialog('key-modal');
  try {
    const [u, m] = await Promise.all([cachedUsers === null ? api('/api/users') : Promise.resolve({users: cachedUsers}), api('/api/models')]);
    if (modal.load !== load) return;
    if (!Array.isArray(u.users) || !Array.isArray(m.models)) throw new Error('Invalid users or models response');
    const placeholder = document.createElement('option');
    placeholder.value = '';
    placeholder.textContent = 'Select a user';
    users.append(placeholder);
    u.users.forEach(user => {
      const option = document.createElement('option');
      option.value = user.user_id;
      option.textContent = user.user_id + (user.user_email ? ' — ' + user.user_email : '');
      users.append(option);
    });
    users.value = userId;
    users.disabled = !!userId;
    if (userId && users.value !== userId) throw new Error('Selected user is no longer available. Refresh the user roster.');
    m.models.forEach(model => {
      const label = document.createElement('label');
      label.className = 'model-chip';
      const checkbox = document.createElement('input');
      checkbox.type = 'checkbox';
      checkbox.value = model.name;
      const name = document.createElement('span');
      name.textContent = ' ' + model.name;
      label.append(checkbox, name);
      models.append(label);
    });
    if (!m.models.length) models.textContent = 'No models installed.';
    error.textContent = u.users.length ? '' : 'Create a user before creating a key.';
    document.getElementById('key-submit').disabled = !u.users.length;
  } catch (err) {
    if (modal.load === load) error.textContent = err.message;
  }
}

function closeModal(id) {
  const modal = document.getElementById(id);
  if (modal.querySelector('form')?.dataset.busy) return;
  modal.classList.remove('open');
  modal.load = null;
  if (id === 'key-result-modal') {
    document.getElementById('created-key-token').textContent = '';
    document.getElementById('copy-status').textContent = '';
    window.getSelection()?.removeAllRanges();
  }
  modal.opener?.focus();
}

document.addEventListener('keydown', event => {
  const modal = document.querySelector('.modal-overlay.open [role="dialog"]');
  if (!modal) return;
  if (event.key === 'Escape') closeModal(modal.parentElement.id);
  if (event.key !== 'Tab') return;
  const focusable = Array.from(modal.querySelectorAll('input, select, button, [tabindex="0"]')).filter(el => !el.disabled && el.getClientRects().length);
  const first = focusable[0], last = focusable[focusable.length - 1];
  if (event.shiftKey && (document.activeElement === first || document.activeElement === modal)) {
    event.preventDefault();
    last?.focus();
  } else if (!event.shiftKey && document.activeElement === last) {
    event.preventDefault();
    first?.focus();
  }
});

document.getElementById('key-model-access').addEventListener('change', () => {
  document.getElementById('key-model-selector').hidden = document.getElementById('key-model-access').value === 'all';
});
document.getElementById('key-model-search').addEventListener('input', event => {
  const query = event.target.value.toLowerCase();
  document.querySelectorAll('#key-models label').forEach(label => {
    label.hidden = !label.textContent.toLowerCase().includes(query);
  });
});
document.getElementById('key-models').addEventListener('change', () => {
  const count = document.querySelectorAll('#key-models input:checked').length;
  document.getElementById('key-model-count').textContent = count + ' models selected';
});

async function runInspect(button) {
  const repo = document.getElementById('add-repo').value.trim();
  const rev = document.getElementById('add-rev').value.trim() || 'main';
  const error = document.getElementById('add-error');
  if (!repo) { error.textContent = 'Enter a Hugging Face repository ID.'; return; }
  error.textContent = '';
  if (button) button.disabled = true;
  try {
    const d = await api('/api/models/inspect', {
      method: 'POST',
      headers: {'Content-Type': 'application/json'},
      body: JSON.stringify({repo_id: repo, revision: rev})
    });
    const m = d.metadata;
    document.getElementById('inspect-arch').textContent = m.architectures?.length ? m.architectures.join(', ') : 'unknown';
    document.getElementById('inspect-storage').textContent = formatMiB(m.storage_mib);
    document.getElementById('inspect-vram').textContent = formatMiB(m.estimated_memory_mib);
    const fit = document.getElementById('inspect-fit');
    const forceGroup = document.getElementById('force-group');
    const btnPull = document.getElementById('btn-pull');
    fit.className = 'inspect-fit';
    if (d.fits) {
      fit.innerHTML = '<span class="pill ok">Fits available memory</span>';
      forceGroup.style.display = 'none';
      btnPull.disabled = false;
    } else {
      fit.className = 'inspect-fit insufficient';
      fit.innerHTML = '<span class="pill insufficient">Insufficient memory</span> <span>' + escapeHTML(d.reason) + '</span>';
      forceGroup.style.display = 'block';
      const forceCheck = document.getElementById('add-force');
      forceCheck.checked = false;
      forceCheck.onchange = () => { btnPull.disabled = !forceCheck.checked; };
      btnPull.disabled = true;
    }
    document.getElementById('inspect-result').hidden = false;
  } catch (err) { error.textContent = err.message; }
  finally { if (button) button.disabled = false; }
}

async function startPull(button) {
  const repo = document.getElementById('add-repo').value.trim();
  const name = document.getElementById('add-name').value.trim() || undefined;
  const rev = document.getElementById('add-rev').value.trim() || 'main';
  const force = document.getElementById('add-force').checked;
  const error = document.getElementById('add-error');
  if (button) button.disabled = true;
  try {
    const d = await api('/api/models/pull', {
      method: 'POST',
      headers: {'Content-Type': 'application/json'},
      body: JSON.stringify({repo_id: repo, name: name, revision: rev, force: force})
    });
    closeModal('add-modal');
    showToast(d.message);
    await loadModels();
  } catch (err) { error.textContent = err.message; }
  finally { if (button) button.disabled = false; }
}

async function api(path, options) {
  const response = await fetch(path, options);
  const data = await response.json();
  if (!response.ok || !data.ok) {
    const error = data.error;
    throw new Error(typeof error === 'string' ? error : error ? JSON.stringify(error) : 'Request failed: ' + response.status);
  }
  return data;
}

function tableMessage(body, columns, message) {
  body.replaceChildren();
  const cell = body.insertRow().insertCell();
  cell.colSpan = columns;
  cell.textContent = message;
}

function tableRow(body, values) {
  const row = body.insertRow();
  values.forEach(value => { row.insertCell().textContent = value; });
  return row.insertCell();
}

function actionButton(cell, text, danger, action) {
  const button = document.createElement('button');
  button.type = 'button';
  button.className = 'btn btn-sm' + (danger ? ' btn-danger' : '');
  button.textContent = text;
  button.addEventListener('click', () => action(button));
  cell.append(button);
}

let cachedUsers = null;
let selectedUserId = null;
let keyCounts = null;
let usersLoad = 0;
let keysLoad = 0;

function budgetMarkup(spend, budget) {
  const used = Number(spend ?? 0);
  const limit = budget == null ? null : Number(budget);
  if (!Number.isFinite(used) || (limit !== null && (!Number.isFinite(limit) || limit < 0))) return 'Budget unavailable';
  const text = '$' + used.toFixed(2) + ' / ' + (limit === null ? 'Unlimited' : '$' + limit.toFixed(2));
  if (limit === null) return text;
  const percent = limit === 0 ? 100 : Math.max(0, used / limit * 100);
  const state = percent >= 100 ? 'danger' : percent >= 80 ? 'warn' : '';
  const status = percent >= 100 ? 'Limit reached' : percent >= 80 ? 'Approaching limit' : Math.round(percent) + '% used';
  return text + '<div class="spend-bar" aria-hidden="true"><div class="spend-bar-fill ' + state + '" style="width:' + Math.min(100, percent) + '%"></div></div><span class="metric-sub">' + status + '</span>';
}

function renderUsers() {
  const list = document.getElementById('user-list');
  list.replaceChildren();
  (cachedUsers || []).forEach(user => {
    const button = document.createElement('button');
    button.type = 'button';
    button.className = 'user-item' + (selectedUserId === user.user_id ? ' active' : '');
    button.setAttribute('aria-pressed', String(selectedUserId === user.user_id));
    const activeCount = keyCounts?.get(user.user_id) || 0;
    const count = keyCounts === null ? 'Keys unavailable' : activeCount === 1 ? '1 active key' : activeCount + ' active keys';
    button.innerHTML = '<span class="user-item-id">' + escapeHTML(user.user_id) + '</span><span class="user-item-email">' + escapeHTML(user.user_email || 'No email') + '</span><span class="user-item-meta" title="Unexpired, unblocked managed keys; quotas may still restrict usage">' + count + '</span><div>' + budgetMarkup(user.spend, user.max_budget) + '</div>';
    button.addEventListener('click', () => selectUser(user.user_id));
    list.append(button);
  });
  document.getElementById('all-keys').setAttribute('aria-pressed', String(selectedUserId === null));
  const user = (cachedUsers || []).find(user => user.user_id === selectedUserId);
  document.getElementById('access-title').textContent = user ? user.user_id : 'All API Keys';
  document.getElementById('access-email').textContent = user?.user_email || '';
  const summary = document.getElementById('user-summary');
  summary.replaceChildren();
  if (user) {
    const box = document.createElement('div');
    box.className = 'user-summary-box';
    box.innerHTML = '<div class="label">Spend / Budget</div>' + budgetMarkup(user.spend, user.max_budget);
    summary.append(box);
  }
  const actions = document.getElementById('user-actions');
  actions.replaceChildren();
  if (user) actionButton(actions, 'Delete User', true, button => deleteUser(user.user_id, button));
}

function selectUser(userId) {
  selectedUserId = userId;
  renderUsers();
  loadKeys();
}

async function loadUsers() {
  const load = ++usersLoad;
  const status = document.getElementById('users-status');
  status.textContent = 'Loading users...';
  try {
    const d = await api('/api/users');
    if (load !== usersLoad) return;
    if (!Array.isArray(d.users)) throw new Error('Invalid users response');
    cachedUsers = d.users;
    if (selectedUserId !== null && !cachedUsers.some(user => user.user_id === selectedUserId)) selectUser(null);
    renderUsers();
    status.textContent = cachedUsers.length ? '' : 'No users. Create a user to issue API keys.';
  } catch (err) {
    if (load === usersLoad) status.textContent = 'Unable to refresh users: ' + err.message;
  }
}

document.getElementById('user-form').addEventListener('submit', event => {
  event.preventDefault();
  submitCreateUser();
});

async function submitCreateUser() {
  const form = document.getElementById('user-form');
  const button = document.getElementById('user-submit');
  if (form.dataset.busy || !form.reportValidity()) return;
  const uid = document.getElementById('user-id').value.trim();
  const error = document.getElementById('user-error');
  if (!uid) { error.textContent = 'User ID is required'; return; }
  const email = document.getElementById('user-email').value.trim() || undefined;
  const budget = document.getElementById('user-budget').value || undefined;
  form.dataset.busy = 'true';
  button.disabled = true;
  error.textContent = '';
  try {
    await api('/api/users', {
      method: 'POST',
      headers: {'Content-Type': 'application/json'},
      body: JSON.stringify({user_id: uid, email, budget})
    });
    delete form.dataset.busy;
    closeModal('user-modal');
    showToast('Created user ' + uid);
    loadUsers();
  } catch (err) { error.textContent = err.message; }
  finally { delete form.dataset.busy; button.disabled = false; }
}

async function deleteUser(uid, button) {
  if (button.disabled || !confirm('Delete user ' + uid + ' and all their API keys?')) return;
  button.disabled = true;
  try {
    await api('/api/users/' + encodeURIComponent(uid), {method: 'DELETE'});
    showToast('Removed user and their API keys');
    if (selectedUserId === uid) selectedUserId = null;
    loadUsers();
    loadKeys();
  } catch (err) { alert(err.message); }
  finally { button.disabled = false; }
}

async function loadKeys() {
  const body = document.getElementById('keys-body');
  const load = ++keysLoad;
  const userId = selectedUserId;
  tableMessage(body, 7, 'Loading API keys...');
  try {
    const path = userId === null ? '/api/keys' : '/api/keys?user_id=' + encodeURIComponent(userId);
    const [d, all] = await Promise.all([api(path), userId !== null ? api('/api/keys') : Promise.resolve(null)]);
    if (load !== keysLoad) return;
    if (!Array.isArray(d.keys) || (all && !Array.isArray(all.keys))) throw new Error('Invalid keys response');
    const countKeys = userId === null ? d.keys : all?.keys;
    if (countKeys) {
      keyCounts = new Map();
      countKeys.forEach(key => {
        if (key.blocked || (key.expires && Date.parse(key.expires) <= Date.now())) return;
        keyCounts.set(key.user_id, (keyCounts.get(key.user_id) || 0) + 1);
      });
      renderUsers();
    }
    body.replaceChildren();
    document.getElementById('keys-count').textContent = d.keys.length === 1 ? '1 key' : d.keys.length + ' keys';
    if (!d.keys.length) tableMessage(body, 7, 'No API keys found');
    d.keys.forEach(k => {
      const models = Array.isArray(k.models) && k.models.length ? k.models.join(', ') : 'All models (including future models)';
      const actions = tableRow(body, [k.key_alias || '-', k.key_name || '-', k.user_id || '-', models, '', k.expires || 'never']);
      actions.parentElement.cells[4].innerHTML = budgetMarkup(k.spend, k.max_budget);
      actionButton(actions, 'Revoke', true, button => revokeKey(k.token, button));
      if (!k.token) actions.lastElementChild.disabled = true;
    });
  } catch (err) {
    if (load !== keysLoad) return;
    keyCounts = null;
    renderUsers();
    tableMessage(body, 7, 'Unable to load API keys: ' + err.message);
  }
}

document.getElementById('key-form').addEventListener('submit', event => {
  event.preventDefault();
  submitCreateKey();
});

async function submitCreateKey() {
  const form = document.getElementById('key-form');
  const button = document.getElementById('key-submit');
  if (button.disabled || form.dataset.busy || !form.reportValidity()) return;
  const uid = document.getElementById('key-user-id').value;
  const alias = document.getElementById('key-alias').value.trim() || undefined;
  const selected = document.getElementById('key-model-access').value === 'selected';
  const models = selected ? Array.from(document.querySelectorAll('#key-models input:checked'), checkbox => checkbox.value) : [];
  const error = document.getElementById('key-error');
  if (!uid) { error.textContent = 'Select a user.'; return; }
  if (selected && !models.length) { error.textContent = 'Select at least one model, or choose All models.'; return; }
  const spend = document.getElementById('key-spend').value || undefined;
  const duration = document.getElementById('key-duration').value.trim() || undefined;
  form.dataset.busy = 'true';
  button.disabled = true;
  error.textContent = '';
  try {
    const d = await api('/api/keys', {
      method: 'POST',
      headers: {'Content-Type': 'application/json'},
      body: JSON.stringify({user_id: uid, alias, models, spend, duration})
    });
    if (!d.key || typeof d.key.key !== 'string' || !d.key.key) throw new Error('Key created, but the API returned no secret. Revoke it and try again.');
    delete form.dataset.busy;
    closeModal('key-modal');
    document.getElementById('created-key-token').textContent = d.key.key;
    document.getElementById('copy-status').textContent = '';
    openDialog('key-result-modal');
    loadKeys();
  } catch (err) { error.textContent = err.message; }
  finally { delete form.dataset.busy; button.disabled = false; }
}

async function revokeKey(keyToken, button) {
  if (button.disabled || !confirm('Revoke API key?')) return;
  button.disabled = true;
  try {
    const d = await api('/api/keys/' + encodeURIComponent(keyToken), {method: 'DELETE'});
    showToast(d.message || 'API key revoked');
    loadKeys();
  } catch (err) { alert(err.message); }
  finally { button.disabled = false; }
}

async function copyKey() {
  const token = document.getElementById('created-key-token');
  const text = token.textContent;
  if (!text) return;
  try {
    if (!navigator.clipboard) throw new Error('Clipboard unavailable');
    await navigator.clipboard.writeText(text);
    if (token.textContent === text) document.getElementById('copy-status').textContent = 'Copied API key to clipboard';
  } catch (err) {
    if (token.textContent !== text) return;
    const range = document.createRange();
    range.selectNodeContents(token);
    const selection = window.getSelection();
    selection.removeAllRanges();
    selection.addRange(range);
    document.getElementById('copy-status').textContent = 'Automatic copy unavailable. Key selected; press Ctrl+C or use your browser’s Copy command.';
  }
}

setInterval(() => {
  if (currentTab === 'monitoring') loadMonitoring();
  if (currentTab === 'models') checkPullStatus();
}, 2500);

loadMonitoring();
</script>
</body>
</html>
"""


def main() -> None:
    parser = argparse.ArgumentParser(description="OKSA Web")
    parser.add_argument("--host", default="0.0.0.0", help="Listen host address (default: 0.0.0.0)")
    parser.add_argument("--port", type=int, default=8088, help="Listen port (default: 8088)")
    args = parser.parse_args()

    class ThreadedHTTPServer(socketserver.ThreadingMixIn, http.server.HTTPServer):
        daemon_threads = True

    server_address = (args.host, args.port)
    httpd = ThreadedHTTPServer(server_address, OksaWebHandler)
    print(f"OKSA Web service listening on http://{args.host}:{args.port}")
    try:
        httpd.serve_forever()
    except KeyboardInterrupt:
        print("\nShutting down OKSA Web service.")
        httpd.server_close()


if __name__ == "__main__":
    main()
