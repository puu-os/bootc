import argparse
import http.server
import json
import os
from pathlib import Path
import re
import socketserver
import subprocess
import sys
import threading
import time
import urllib.parse

libexec_dir = Path("/usr/libexec/puu")
for directory in (Path(__file__).resolve().parent, libexec_dir):
    if directory.is_dir() and str(directory) not in sys.path:
        sys.path.insert(0, str(directory))
import oksa_model_serving as ms
import oksa_model_removal as removal
import oksa_settings as settings

state_dir = Path(os.environ.get("PUU_VLLM_STATE_DIR", "/var/lib/puu/vllm"))


resolve_helper = ms.resolve_helper
discover_bin = resolve_helper("oksa-discover-vllm-models")
planner_bin = resolve_helper("oksa-plan-vllm-workloads")
preseed_bin = resolve_helper("oksa-preseed-vllm-models")

pull_lock = threading.Lock()
control_lock = threading.Lock()
pull_state = {
    "running": False,
    "repo_id": None,
    "model_name": None,
    "progress": "",
    "error": None,
    "complete": False,
    "started_at": 0,
    "ended_at": 0,
}


def control_files() -> tuple[Path, Path]:
    return ms.control_files(state_dir)


def run_discover() -> None:
    ms.run_discover(discover_bin)


def check_capabilities(model_name: str) -> bool:
    return ms.check_capabilities(planner_bin, model_name)


def collect_models_list() -> dict:
    return ms.collect_models_list(state_dir, discover_bin, planner_bin)

def background_pull_worker(repo_id: str, name: str | None, revision: str, force: bool) -> None:
    global pull_state

    cmd = [str(preseed_bin), "--repo-id", repo_id, "--revision", revision]
    if name:
        cmd.extend(["--name", name])
    if force:
        cmd.append("--force")

    try:
        proc = subprocess.Popen(
            cmd,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            text=True,
            bufsize=1,
        )
        output_lines = []
        if proc.stdout:
            for line in iter(proc.stdout.readline, ""):
                output_lines.append(line.strip())
                if len(output_lines) > 20:
                    output_lines.pop(0)
                with pull_lock:
                    pull_state["progress"] = line.strip()
            proc.stdout.close()
        proc.wait()

        with pull_lock:
            pull_state["running"] = False
            pull_state["ended_at"] = time.time()
            if proc.returncode == 0:
                pull_state["complete"] = True
                pull_state["progress"] = "Model download completed successfully."
            else:
                pull_state["complete"] = False
                pull_state["error"] = f"Download process exited with code {proc.returncode}"
    except Exception as exc:
        with pull_lock:
            pull_state["running"] = False
            pull_state["ended_at"] = time.time()
            pull_state["error"] = str(exc)

    run_discover()


class OksaWebHandler(http.server.BaseHTTPRequestHandler):
    server_version = "OKSAWeb/1.0"

    def send_json(self, status: int, data: dict) -> None:
        payload = json.dumps(data).encode("utf-8")
        self.send_response(status)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(payload)))
        self.send_header("Cache-Control", "no-cache, no-store, must-revalidate")
        self.send_header("Access-Control-Allow-Origin", "*")
        self.send_header("Access-Control-Allow-Methods", "GET, POST, DELETE, OPTIONS")
        self.send_header("Access-Control-Allow-Headers", "Content-Type, Authorization")
        self.end_headers()
        self.wfile.write(payload)

    def read_json_body(self) -> dict | None:
        try:
            content_length = int(self.headers.get("Content-Length", 0))
            if content_length <= 0:
                return {}
            if content_length > 1024 * 1024:
                return None
            raw_data = self.rfile.read(content_length).decode("utf-8")
            body = json.loads(raw_data)
            return body if isinstance(body, dict) else None
        except Exception:
            return None

    def do_OPTIONS(self) -> None:
        self.send_response(204)
        self.send_header("Access-Control-Allow-Origin", "*")
        self.send_header("Access-Control-Allow-Methods", "GET, POST, DELETE, OPTIONS")
        self.send_header("Access-Control-Allow-Headers", "Content-Type, Authorization")
        self.end_headers()

    def do_GET(self) -> None:
        parsed = urllib.parse.urlparse(self.path)
        path = parsed.path
        query = urllib.parse.parse_qs(parsed.query)

        if path in ("/", "/index.html"):
            payload = HTML_PAGE.encode("utf-8")
            self.send_response(200)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.send_header("Content-Length", str(len(payload)))
            self.end_headers()
            self.wfile.write(payload)
            return

        if path == "/api/status":
            status_data = ms.collect_serving_status()
            self.send_json(200, {"ok": True, "status": status_data})
            return

        if path == "/api/users":
            ok, users = ms.litellm_user_list()
            self.send_json(200 if ok else 500, {
                "ok": ok,
                "users": users if ok else [],
                "error": None if ok else str(users)
            })
            return

        if path.startswith("/api/users/"):
            user_id = urllib.parse.unquote(path[len("/api/users/"):])
            ok, user_info = ms.litellm_user_info(user_id)
            self.send_json(200 if ok else 404, {
                "ok": ok,
                "user": user_info if ok else None,
                "error": None if ok else str(user_info)
            })
            return

        if path == "/api/keys":
            user_id = query.get("user_id", [None])[0]
            ok, keys = ms.litellm_key_list(user_id=user_id)
            self.send_json(200 if ok else 500, {
                "ok": ok,
                "keys": keys if ok else [],
                "error": None if ok else str(keys)
            })
            return

        if path == "/api/models":
            self.send_json(200, collect_models_list())
            return

        if path == "/api/models/pull/status":
            with pull_lock:
                state_copy = dict(pull_state)
            self.send_json(200, {"ok": True, "pull": state_copy})
            return

        if path == "/api/settings":
            contact = settings.stored_contact()
            self.send_json(200, {
                "ok": True,
                "settings": {settings.CONTACT_KEY: contact},
                "effective_user_agent": settings.render_user_agent(contact),
                "manifest_applied": settings.user_agent_manifest().is_file(),
            })
            return

        self.send_json(404, {"ok": False, "error": "Not Found"})

    def do_POST(self) -> None:
        parsed = urllib.parse.urlparse(self.path)
        path = parsed.path
        body = self.read_json_body()
        if body is None:
            self.send_json(400, {"ok": False, "error": "Invalid JSON body"})
            return

        if path == "/api/users":
            user_id = body.get("user_id")
            if not user_id:
                self.send_json(400, {"ok": False, "error": "user_id is required"})
                return
            email = body.get("email")
            budget = body.get("budget")
            if budget is not None:
                try:
                    budget = float(budget)
                except (TypeError, ValueError, OverflowError):
                    self.send_json(400, {"ok": False, "error": "budget must be a number"})
                    return
            ok, res = ms.litellm_user_create(user_id, email=email, max_budget=budget)
            self.send_json(200 if ok else 400, {
                "ok": ok,
                "result": res if ok else None,
                "error": None if ok else str(res)
            })
            return

        if path == "/api/keys":
            user_id = body.get("user_id")
            if not user_id:
                self.send_json(400, {"ok": False, "error": "user_id is required"})
                return
            alias = body.get("alias")
            if not isinstance(alias, str) or not alias.strip():
                self.send_json(400, {"ok": False, "error": "alias is required"})
                return
            alias = alias.strip()
            models = body.get("models")
            if isinstance(models, str):
                models = [m.strip() for m in models.split(",") if m.strip()]
            spend = body.get("spend")
            if spend is not None:
                try:
                    spend = float(spend)
                except (TypeError, ValueError, OverflowError):
                    self.send_json(400, {"ok": False, "error": "spend must be a number"})
                    return
            duration = body.get("duration")
            ok, res = ms.litellm_key_create(
                user_id,
                alias=alias,
                models=models,
                max_budget=spend,
                duration=duration,
            )
            self.send_json(200 if ok else 400, {
                "ok": ok,
                "key": res if ok else None,
                "error": None if ok else str(res)
            })
            return

        if path == "/api/models/inspect":
            repo_id = body.get("repo_id")
            revision = body.get("revision", "main")
            if not isinstance(repo_id, str) or not repo_id.strip() or not isinstance(revision, str) or not revision.strip():
                self.send_json(400, {"ok": False, "error": "Repository and revision must be non-empty strings"})
                return
            meta = ms.inspect_hf_model(repo_id, revision)
            if not meta:
                self.send_json(404, {"ok": False, "error": f"Failed to fetch metadata for {repo_id}"})
                return
            mem_mib = meta.get("estimated_memory_mib", 0)
            fits, reason = ms.check_model_capacity(mem_mib)
            self.send_json(200, {
                "ok": True,
                "metadata": meta,
                "fits": fits,
                "reason": reason
            })
            return

        if path == "/api/models/pull":
            repo_id = body.get("repo_id")
            if not repo_id:
                self.send_json(400, {"ok": False, "error": "repo_id is required"})
                return
            name = body.get("name")
            if not isinstance(repo_id, str) or (name is not None and not isinstance(name, str)):
                self.send_json(400, {"ok": False, "error": "Invalid repository or model name"})
                return
            effective_name = re.sub(r"[^a-z0-9._-]+", "-", (name or repo_id.rsplit("/", 1)[-1]).lower()).strip("-")
            if ms.is_calibration_model(repo_id) or ms.is_calibration_model(effective_name):
                self.send_json(403, {"ok": False, "error": "The calibration model is installed automatically"})
                return
            revision = body.get("revision")
            force = body.get("force", False)
            if not isinstance(revision, str) or not re.fullmatch(r"[0-9a-fA-F]{40}", revision) or type(force) is not bool:
                self.send_json(400, {"ok": False, "error": "Download requires an inspected commit revision and a Boolean override"})
                return

            with pull_lock:
                if pull_state["running"]:
                    self.send_json(409, {"ok": False, "error": "Another model download is currently running"})
                    return
                pull_state.update(running=True, repo_id=repo_id, model_name=name, progress="Starting download...",
                                  error=None, complete=False, started_at=time.time(), ended_at=0)

            try:
                thread = threading.Thread(
                    target=background_pull_worker,
                    args=(repo_id, name, revision, force),
                    daemon=True,
                )
                thread.start()
            except RuntimeError as exc:
                with pull_lock:
                    pull_state.update(running=False, error=str(exc), ended_at=time.time())
                self.send_json(503, {"ok": False, "error": "Could not start download worker; retry Download"})
                return
            self.send_json(200, {"ok": True, "message": f"Download started for {repo_id}"})
            return

        if path == "/api/models/start":
            model_name = body.get("name")
            if not model_name:
                self.send_json(400, {"ok": False, "error": "name is required"})
                return
            try:
                model_name = ms.resolve_model_name(model_name, state_dir)
            except ValueError as exc:
                self.send_json(400, {"ok": False, "error": str(exc)})
                return
            if not check_capabilities(model_name):
                self.send_json(400, {"ok": False, "error": "Model has insufficient host capabilities"})
                return
            with control_lock:
                state_dir.mkdir(parents=True, exist_ok=True)
                selected_model_file, serving_disabled_file = control_files()
                ms.atomic_write_text(selected_model_file, f"{model_name}\n")
                serving_disabled_file.unlink(missing_ok=True)
                env = dict(os.environ, PUU_VLLM_SELECTED_MODEL=model_name, PUU_VLLM_REQUIRE_SELECTED_MODEL="true")
                res = subprocess.run([str(planner_bin)], env=env, capture_output=True)
            if res.returncode != 0:
                self.send_json(500, {"ok": False, "error": "Failed to activate model workload"})
                return
            self.send_json(200, {"ok": True, "message": f"Model {ms.public_model_name(model_name, state_dir)} activated"})
            return

        if path == "/api/models/stop":
            with control_lock:
                state_dir.mkdir(parents=True, exist_ok=True)
                selected_model_file, serving_disabled_file = control_files()
                selected_model_file.unlink(missing_ok=True)
                ms.atomic_write_text(serving_disabled_file, "")
                res = subprocess.run([str(planner_bin)], capture_output=True)
            if res.returncode != 0:
                self.send_json(500, {"ok": False, "error": "Failed to stop model workload"})
                return
            self.send_json(200, {"ok": True, "message": "Model serving stopped"})
            return

        if path == "/api/settings":
            raw_contact = body.get(settings.CONTACT_KEY, "")
            if not isinstance(raw_contact, str):
                self.send_json(400, {"ok": False, "error": "Contact must be a string"})
                return
            try:
                contact = settings.validate_contact(raw_contact)
            except ValueError as exc:
                self.send_json(400, {"ok": False, "error": str(exc)})
                return
            store = settings.load()
            if contact:
                store[settings.CONTACT_KEY] = contact
            else:
                store.pop(settings.CONTACT_KEY, None)
            try:
                settings.save(store)
            except OSError as exc:
                self.send_json(500, {"ok": False, "error": f"Failed to store settings: {exc}"})
                return
            applied = settings.apply_user_agent(contact)
            self.send_json(200, {
                "ok": True,
                "settings": {settings.CONTACT_KEY: contact},
                "effective_user_agent": settings.render_user_agent(contact),
                "applied": applied,
            })
            return

        self.send_json(404, {"ok": False, "error": "Not Found"})

    def do_DELETE(self) -> None:
        parsed = urllib.parse.urlparse(self.path)
        path = parsed.path

        if path.startswith("/api/users/"):
            user_id = urllib.parse.unquote(path[len("/api/users/"):])
            ok, res = ms.litellm_user_delete(user_id)
            self.send_json(200 if ok else 400, {
                "ok": ok,
                "message": res if ok else None,
                "error": None if ok else str(res)
            })
            return

        if path.startswith("/api/keys/"):
            key_or_alias = urllib.parse.unquote(path[len("/api/keys/"):])
            ok, res = ms.litellm_key_delete(key_or_alias)
            self.send_json(200 if ok else 400, {
                "ok": ok,
                "message": res if ok else None,
                "error": None if ok else str(res)
            })
            return

        if path.startswith("/api/models/"):
            model_name = urllib.parse.unquote(path[len("/api/models/"):])
            with control_lock:
                result = removal.ModelRemovalService(state_dir, discover_bin, planner_bin).remove(model_name)
            if result.deleted:
                data: dict[str, bool | str] = {"ok": True, "deleted": True, "reconciled": result.reconciled}
                data["message" if result.reconciled else "warning"] = result.message
                self.send_json(200, data)
            else:
                status = {
                    removal.RemovalOutcome.PROTECTED: 403,
                    removal.RemovalOutcome.INVALID: 400,
                    removal.RemovalOutcome.BUSY: 409,
                    removal.RemovalOutcome.NOT_STOPPED: 409,
                    removal.RemovalOutcome.SHUTDOWN_FAILED: 503,
                    removal.RemovalOutcome.REMOVAL_FAILED: 500,
                }[result.outcome]
                data = {"ok": False, "error": result.message}
                if result.outcome not in (removal.RemovalOutcome.PROTECTED, removal.RemovalOutcome.INVALID):
                    data["deleted"] = False
                self.send_json(status, data)
            return

        self.send_json(404, {"ok": False, "error": "Not Found"})


