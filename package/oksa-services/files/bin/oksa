import argparse
import os
import json
import math
from pathlib import Path
import re
import subprocess
import sys
import time

libexec_dir = Path("/usr/libexec/puu")
for directory in (Path(__file__).resolve().parent, libexec_dir):
    if directory.is_dir() and str(directory) not in sys.path:
        sys.path.insert(0, str(directory))
import oksa_model_serving as ms
import oksa_model_removal as removal
import oksa_user_deletion as user_deletion


def die(msg: str) -> None:
    sys.exit(f"error: {msg}")


resolve_helper = ms.resolve_helper
control_files = ms.control_files
run_discover = ms.run_discover
check_capabilities = ms.check_capabilities


def cmd_list(state_dir: Path, discover_bin: Path, planner_bin: Path) -> None:
    data = ms.collect_models_list(state_dir, discover_bin, planner_bin)
    print(f"{'NAME':<40} {'CAPABILITIES':<12} ACTIVE")
    for m in data["models"]:
        act = "*" if m["active"] else ""
        print(f"{m['name']:<40} {m['capabilities']:<12} {act}")

def cmd_start(state_dir: Path, discover_bin: Path, planner_bin: Path, model_name: str) -> None:
    run_discover(discover_bin)
    try:
        model_name = ms.resolve_model_name(model_name, state_dir)
    except ValueError as exc:
        die(str(exc))

    if not check_capabilities(planner_bin, model_name):
        die("insufficient capabilities")

    state_dir.mkdir(parents=True, exist_ok=True)
    selected_model_file, serving_disabled_file = control_files(state_dir)

    ms.atomic_write_text(selected_model_file, f"{model_name}\n")
    serving_disabled_file.unlink(missing_ok=True)

    env = dict(os.environ, PUU_VLLM_SELECTED_MODEL=model_name, PUU_VLLM_REQUIRE_SELECTED_MODEL="true")
    res = subprocess.run([str(planner_bin)], env=env, capture_output=True)
    if res.returncode != 0:
        die("insufficient capabilities")


def cmd_stop(state_dir: Path, planner_bin: Path) -> None:
    state_dir.mkdir(parents=True, exist_ok=True)
    selected_model_file, serving_disabled_file = control_files(state_dir)

    selected_model_file.unlink(missing_ok=True)
    ms.atomic_write_text(serving_disabled_file, "")

    res = subprocess.run([str(planner_bin)], capture_output=True)
    if res.returncode != 0:
        die("stop failed")


def cmd_model_list(state_dir: Path, discover_bin: Path, planner_bin: Path) -> None:
    data = ms.collect_models_list(state_dir, discover_bin, planner_bin)
    print(f"{'NAME':<40} {'STORAGE_ID':<24} {'SIZE':<10} {'QUANT':<12} {'CAPABILITIES':<14} ACTIVE")
    for m in data["models"]:
        size_str = f"{m['storage_mib']} MiB" if m.get("storage_mib") else "-"
        quant = m.get("quantization") or "none"
        act = "*" if m["active"] else ""
        print(f"{m['name']:<40} {m['id']:<24} {size_str:<10} {quant:<12} {m['capabilities']:<14} {act}")

def cmd_model_add(
    preseed_bin: Path,
    discover_bin: Path,
    repo_id: str,
    name: str | None = None,
    revision: str = "main",
    force: bool = False,
) -> None:
    if os.geteuid() != 0:
        die("oksa model add requires root privileges")
    effective_name = re.sub(r"[^a-z0-9._-]+", "-", (name or repo_id.rsplit("/", 1)[-1]).lower()).strip("-")
    if ms.is_calibration_model(repo_id) or ms.is_calibration_model(effective_name):
        die("The preset model is installed automatically")
    if not preseed_bin.is_file() or not os.access(preseed_bin, os.X_OK):
        die(f"preseed helper not found: {preseed_bin}")
    cmd = [str(preseed_bin), "--repo-id", repo_id, "--revision", revision]
    if name:
        cmd.extend(["--name", name])
    if force:
        cmd.append("--force")
    res = subprocess.run(cmd)
    if res.returncode != 0:
        die("model download/add failed")
    run_discover(discover_bin)


def cmd_model_remove(
    state_dir: Path,
    discover_bin: Path,
    planner_bin: Path,
    model_name: str,
) -> None:
    if os.geteuid() != 0:
        die("oksa model remove requires root privileges")
    result = removal.ModelRemovalService(state_dir, discover_bin, planner_bin).remove(model_name)
    if result.outcome is not removal.RemovalOutcome.REMOVED:
        die(result.message)
    print(f"Removed model {result.public_name}")


def cmd_model_inspect(repo_id: str, revision: str = "main") -> None:
    print(f"Inspecting Hugging Face repository {repo_id} ({revision})...")
    meta = ms.inspect_hf_model(repo_id, revision)
    if not meta:
        die(f"failed to fetch metadata for {repo_id}")
    arch = ", ".join(meta["architectures"]) if meta["architectures"] else "unknown"
    dtype = meta["torch_dtype"] or "unknown"
    quant = meta["quantization"] or "none"
    storage = meta["storage_mib"]
    mem = meta["estimated_memory_mib"]
    context = meta["max_context"]
    files_count = len(meta["files"])
    gated = "yes" if meta["gated"] else "no"

    print(f"Model:                {meta['repo_id']}")
    print(f"Repository:           {repo_id}")
    print(f"Revision:             {revision}")
    print(f"Architecture:         {arch}")
    print(f"Torch Dtype:          {dtype}")
    print(f"Quantization:         {quant}")
    print(f"Max Context:          {context}")
    print(f"Total Weight Files:   {files_count}")
    print(f"Storage Required:     ~{storage} MiB")
    print(f"Estimated RAM/VRAM:   ~{mem} MiB")
    print(f"Gated:                {gated}")

    fits, reason = ms.check_model_capacity(mem)
    print(f"Capacity Assessment:  {'COMPATIBLE' if fits else 'INSUFFICIENT'}")
    print(f"Details:              {reason}")
    if not fits:
        print("Note:                 Can still be run via multi-node QSFP clustering with --force.")


def cmd_pull(preseed_bin: Path, discover_bin: Path, model_name: str, force: bool = False) -> None:
    if os.geteuid() != 0:
        die("oksa pull requires root privileges")
    if not preseed_bin.is_file() or not os.access(preseed_bin, os.X_OK):
        die(f"preseed helper not found: {preseed_bin}")
    cmd = [str(preseed_bin)]
    if force:
        cmd.append("--force")
    cmd.append(model_name)
    res = subprocess.run(cmd)
    if res.returncode != 0:
        die("pull failed")
    run_discover(discover_bin)



def check_admin_privileges() -> None:
    if os.geteuid() != 0 and not os.environ.get("PUU_LITELLM_MASTER_KEY"):
        die("operation requires root privileges or PUU_LITELLM_MASTER_KEY")


def cmd_user_list() -> None:
    ok, users = ms.litellm_user_list()
    if not ok:
        die(f"failed to retrieve users: {users}")
    if not users:
        print("No AI users found.")
        return
    print(f"{'USER ID':<24} {'EMAIL':<30} {'SPEND':<12} {'BUDGET':<12}")
    for u in users:
        uid = str(u.get("user_id", "-"))
        email = str(u.get("user_email") or "-")
        spend = f"${u.get('spend', 0):.2f}" if "spend" in u else "-"
        budget = f"${u.get('max_budget'):.2f}" if u.get("max_budget") is not None else "unlimited"
        print(f"{uid:<24} {email:<30} {spend:<12} {budget:<12}")


def cmd_user_create(user_id: str, email: str | None = None, budget: float | None = None) -> None:
    check_admin_privileges()
    ok, res = ms.litellm_user_create(user_id, email=email, max_budget=budget)
    if not ok:
        die(f"failed to create user: {res}")
    print(f"Created AI user {user_id}")


def cmd_user_delete(user_id: str) -> None:
    check_admin_privileges()
    result = user_deletion.UserDeletionService().delete(user_id)
    if result.deleted is not True:
        die(result.message)
    print(result.message)


def cmd_user_info(user_id: str) -> None:
    ok, res = ms.litellm_user_info(user_id)
    if not ok:
        die(f"failed to get user info: {res}")
    info = res.get("user_info") if isinstance(res, dict) and "user_info" in res else res
    uid = info.get("user_id", user_id)
    email = info.get("user_email") or "-"
    spend = f"${info.get('spend', 0):.2f}" if "spend" in info else "-"
    budget = f"${info.get('max_budget'):.2f}" if info.get("max_budget") is not None else "unlimited"
    keys = res.get("keys", [])
    print(f"User:     {uid}")
    print(f"Email:    {email}")
    print(f"Spend:    {spend}")
    print(f"Budget:   {budget}")
    print(f"Keys:     {len(keys)} active")
    if keys:
        print(f"  {'ID':<14} {'ALIAS':<20} {'KEY':<24} {'SPEND':<10} {'EXPIRES'}")
        for k in keys:
            if isinstance(k, dict):
                kid = str(k.get("token") or "")[:12] or "-"
                alias = k.get("key_alias") or "-"
                token = k.get("key_name") or "-"
                kspend = f"${k.get('spend', 0):.2f}" if "spend" in k else "-"
                exp = k.get("expires") or "never"
                print(f"  {kid:<14} {alias:<20} {token:<24} {kspend:<10} {exp}")


def cmd_key_create(
    user_id: str,
    alias: str | None = None,
    models: str | None = None,
    spend: float | None = None,
    duration: str | None = None,
) -> None:
    check_admin_privileges()
    models_list = [m.strip() for m in models.split(",") if m.strip()] if models else None
    ok, res = ms.litellm_key_create(
        user_id,
        alias=alias,
        models=models_list,
        max_budget=spend,
        duration=duration,
    )
    if not ok:
        die(f"failed to generate key: {res}")
    key = res.get("key", "")
    key_alias = res.get("key_alias") or alias or "-"
    exp = res.get("expires") or (f"in {duration}" if duration else "never")
    print("API Key generated successfully:")
    print(f"  Key:        {key}")
    print(f"  User:       {user_id}")
    print(f"  Alias:      {key_alias}")
    print(f"  Models:     {', '.join(models_list) if models_list else 'all'}")
    print(f"  Budget:     {f'${spend:.2f}' if spend is not None else 'unlimited'}")
    print(f"  Expires:    {exp}")


def cmd_key_list(user_id: str | None = None) -> None:
    ok, keys = ms.litellm_key_list(user_id=user_id)
    if not ok:
        die(f"failed to retrieve keys: {keys}")
    if not keys:
        print("No API keys found.")
        return
    print(f"{'ID':<14} {'ALIAS':<20} {'KEY PREFIX':<18} {'USER':<18} {'MODELS':<20} {'SPEND':<10} {'BUDGET':<10} EXPIRES")
    for k in keys:
        kid = str(k.get("token") or "")[:12] or "-"
        alias = k.get("key_alias") or "-"
        token_prefix = k.get("key_name") or "-"
        uid = k.get("user_id") or "-"
        raw_models = k.get("models")
        models_str = ", ".join(raw_models) if isinstance(raw_models, list) and raw_models else "all"
        if len(models_str) > 18:
            models_str = models_str[:15] + "..."
        spend = f"${k.get('spend', 0):.2f}" if "spend" in k else "-"
        budget = f"${k.get('max_budget'):.2f}" if k.get("max_budget") is not None else "unlimited"
        exp = k.get("expires") or "never"
        print(f"{kid:<14} {alias:<20} {token_prefix:<18} {uid:<18} {models_str:<20} {spend:<10} {budget:<10} {exp}")


def cmd_key_revoke(key_or_alias: str) -> None:
    check_admin_privileges()
    ok, res = ms.litellm_key_delete(key_or_alias)
    if not ok:
        die(f"failed to revoke key: {res}")
    print(res)



def format_status_text(data: dict) -> str:
    def reading(value, format_spec: str = "", unit: str = "") -> str:
        if type(value) not in (int, float) or not math.isfinite(value) or value < 0:
            return "Unavailable"
        return f"{value:{format_spec}}{unit}"
    lines = []
    lines.append("=== Puu OS Model Serving Status ===")
    serving_str = "ENABLED" if data.get("serving_enabled") else "DISABLED"
    selected = data.get("selected_model", "-")
    active = data.get("active_model", "-")
    gateway = data.get("gateway_status", "unknown")
    lines.append(f"Serving:      {serving_str}")
    lines.append(f"Active Model: {active}")
    lines.append(f"Selected:     {selected}")
    lines.append(f"Model health: {data.get('model_status', 'unavailable')}")
    lines.append(f"Gateway:      {gateway}")
    lines.append("")

    mem = data.get("host_memory", {})
    if mem:
        lines.append(f"Host Memory:  {reading(mem.get('used_mib'))} / {reading(mem.get('total_mib'))} MiB ({reading(mem.get('used_pct'), unit='% used')})")
    else:
        lines.append("Host Memory:  Unavailable")

    gpus = data.get("gpus")
    if gpus is None:
        lines.append("Accelerators: Unavailable")
    elif gpus:
        lines.append("")
        lines.append("Accelerators:")
        lines.append(f"  {'GPU':<5} {'NAME':<24} {'UTIL':<8} {'VRAM USED':<16} {'TEMP':<8} POWER")
        for g in gpus:
            vram_str = f"{reading(g.get('memory_used_mib'), '.0f')} / {reading(g.get('memory_total_mib'), '.0f')} MiB"
            lines.append(
                f"  [{reading(g.get('index'))}]  {g.get('name', 'Unavailable')[:22]:<24} "
                f"{reading(g.get('gpu_util_pct'), '.0f', '%'):<8} "
                f"{vram_str:<16} "
                f"{reading(g.get('temperature_c'), '.0f', '°C'):<8} "
                f"{reading(g.get('power_w'), '.1f', 'W')}"
            )

    workloads = data.get("workloads")
    if workloads is None:
        lines.append("Cluster Workloads: Unavailable")
    elif workloads:
        lines.append("")
        lines.append("Cluster Workloads:")
        lines.append(f"  {'NAME':<36} {'STATUS':<12} {'READY':<8} RESTARTS")
        for w in workloads:
            ready_str = "unavailable" if w.get("ready") is None else "yes" if w["ready"] else "no"
            lines.append(f"  {w.get('name', '-')[:34]:<36} {w.get('phase', '-'):<12} {ready_str:<8} {reading(w.get('restarts'))}")

    metrics = data.get("metrics") or {}
    lines.append("")
    lines.append("Inference Telemetry:")
    lines.append(f"  Running Requests:  {reading(metrics.get('running_requests'))}")
    lines.append(f"  Waiting Requests:  {reading(metrics.get('waiting_requests'))}")
    lines.append(f"  KV Cache Usage:    {reading(metrics.get('kv_cache_usage_pct'), unit='%')}")
    if "swapped_requests" in metrics:
        lines.append(f"  Swapped Requests:  {reading(metrics.get('swapped_requests'))}")

    return "\n".join(lines)


def cmd_status(as_json: bool = False) -> None:
    data = ms.collect_serving_status()
    if as_json:
        print(json.dumps(data, indent=2))
    else:
        print(format_status_text(data))


def cmd_monitor(interval_sec: float = 2.0) -> None:
    try:
        while True:
            data = ms.collect_serving_status()
            now_str = time.strftime("%Y-%m-%d %H:%M:%S")
            output = f"\033[H\033[2J[{now_str}] (Press Ctrl+C to exit)\n\n" + format_status_text(data) + "\n"
            sys.stdout.write(output)
            sys.stdout.flush()
            time.sleep(interval_sec)
    except KeyboardInterrupt:
        print("\nMonitoring stopped.")

def main() -> None:
    state_dir = ms.STATE_DIR
    discover_bin = resolve_helper("oksa-discover-vllm-models")
    planner_bin = resolve_helper("oksa-plan-vllm-workloads")
    preseed_bin = resolve_helper("oksa-preseed-vllm-models")

    parser = argparse.ArgumentParser(prog="oksa", description="Puu OS model serving control")
    subparsers = parser.add_subparsers(dest="command", required=True)

    subparsers.add_parser("list", help="List available models")
    start_parser = subparsers.add_parser("start", help="Start a model")
    start_parser.add_argument("name", help="Model name")
    subparsers.add_parser("stop", help="Stop model serving")

    status_parser = subparsers.add_parser("status", help="Show model serving and workload status")
    status_parser.add_argument("--json", action="store_true", help="Output status as JSON")
    monitor_parser = subparsers.add_parser("monitor", help="Continuously monitor running model tasks")
    monitor_parser.add_argument("--interval", type=float, default=2.0, help="Refresh interval in seconds (default: 2.0)")
    pull_parser = subparsers.add_parser("pull", help="Download a model from the catalog or Hugging Face")
    pull_parser.add_argument("name", help="Model name or repository ID")
    pull_parser.add_argument("--force", action="store_true", help="Download even if exceeding host capacity (for QSFP clustering)")

    model_parser = subparsers.add_parser("model", help="Manage Hugging Face models")
    model_sub = model_parser.add_subparsers(dest="model_command", required=True)

    model_sub.add_parser("list", help="List downloaded models with details")

    add_parser = model_sub.add_parser("add", help="Add/download a model from Hugging Face")
    add_parser.add_argument("repo_id", help="Hugging Face repo ID (e.g. org/model)")
    add_parser.add_argument("--name", help="Custom storage ID")
    add_parser.add_argument("--revision", default="main", help="Git revision (default: main)")
    add_parser.add_argument("--force", action="store_true", help="Download even if exceeding host capacity (for QSFP clustering)")

    remove_parser = model_sub.add_parser("remove", help="Remove a downloaded model")
    remove_parser.add_argument("name", help="Model name to remove")

    inspect_parser = model_sub.add_parser("inspect", help="Inspect a Hugging Face model without downloading")
    inspect_parser.add_argument("repo_id", help="Hugging Face repo ID (e.g. org/model)")
    inspect_parser.add_argument("--revision", default="main", help="Git revision (default: main)")


    user_parser = subparsers.add_parser("user", help="Manage AI users")
    user_sub = user_parser.add_subparsers(dest="user_command", required=True)
    user_sub.add_parser("list", help="List AI users")
    ucreate = user_sub.add_parser("create", help="Create an AI user")
    ucreate.add_argument("user_id", help="User identifier")
    ucreate.add_argument("--email", help="User email address")
    ucreate.add_argument("--budget", type=float, help="Maximum spend budget in USD")
    udelete = user_sub.add_parser("delete", help="Delete an AI user")
    udelete.add_argument("user_id", help="User identifier")
    uinfo = user_sub.add_parser("info", help="Show user details and keys")
    uinfo.add_argument("user_id", help="User identifier")

    key_parser = subparsers.add_parser("key", help="Manage AI API keys")
    key_sub = key_parser.add_subparsers(dest="key_command", required=True)
    klist = key_sub.add_parser("list", help="List active AI keys")
    klist.add_argument("user_id", nargs="?", help="Optional user ID to filter keys")
    kcreate = key_sub.add_parser("create", help="Generate a new AI API key")
    kcreate.add_argument("user_id", help="User to assign key to")
    kcreate.add_argument("--name", help="Key alias/name")
    kcreate.add_argument("--models", help="Comma-separated list of allowed models")
    kcreate.add_argument("--spend", type=float, help="Max budget in USD")
    kcreate.add_argument("--duration", help="Validity duration (e.g. 30d, 24h)")
    krevoke = key_sub.add_parser("revoke", help="Revoke an AI key")
    krevoke.add_argument("key", help="Key token or alias to revoke")

    web_parser = subparsers.add_parser("web", help="Start the Oksa web management dashboard")
    web_parser.add_argument("--host", default="0.0.0.0", help="Listen host address (default: 0.0.0.0)")
    web_parser.add_argument("--port", type=int, default=8088, help="Listen port (default: 8088)")

    args = parser.parse_args()

    if args.command == "list":
        cmd_list(state_dir, discover_bin, planner_bin)
    elif args.command == "start":
        cmd_start(state_dir, discover_bin, planner_bin, args.name)
    elif args.command == "stop":
        cmd_stop(state_dir, planner_bin)

    elif args.command == "status":
        cmd_status(as_json=args.json)
    elif args.command == "monitor":
        cmd_monitor(interval_sec=args.interval)
    elif args.command == "pull":
        cmd_pull(preseed_bin, discover_bin, args.name, force=args.force)
    elif args.command == "model":
        if args.model_command == "list":
            cmd_model_list(state_dir, discover_bin, planner_bin)
        elif args.model_command == "add":
            cmd_model_add(preseed_bin, discover_bin, args.repo_id, name=args.name, revision=args.revision, force=args.force)
        elif args.model_command == "remove":
            cmd_model_remove(state_dir, discover_bin, planner_bin, args.name)
        elif args.model_command == "inspect":
            cmd_model_inspect(args.repo_id, revision=args.revision)

    elif args.command == "user":
        if args.user_command == "list":
            cmd_user_list()
        elif args.user_command == "create":
            cmd_user_create(args.user_id, email=args.email, budget=args.budget)
        elif args.user_command == "delete":
            cmd_user_delete(args.user_id)
        elif args.user_command == "info":
            cmd_user_info(args.user_id)
    elif args.command == "key":
        if args.key_command == "list":
            cmd_key_list(user_id=args.user_id)
        elif args.key_command == "create":
            cmd_key_create(args.user_id, alias=args.name, models=args.models, spend=args.spend, duration=args.duration)
        elif args.key_command == "revoke":
            cmd_key_revoke(args.key)

    elif args.command == "web":
        web_bin = resolve_helper("oksa-web")
        if not web_bin.is_file() or not os.access(web_bin, os.X_OK):
            die(f"web helper not found: {web_bin}")
        os.execv(str(web_bin), [str(web_bin), "--host", args.host, "--port", str(args.port)])
if __name__ == "__main__":
    main()
