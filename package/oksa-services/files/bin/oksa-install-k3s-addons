from pathlib import Path
import hashlib
import ipaddress
import json
import os
import secrets
import subprocess
import sys
import time
import urllib.error
import urllib.request

sys.path.insert(0, str(Path(__file__).resolve().parent))
import oksa_model_serving as ms


NVIDIA_MANIFESTS = ("30-nvidia-cdi-runtime.yaml", "32-nvidia-device-plugin.yaml")

OKSA_NAMESPACE = "oksa"
LITELLM_SERVICE = "litellm"
LITELLM_PORT = 4000
LITELLM_TIMEOUT_SEC = 900
POLL_SEC = 5
POSTGRESQL_SERVICE = "puu-postgresql"
POSTGRESQL_PORT = 5432
OPENWEBUI_DEPLOYMENT = "open-webui"
OPENWEBUI_KEY_ALIAS = "open-webui"

DB_PASSWORD_FILE = Path("/var/lib/puu/postgresql/litellm.pass")
DB_SECRET_NAME = "puu-litellm-db"
DB_SECRET_MANIFEST = "39-litellm-db-secret.yaml"
POSTGRESQL_MANIFEST = "38-postgresql.yaml"
API_ROUTE_MANIFEST = "22-puu-api.yaml"
HOSTS_FILE = Path("/etc/hosts")
AVAHI_API_UNIT = "puu-avahi-api-alias.service"

MASTER_KEY_CREDENTIAL = "litellm-master-key"
MASTER_KEY_STORE = Path("/etc/credstore.encrypted")
MASTER_KEY_SECRET_NAME = "puu-litellm-masterkey"
MASTER_KEY_MANIFEST = "39-litellm-masterkey.yaml"
AUTH_MANIFEST = "40-litellm-auth.yaml"
OPENWEBUI_KEY_SECRET_NAME = "puu-litellm-openwebui-key"
OPENWEBUI_KEY_MANIFEST = "44-litellm-openwebui-key.yaml"


def apply_crds(crd_src: Path) -> None:
    if not crd_src.is_dir():
        return
    ms.run_kubectl("apply", "--server-side", "--force-conflicts", "-f", str(crd_src))
    ms.run_kubectl("wait", "--for=condition=Established", "--timeout=120s", "customresourcedefinition", "--all")


def copy_manifests(manifest_src: Path, manifest_dst: Path) -> None:
    manifest_dst.mkdir(parents=True, exist_ok=True, mode=0o700)
    has_nvidia = ms.has_nvidia_hardware()
    if not has_nvidia:
        for name in NVIDIA_MANIFESTS:
            (manifest_dst / name).unlink(missing_ok=True)

    if not manifest_src.is_dir():
        return

    for manifest in sorted(manifest_src.glob("*.yaml")):
        if manifest.name in NVIDIA_MANIFESTS and not has_nvidia:
            continue
        ms.atomic_write_text(manifest_dst / manifest.name, manifest.read_text(), 0o644)


def write_secret(manifest_dst: Path, filename: str, name: str, data: dict[str, str]) -> None:
    for value in data.values():
        if "'" in value or "\n" in value:
            sys.exit(f"{name}: secret values cannot contain quotes or newlines")
    lines = [
        "apiVersion: v1",
        "kind: Secret",
        "metadata:",
        f"  name: {name}",
        f"  namespace: {OKSA_NAMESPACE}",
        "type: Opaque",
        "stringData:",
    ]
    lines += [f"  {key}: '{value}'" for key, value in data.items()]
    ms.atomic_write_text(manifest_dst / filename, "\n".join(lines) + "\n", 0o600)


def secret_value(path: Path, key: str) -> str | None:
    if not path.is_file():
        return None
    for line in path.read_text(encoding="utf-8").splitlines():
        name, separator, value = line.partition(":")
        if separator and name.strip() == key:
            return value.strip().strip("'") or None
    return None


def ensure_webui_secret(manifest_dst: Path) -> None:
    secret_path = manifest_dst / "44-open-webui-secret.yaml"
    if secret_path.exists():
        return
    secret_key = secrets.token_hex(32)
    ms.atomic_write_text(
        secret_path,
        "apiVersion: v1\nkind: Namespace\nmetadata:\n  name: oksa\n"
        "---\napiVersion: v1\nkind: Secret\nmetadata:\n"
        "  name: open-webui-secret\n  namespace: oksa\n"
        "type: Opaque\nstringData:\n"
        f"  secretkey: '{secret_key}'\n",
        0o600,
    )


def service_dns(name: str) -> str:
    return f"{name}.{OKSA_NAMESPACE}.svc.cluster.local"


def node_internal_ip() -> str:
    node = ms.resolve_k3s_node_name()
    if not ms.wait_for_node(node):
        sys.exit(f"node {node} did not register")
    output = ms.run_kubectl(
        "get", "node", node, "-o", 'jsonpath={.status.addresses[?(@.type=="InternalIP")].address}'
    ).stdout
    addresses = [ipaddress.ip_address(value) for value in output.split()]
    if not addresses:
        sys.exit(f"node {node} has no internal address")
    return str(next((address for address in addresses if address.version == 4), addresses[0]))


def read_litellm_db_password() -> str:
    try:
        password = DB_PASSWORD_FILE.read_text(encoding="utf-8").strip()
    except OSError as exc:
        sys.exit(f"{DB_PASSWORD_FILE}: {exc.strerror}; puu-postgresql.service must run first")
    if not password or any(character not in "0123456789abcdef" for character in password):
        sys.exit(f"{DB_PASSWORD_FILE} does not hold a generated password")
    return password


def ensure_postgresql_endpoints(manifest_dst: Path) -> None:
    address = node_internal_ip()
    ms.atomic_write_text(
        manifest_dst / POSTGRESQL_MANIFEST,
        f"""apiVersion: v1
kind: Service
metadata:
  name: {POSTGRESQL_SERVICE}
  namespace: {OKSA_NAMESPACE}
spec:
  ports:
    - name: postgresql
      port: {POSTGRESQL_PORT}
      targetPort: {POSTGRESQL_PORT}
---
apiVersion: v1
kind: Endpoints
metadata:
  name: {POSTGRESQL_SERVICE}
  namespace: {OKSA_NAMESPACE}
subsets:
  - addresses:
      - ip: {address}
    ports:
      - name: postgresql
        port: {POSTGRESQL_PORT}
""",
        0o644,
    )


def ensure_api_route(manifest_dst: Path) -> None:
    address = node_internal_ip()
    existing = []
    if HOSTS_FILE.is_file():
        existing = [
            line for line in HOSTS_FILE.read_text(encoding="utf-8", errors="ignore").splitlines()
            if not line.endswith("# puu-api")
        ]
    if not any(line.split()[:1] == ["127.0.0.1"] for line in existing if not line.lstrip().startswith("#")):
        existing.insert(0, "127.0.0.1 localhost localhost.localdomain")
    ms.atomic_write_text(HOSTS_FILE, "\n".join(existing) + "\n", 0o644)

    host_fqdns = ms.discover_host_fqdns()
    api_hostnames = [f"api.{fqdn}" for fqdn in host_fqdns]
    host_lines = "\n".join(f"    - {host}" for host in api_hostnames)
    ms.atomic_write_text(
        manifest_dst / API_ROUTE_MANIFEST,
        f"""apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: puu-api
  namespace: {OKSA_NAMESPACE}
spec:
  parentRefs:
    - name: puu-gateway
  hostnames:
{host_lines}
  rules:
    - matches:
        - path:
            type: PathPrefix
            value: /v1
      backendRefs:
        - name: {LITELLM_SERVICE}
          port: {LITELLM_PORT}
""",
        0o644,
    )

    existing.append(f"{address} {' '.join(host_fqdns + api_hostnames)} # puu-api")
    ms.atomic_write_text(HOSTS_FILE, "\n".join(existing) + "\n", 0o644)

    avahi_api = f"api.{ms.avahi_host_fqdn()}"
    subprocess.run(["/usr/bin/systemctl", "stop", AVAHI_API_UNIT], capture_output=True, check=False)
    subprocess.run(
        [
            "/usr/bin/systemd-run",
            f"--unit={AVAHI_API_UNIT}",
            "--collect",
            "--property=Restart=on-failure",
            "--property=After=avahi-daemon.service",
            "/usr/bin/avahi-publish",
            "-a",
            "-R",
            "-f",
            avahi_api,
            address,
        ],
        capture_output=True,
        check=False,
    )


def ensure_litellm_db(manifest_dst: Path) -> None:
    write_secret(
        manifest_dst,
        DB_SECRET_MANIFEST,
        DB_SECRET_NAME,
        {
            "username": "litellm",
            "password": read_litellm_db_password(),
            "endpoint": service_dns(POSTGRESQL_SERVICE),
        },
    )


def master_key_from_credential() -> str | None:
    credential_dir = os.environ.get("CREDENTIALS_DIRECTORY")
    if not credential_dir:
        return None
    try:
        master_key = (Path(credential_dir) / MASTER_KEY_CREDENTIAL).read_text(encoding="utf-8").strip()
    except OSError:
        if (MASTER_KEY_STORE / MASTER_KEY_CREDENTIAL).exists():
            sys.exit(
                f"{MASTER_KEY_STORE / MASTER_KEY_CREDENTIAL} cannot be decrypted; re-encrypt it with "
                "--with-key=host or remove it to serve keyless"
            )
        return None
    return master_key or None


def ensure_litellm_auth(manifest_dst: Path) -> str:
    auth_manifest = manifest_dst / AUTH_MANIFEST
    master_key = master_key_from_credential()
    old_key = secret_value(manifest_dst / MASTER_KEY_MANIFEST, "masterkey")
    management_key = master_key or old_key or "sk-" + secrets.token_urlsafe(32)
    legacy_auth = auth_manifest.is_file() and "name: PUU_LITELLM_MASTER_KEY" in auth_manifest.read_text()
    legacy_salt = old_key if legacy_auth else "puu-litellm-salt"
    salt_key = secret_value(manifest_dst / MASTER_KEY_MANIFEST, "saltkey") or legacy_salt or "puu-litellm-salt"
    checksum = hashlib.sha256(json.dumps([management_key, salt_key]).encode()).hexdigest()
    write_secret(manifest_dst, MASTER_KEY_MANIFEST, MASTER_KEY_SECRET_NAME, {"masterkey": management_key, "saltkey": salt_key})
    ms.atomic_write_text(
        auth_manifest,
        f"""apiVersion: helm.cattle.io/v1
kind: HelmChartConfig
metadata:
  name: {LITELLM_SERVICE}
  namespace: kube-system
spec:
  valuesContent: |-
    extraEnvVars:
      - name: PUU_LITELLM_MASTER_KEY
        valueFrom:
          secretKeyRef:
            name: {MASTER_KEY_SECRET_NAME}
            key: masterkey
      - name: PUU_LITELLM_REQUIRE_KEY
        value: "{str(master_key is not None).lower()}"
      - name: LITELLM_SALT_KEY
        valueFrom:
          secretKeyRef:
            name: {MASTER_KEY_SECRET_NAME}
            key: saltkey
    podAnnotations:
      puu.io/litellm-credentials: "{checksum}"
""",
        0o600,
    )
    ms.run_kubectl("apply", "-f", str(manifest_dst / MASTER_KEY_MANIFEST))
    ms.run_kubectl("apply", "-f", str(auth_manifest))
    return management_key


def litellm_address() -> str | None:
    proc = ms.run_kubectl(
        "get", "service", LITELLM_SERVICE, "--namespace", OKSA_NAMESPACE, "-o", "jsonpath={.spec.clusterIP}", check=False
    )
    if proc.returncode != 0:
        return None
    return proc.stdout.strip() or None


def litellm_request(method: str, path: str, api_key: str, payload: dict | None = None) -> tuple[int, dict]:
    address = litellm_address()
    if address is None:
        return 0, {}
    request = urllib.request.Request(
        f"http://{address}:{LITELLM_PORT}{path}",
        data=json.dumps(payload).encode() if payload is not None else None,
        headers={"Authorization": f"Bearer {api_key}", "Content-Type": "application/json"},
        method=method,
    )
    try:
        with urllib.request.urlopen(request, timeout=30) as response:
            return response.status, parse_json(response.read())
    except urllib.error.HTTPError as exc:
        return exc.code, parse_json(exc.read())
    except (urllib.error.URLError, TimeoutError, OSError):
        return 0, {}


def parse_json(raw: bytes) -> dict:
    try:
        parsed = json.loads(raw)
    except json.JSONDecodeError:
        return {}
    return parsed if isinstance(parsed, dict) else {}


def openwebui_key_is_valid(key: str) -> bool | None:
    deadline = time.monotonic() + LITELLM_TIMEOUT_SEC
    while time.monotonic() < deadline:
        status, _ = litellm_request("GET", "/v1/models", key)
        if status == 200:
            return True
        if status in (401, 403):
            return False
        time.sleep(POLL_SEC)
    return None


def mint_openwebui_key(master_key: str) -> str:
    deadline = time.monotonic() + LITELLM_TIMEOUT_SEC
    while time.monotonic() < deadline:
        status, payload = litellm_request("POST", "/key/generate", master_key, {"key_alias": OPENWEBUI_KEY_ALIAS})
        key = payload.get("key")
        if status == 200 and isinstance(key, str) and key:
            return key
        time.sleep(POLL_SEC)
    sys.exit("LiteLLM did not mint an OpenWebUI key")


def ensure_openwebui_key(manifest_dst: Path, master_key: str) -> None:
    key_manifest = manifest_dst / OPENWEBUI_KEY_MANIFEST
    deadline = time.monotonic() + LITELLM_TIMEOUT_SEC
    while time.monotonic() < deadline:
        status, _ = litellm_request("GET", "/key/list?page=1&size=1", master_key)
        if status == 200:
            break
        time.sleep(POLL_SEC)
    else:
        sys.exit("LiteLLM management API did not become ready")
    stored_key = secret_value(key_manifest, "api_key")
    valid = bool(stored_key and stored_key.startswith("sk-")) and openwebui_key_is_valid(stored_key)
    if valid is None:
        sys.exit("LiteLLM did not answer the OpenWebUI key probe")
    if valid:
        return
    write_secret(
        manifest_dst,
        OPENWEBUI_KEY_MANIFEST,
        OPENWEBUI_KEY_SECRET_NAME,
        {"api_key": mint_openwebui_key(master_key)},
    )
    ms.run_kubectl("apply", "-f", str(key_manifest))
    if stored_key is None:
        return
    ms.run_kubectl("rollout", "restart", f"deployment/{OPENWEBUI_DEPLOYMENT}", "--namespace", OKSA_NAMESPACE)
    ms.run_kubectl("rollout", "status", f"deployment/{OPENWEBUI_DEPLOYMENT}", "--namespace", OKSA_NAMESPACE, "--timeout=300s")


def main() -> None:
    manifest_src = Path("/usr/share/puu/k3s/manifests")
    manifest_dst = Path("/var/lib/rancher/k3s/server/manifests")
    crd_src = Path("/usr/share/puu/k3s/crds")

    if not ms.wait_for_kubectl("get", "--raw=/readyz"):
        sys.exit("kubernetes API did not become ready")
    try:
        apply_crds(crd_src)
    except subprocess.CalledProcessError as exc:
        sys.exit(f"{' '.join(exc.cmd[2:])}: {exc.stderr.strip()}")
    ms.run_kubectl("create", "namespace", OKSA_NAMESPACE, check=False)
    manifest_dst.mkdir(parents=True, exist_ok=True, mode=0o700)
    master_key = ensure_litellm_auth(manifest_dst)
    copy_manifests(manifest_src, manifest_dst)
    ensure_webui_secret(manifest_dst)
    ensure_postgresql_endpoints(manifest_dst)
    ensure_api_route(manifest_dst)
    ensure_litellm_db(manifest_dst)
    ensure_openwebui_key(manifest_dst, master_key)


if __name__ == "__main__":
    main()
