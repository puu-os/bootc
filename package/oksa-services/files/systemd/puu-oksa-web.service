[Unit]
Description=Puu Oksa Web Management Service
Wants=network.target
After=network.target puu-postgresql.service
ConditionKernelCommandLine=!puu.live

[Service]
Type=simple
ImportCredential=litellm-master-key
ExecStart=/usr/libexec/puu/oksa-web --port 8088 --host 0.0.0.0
Restart=always
RestartSec=5s
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
