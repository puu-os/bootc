[Unit]
Description=Download initial vLLM catalog models
After=network-online.target
Wants=network-online.target
ConditionKernelCommandLine=!puu.live

[Service]
Type=oneshot
ExecStart=/usr/libexec/puu-os/preseed-vllm-models
RemainAfterExit=yes
Restart=on-failure
RestartSec=1min

[Install]
WantedBy=multi-user.target
