[Unit]
Description=Generate per-model vLLM workloads
Requires=k3s.service
After=k3s.service puu-vllm-discovery.service puu-model-serving-labeler.service
ConditionKernelCommandLine=!puu.live

[Service]
Type=oneshot
ExecStartPre=/usr/libexec/puu/oksa-discover-vllm-models
ExecStart=/usr/libexec/puu/oksa-plan-vllm-workloads
