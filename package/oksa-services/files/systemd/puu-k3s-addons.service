[Unit]
Description=Install Puu k3s add-ons
Wants=k3s.service puu-postgresql.service
After=k3s.service puu-postgresql.service
ConditionKernelCommandLine=!puu.live

[Service]
Type=oneshot
RemainAfterExit=yes
# Operator-managed LiteLLM master key; absent means the cluster serves keyless.
ImportCredential=litellm-master-key
ExecStart=/usr/libexec/puu/install-k3s-addons
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
