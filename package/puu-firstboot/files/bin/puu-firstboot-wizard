import os
from pathlib import Path
import socket
import stat
import sys
import unicodedata

import gi

gi.require_version("Gtk", "4.0")
gi.require_version("Adw", "1")
from gi.repository import Adw, Gio, GLib, Gtk

BACKEND = None
BACKEND_ERROR = ""
try:
    module = Path("/usr/libexec/puu/puu_firstboot_state.py")
    for path in (module, *module.parents):
        info = path.lstat()
        expected_type = stat.S_ISREG if path == module else stat.S_ISDIR
        if not expected_type(info.st_mode) or info.st_uid != 0 or info.st_mode & 0o022:
            raise ValueError("Unsafe first-boot backend module")
    sys.path.insert(0, str(module.parent))
    import puu_firstboot_state as BACKEND
    if not all(callable(getattr(BACKEND, name, None))
               for name in ("read_status", "completion_valid")):
        raise ValueError("Invalid first-boot backend contract")
except (ImportError, OSError, ValueError, SyntaxError) as error:
    BACKEND = None
    BACKEND_ERROR = str(error)


def plain(value):
    return "".join(c for c in str(value)[:32768]
                   if c in "\n\t" or not unicodedata.category(c).startswith("C"))


class Wizard(Adw.Application):
    def __init__(self):
        super().__init__(application_id="org.puu.Firstboot", flags=Gio.ApplicationFlags.DEFAULT_FLAGS)
        self.window = None
        self.ready = False
        self.complete = False
        self.finishing = False
        self.status_start_time = GLib.get_monotonic_time()
        self.connect("activate", self.activate_window)

    def activate_window(self, _app):
        if self.window is not None:
            self.window.present()
            return

        self.window = Adw.ApplicationWindow(application=self, title="System Setup")
        self.window.set_default_size(680, 560)
        self.window.set_resizable(False)
        self.window.set_deletable(False)
        self.window.connect("close-request", lambda _window: True)
        self.window.connect("map", self.window_mapped)

        header_bar = Adw.HeaderBar()
        header_bar.set_show_title(False)
        header_bar.set_decoration_layout("")

        toolbar_view = Adw.ToolbarView()
        toolbar_view.add_top_bar(header_bar)

        self.stack = Adw.ViewStack()

        self.progress_page = Adw.StatusPage(
            icon_name="system-run-symbolic",
            title="Setting Up Your Computer",
            description="Please wait while initial setup completes.",
        )
        progress_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=16)
        self.progress_bar = Gtk.ProgressBar(show_text=False)
        self.progress_bar.set_fraction(0.05)
        self.status_label = Gtk.Label(label="Initializing…", wrap=True, justify=Gtk.Justification.CENTER)
        self.status_label.add_css_class("dim-label")
        progress_box.append(self.progress_bar)
        progress_box.append(self.status_label)
        clamp_progress = Adw.Clamp(maximum_size=420)
        clamp_progress.set_child(progress_box)
        self.progress_page.set_child(clamp_progress)
        self.stack.add_named(self.progress_page, "progress")

        self.complete_page = Adw.StatusPage(
            icon_name="emblem-ok-symbolic",
            title="Setup Complete",
            description="Your computer is configured and ready to use. Select Get Started to begin.",
        )
        complete_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=16)
        self.finish_button = Gtk.Button(label="Get Started")
        self.finish_button.add_css_class("suggested-action")
        self.finish_button.add_css_class("pill")
        self.finish_button.connect("clicked", self.finish_setup)
        complete_box.append(self.finish_button)
        clamp_complete = Adw.Clamp(maximum_size=280)
        clamp_complete.set_child(complete_box)
        self.complete_page.set_child(clamp_complete)
        self.stack.add_named(self.complete_page, "complete")

        self.error_page = Adw.StatusPage(
            icon_name="network-offline-symbolic",
            title="Setup Paused",
            description="An internet connection or check is required to continue.",
        )
        error_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=16)
        self.network_button = Gtk.Button(label="Open Network Settings")
        self.network_button.add_css_class("suggested-action")
        self.network_button.add_css_class("pill")
        self.network_button.connect("clicked", self.open_network)
        error_box.append(self.network_button)

        topbar_hint = Gtk.Label(
            label="You can also connect to Wi-Fi or configure network settings from the top bar menu.",
            wrap=True,
            justify=Gtk.Justification.CENTER,
        )
        topbar_hint.add_css_class("dim-label")
        topbar_hint.add_css_class("caption")
        error_box.append(topbar_hint)

        self.details_expander = Gtk.Expander(label="Technical Details")
        self.details_label = Gtk.Label(label="", wrap=True, selectable=True, xalign=0)
        self.details_label.add_css_class("dim-label")
        self.details_label.add_css_class("monospace")
        details_scroll = Gtk.ScrolledWindow(vexpand=True, min_content_height=100)
        details_scroll.set_child(self.details_label)
        self.details_expander.set_child(details_scroll)
        error_box.append(self.details_expander)

        clamp_error = Adw.Clamp(maximum_size=520)
        clamp_error.set_child(error_box)
        self.error_page.set_child(clamp_error)
        self.stack.add_named(self.error_page, "error")

        toolbar_view.set_content(self.stack)
        self.window.set_content(toolbar_view)
        self.stack.set_visible_child_name("progress")
        self.refresh()
        GLib.timeout_add_seconds(2, self.refresh)
        self.window.present()

    def window_mapped(self, _window):
        GLib.idle_add(self.notify_ready)

    def notify_ready(self):
        if self.ready:
            return GLib.SOURCE_REMOVE
        if not self.get_is_registered() or self.get_dbus_connection() is None:
            return GLib.SOURCE_REMOVE
        address = os.environ.get("NOTIFY_SOCKET")
        if address:
            if address.startswith("@"):
                address = "\0" + address[1:]
            try:
                with socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM) as connection:
                    connection.connect(address)
                    connection.sendall(b"READY=1")
            except OSError as error:
                print(f"Cannot notify session readiness: {error}", file=sys.stderr)
                return GLib.SOURCE_REMOVE
        self.ready = True
        return GLib.SOURCE_REMOVE

    def completion_valid(self):
        if BACKEND is None:
            return False
        try:
            return BACKEND.completion_valid() is True
        except (OSError, ValueError):
            return False

    def refresh(self):
        self.complete = self.completion_valid()
        if self.complete:
            self.stack.set_visible_child_name("complete")
            return GLib.SOURCE_CONTINUE

        try:
            if BACKEND is None:
                raise ValueError(f"Backend module unavailable: {BACKEND_ERROR}")
            status = BACKEND.read_status()
            self.status_start_time = None
        except (OSError, ValueError) as error:
            now = GLib.get_monotonic_time()
            if self.status_start_time is None:
                self.status_start_time = now
            elapsed = (now - self.status_start_time) / 1_000_000

            if BACKEND is None or elapsed > 10:
                self.stack.set_visible_child_name("error")
                self.error_page.set_icon_name("dialog-warning-symbolic")
                self.error_page.set_title("Setup Service Unresponsive" if BACKEND is not None else "Setup Unavailable")
                self.error_page.set_description(
                    "Waiting for the background setup service to report status." if BACKEND is not None
                    else "The first-boot setup backend could not be initialized."
                )
                self.network_button.set_visible(False)
                self.details_label.set_text(plain(error))
            else:
                self.stack.set_visible_child_name("progress")
                self.status_label.set_text("Starting setup…")
                self.details_label.set_text(plain(error))
            return GLib.SOURCE_CONTINUE

        steps = status.get("steps", [])
        has_error = any(step.get("state") == "error" for step in steps)
        if has_error:
            self.stack.set_visible_child_name("error")
            msg = status.get("message", "")
            if any(term in msg.lower() for term in ("network", "connect", "download", "offline", "image")):
                self.error_page.set_icon_name("network-offline-symbolic")
                self.error_page.set_title("Network Connection Required")
                self.error_page.set_description("An internet connection is required to download components.")
                self.network_button.set_visible(True)
            else:
                self.error_page.set_icon_name("dialog-warning-symbolic")
                self.error_page.set_title("Setup Needs Attention")
                self.error_page.set_description(plain(msg) or "Initial system setup encountered an issue.")
                self.network_button.set_visible(False)
            details = [msg] if msg else []
            details.extend(status.get("details", []))
            self.details_label.set_text(plain("\n".join(details)))
            return GLib.SOURCE_CONTINUE

        self.stack.set_visible_child_name("progress")
        done_count = sum(1 for step in steps if step.get("state") == "done")
        total_count = max(len(steps), 1)
        fraction = max(done_count / total_count, 0.05)
        self.progress_bar.set_fraction(fraction)

        active_step = next((step for step in steps if step.get("state") == "running"), None)
        if active_step:
            self.status_label.set_text(plain(active_step.get("label", "")) + "…")
        elif status.get("message"):
            self.status_label.set_text(plain(status["message"]))
        else:
            self.status_label.set_text("Configuring system…")

        return GLib.SOURCE_CONTINUE

    def call(self, bus, destination, path, interface, method, parameters, callback):
        def connected(_source, result):
            try:
                connection = Gio.bus_get_finish(result)
            except GLib.Error as error:
                callback(error)
                return

            def finished(source, response):
                try:
                    source.call_finish(response)
                except GLib.Error as error:
                    callback(error)
                    return
                callback(None)

            connection.call(destination, path, interface, method, parameters, None,
                            Gio.DBusCallFlags.ALLOW_INTERACTIVE_AUTHORIZATION,
                            15000, None, finished)

        Gio.bus_get(bus, None, connected)

    def open_network(self, _button):
        panel = GLib.Variant("(sav)", ("network", []))
        self.call(Gio.BusType.SESSION, "org.gnome.Settings", "/org/gnome/Settings",
                  "org.gtk.Actions", "Activate",
                  GLib.Variant("(sava{sv})", ("launch-single-panel-mode", [panel], {})),
                  lambda _error: None)

    def finish_setup(self, button):
        if not self.completion_valid() or self.finishing:
            return
        self.finishing = True
        button.set_sensitive(False)

        def timeout_reset():
            self.finishing = False
            button.set_sensitive(True)
            return GLib.SOURCE_REMOVE

        def finished(error):
            if error:
                self.finishing = False
                button.set_sensitive(True)
            else:
                GLib.timeout_add_seconds(10, timeout_reset)

        self.call(Gio.BusType.SESSION, "org.gnome.SessionManager", "/org/gnome/SessionManager",
                  "org.gnome.SessionManager", "Logout", GLib.Variant("(u)", (1,)), finished)


if __name__ == "__main__":
    sys.exit(Wizard().run(sys.argv))
