import base64
import hashlib
import http.client
import ipaddress
import json
import os
from pathlib import Path
import signal
import subprocess
import sys
import time

for _candidate in (Path("/usr/libexec/puu"), Path(__file__).resolve().parents[3] / "oksa-services" / "files" / "bin"):
    if _candidate.is_dir() and str(_candidate) not in sys.path:
        sys.path.insert(0, str(_candidate))

import puu_firstboot_state as fs
import oksa_calibration_state as cs

NAMESPACE = "oksa"
STEP_LABELS = (
    ("identity", "User account"),
    ("services", "System services"),
    ("addons", "Base components"),
    ("downloads", "System downloads"),
    ("calibration", "AI capacity calibration"),
    ("model", "AI model runtime"),
    ("gateway", "API gateway"),
    ("webui", "Desktop services"),
    ("verification", "System verification"),
)


from oksa_model_serving import label_namespace


class Pending(Exception):
    def __init__(self, stage, message, error=False):
        super().__init__(message)
        self.stage = stage
        self.message = message
        self.error = error


def clean(value, limit=128):
    return "".join(c for c in str(value) if c.isprintable())[:limit]


class Progress:
    def __init__(self):
        self.steps = [{"id": key, "label": label, "state": "pending", "detail": ""} for key, label in STEP_LABELS]
        self.details = []
        self.stage = "services"

    def reset_cycle(self):
        self.details = []

    def publish(self, stage, message, state="running", complete=False):
        self.stage = stage
        for step in self.steps:
            if complete or step["id"] == stage:
                step["state"] = "done" if complete else state
                step["detail"] = message
        fs.atomic_record(fs.STATUS_PATH, {
            "schema": 1,
            "boot_id": fs.boot_id(),
            "updated_at": time.time(),
            "complete": complete,
            "stage": stage,
            "message": message,
            "details": self.details[:32],
            "steps": self.steps,
        })


def kubectl(*arguments):
    return fs.command([
        "/usr/bin/kubectl", "--kubeconfig=/var/lib/rancher/k3s/k3s.yaml",
        "--cache-dir=/run/puu-firstboot/kube-cache", "--request-timeout=10s", *arguments,
    ], timeout=15)


def kube_json(*arguments, optional=False):
    data = kubectl(*arguments, "-o", "json")
    if optional and not data.strip():
        return None
    value = fs.decode_json(data)
    if not isinstance(value, dict):
        raise ValueError("Invalid Kubernetes response")
    return value


def items(value):
    result = value.get("items")
    if not isinstance(result, list) or len(result) > 2048 or not all(isinstance(item, dict) for item in result):
        raise ValueError("Invalid resource list")
    return result


def identity(resource):
    meta = resource["metadata"]
    uid, generation = meta["uid"], meta["generation"]
    if not isinstance(uid, str) or not uid or type(generation) is not int or generation < 1:
        raise ValueError("Invalid resource identity")
    return uid, generation


def conditions_current(resource, conditions, required):
    generation = identity(resource)[1]
    return all(any(
        condition.get("type") == kind and condition.get("status") == "True"
        and type(condition.get("observedGeneration")) is int
        and condition["observedGeneration"] == generation
        for condition in conditions
    ) for kind in required)


def owns(resource, kind, uid):
    return any(ref.get("kind") == kind and ref.get("uid") == uid and ref.get("controller") is True
               for ref in resource.get("metadata", {}).get("ownerReferences", []))


def deployment_ready(deployment):
    status = deployment.get("status", {})
    count = deployment.get("spec", {}).get("replicas", 1)
    return (
        type(count) is int and count > 0
        and all(type(status.get(field, 0)) is int for field in (
            "observedGeneration", "updatedReplicas", "replicas", "readyReplicas", "availableReplicas"
        ))
        and status.get("observedGeneration") == identity(deployment)[1]
        and status.get("updatedReplicas", 0) == count
        and status.get("replicas", 0) == count
        and status.get("readyReplicas", 0) == count
        and status.get("availableReplicas", 0) == count
    )


def current_pods(resources, deployment):
    revision = deployment.get("metadata", {}).get("annotations", {}).get("deployment.kubernetes.io/revision")
    if not revision:
        return []
    replicasets = {
        item["metadata"]["uid"] for item in resources
        if item.get("kind") == "ReplicaSet" and owns(item, "Deployment", identity(deployment)[0])
        and item.get("metadata", {}).get("annotations", {}).get("deployment.kubernetes.io/revision") == revision
    }
    return [item for item in resources if item.get("kind") == "Pod"
            and not item.get("metadata", {}).get("deletionTimestamp")
            and any(owns(item, "ReplicaSet", uid) for uid in replicasets)]


def ready_endpoint(resources, service, pods):
    ready = {
        pod["metadata"]["uid"] for pod in pods
        if any(c.get("type") == "Ready" and c.get("status") == "True" for c in pod.get("status", {}).get("conditions", []))
    }
    return any(
        endpoint.get("conditions", {}).get("ready") is True
        and endpoint.get("conditions", {}).get("terminating") is not True
        and endpoint.get("targetRef", {}).get("kind") == "Pod"
        and endpoint.get("targetRef", {}).get("uid") in ready
        and endpoint.get("addresses")
        for resource in resources if resource.get("kind") == "EndpointSlice"
        and resource.get("metadata", {}).get("labels", {}).get("kubernetes.io/service-name") == service["metadata"]["name"]
        and any(ref.get("kind") == "Service" and ref.get("uid") == service["metadata"]["uid"]
                for ref in resource.get("metadata", {}).get("ownerReferences", []))
        for endpoint in resource.get("endpoints", [])
    )


def pod_details(resources):
    details = []
    for pod in resources:
        if pod.get("kind") != "Pod" or pod.get("status", {}).get("phase") == "Succeeded":
            continue
        name = clean(pod.get("metadata", {}).get("name", "pod"))
        status = pod.get("status", {})
        for container in status.get("initContainerStatuses", []) + status.get("containerStatuses", []):
            label = name + "/" + clean(container.get("name", "container"))
            waiting = container.get("state", {}).get("waiting", {})
            reason = waiting.get("reason")
            if reason in ("ImagePullBackOff", "ErrImagePull", "CrashLoopBackOff", "CreateContainerConfigError", "CreateContainerError"):
                details.append(label + ": " + reason + "; check connectivity or service configuration.")
            elif reason in ("ContainerCreating", "PodInitializing"):
                details.append(label + ": preparing container; image download may be in progress.")
            elif container.get("state", {}).get("running") and not container.get("ready"):
                details.append(label + ": running, not ready; model files may be downloading or loading.")
        if status.get("phase") == "Pending":
            details.append(name + ": waiting for scheduling or container preparation.")
    return details[:24]


def resource(resources, kind, name):
    for item in resources:
        if item.get("kind") == kind and item.get("metadata", {}).get("name") == name:
            return item
    raise Pending("addons", "Base system components are still being installed.")


def ip_literal(value):
    if not isinstance(value, str) or "%" in value:
        raise ValueError("Invalid IP address")
    address = ipaddress.ip_address(value)
    if address.is_unspecified or address.is_multicast:
        raise ValueError("Unusable IP address")
    return str(address)


def ip_authority(address):
    address = ip_literal(address)
    return "[" + address + "]" if ":" in address else address


def service_address(service, port):
    if not any(p.get("port") == port and p.get("protocol", "TCP") == "TCP" for p in service.get("spec", {}).get("ports", [])):
        raise ValueError("Service port mismatch")
    return ip_literal(service["spec"]["clusterIP"])


def route_ready(route, hostname, backend, port, controller):
    spec = route.get("spec", {})
    if spec.get("hostnames") != [hostname]:
        return False
    parents = spec.get("parentRefs", [])
    if not any(parent_matches(parent) for parent in parents):
        return False
    path = "/v1" if hostname == "api.puu.local" else "/"
    rules = spec.get("rules", [])
    if len(rules) != 1 or rules[0].get("filters"):
        return False
    rule = rules[0]
    matches = rule.get("matches", [])
    if len(matches) != 1 or matches[0].get("path") != {"type": "PathPrefix", "value": path}:
        return False
    if set(matches[0]) != {"path"}:
        return False
    refs = rule.get("backendRefs", [])
    if len(refs) != 1:
        return False
    ref = refs[0]
    if (ref.get("name") != backend or ref.get("port") != port or ref.get("weight", 1) <= 0
            or ref.get("kind", "Service") != "Service" or ref.get("group", "") != ""
            or ref.get("namespace", NAMESPACE) != NAMESPACE or ref.get("filters")):
        return False
    return any(
        parent_matches(parent.get("parentRef", {}))
        and parent.get("controllerName") == controller
        and conditions_current(route, parent.get("conditions", []), ("Accepted", "ResolvedRefs"))
        for parent in route.get("status", {}).get("parents", [])
    )


def parent_matches(parent):
    return (
        parent.get("name") == "puu-gateway" and parent.get("namespace", NAMESPACE) == NAMESPACE
        and parent.get("group", "gateway.networking.k8s.io") == "gateway.networking.k8s.io"
        and parent.get("kind", "Gateway") == "Gateway"
        and parent.get("sectionName", "http") == "http" and parent.get("port", 80) == 80
    )


def gateway_address(gateway, resources):
    if gateway.get("spec", {}).get("gatewayClassName") != "agentgateway":
        raise Pending("gateway", "Waiting for the configured agentgateway public listener.")
    listeners = gateway.get("spec", {}).get("listeners", [])
    if not any(listener.get("name") == "http" and listener.get("protocol") == "HTTP"
               and listener.get("port") == 80 and not listener.get("hostname") for listener in listeners):
        raise Pending("gateway", "The public HTTP listener is not configured yet.")
    if not conditions_current(gateway, gateway.get("status", {}).get("conditions", []), ("Accepted", "Programmed")):
        raise Pending("gateway", "Waiting for current public gateway configuration.")
    for address in gateway.get("status", {}).get("addresses", []):
        if address.get("type", "IPAddress") == "IPAddress":
            return ip_literal(address.get("value"))
    for service in resources:
        if service.get("kind") != "Service":
            continue
        metadata = service.get("metadata", {})
        if (metadata.get("labels", {}).get("gateway.networking.k8s.io/gateway-name") == "puu-gateway"
                and any(ref.get("kind") == "Gateway" and ref.get("uid") == identity(gateway)[0]
                        for ref in metadata.get("ownerReferences", []))):
            return service_address(service, 80)
    raise Pending("gateway", "Waiting for a bound public gateway address.")


def request_deadline(signum, frame):
    raise TimeoutError("HTTP request timed out")


def http_request(address, port, path, host=None, key=None, payload=None):
    address = ip_literal(address)
    headers = {"Host": host or ip_authority(address), "Accept": "application/json", "Connection": "close"}
    body = None
    if key is not None:
        headers["Authorization"] = "Bearer " + key
    if payload is not None:
        body = json.dumps(payload).encode("utf-8")
        headers["Content-Type"] = "application/json"
    connection = http.client.HTTPConnection(address, port, timeout=75)
    previous = signal.signal(signal.SIGALRM, request_deadline)
    signal.setitimer(signal.ITIMER_REAL, 80)
    try:
        connection.request("POST" if payload is not None else "GET", path, body=body, headers=headers)
        response = connection.getresponse()
        if response.status in (401, 403):
            raise Pending("verification", "API authorization is not ready. Check the configured service credentials.", True)
        if response.status != 200:
            raise Pending("verification", "The service is not ready or is offline. Setup will retry automatically.")
        data = response.read(fs.MAX_BYTES + 1)
        if len(data) > fs.MAX_BYTES:
            raise ValueError("HTTP response too large")
        return fs.decode_json(data) if data.strip() else None
    finally:
        signal.setitimer(signal.ITIMER_REAL, 0)
        signal.signal(signal.SIGALRM, previous)
        connection.close()


def master_key():
    secret = kube_json("get", "secret", "puu-litellm-masterkey", "-n", NAMESPACE, "--ignore-not-found", optional=True)
    if secret is None:
        return None, None
    encoded = secret.get("data", {}).get("masterkey")
    if not isinstance(encoded, str) or len(encoded) > 8192:
        raise Pending("verification", "The configured API credential is not ready.", True)
    key = base64.b64decode(encoded, validate=True).decode("ascii")
    if not key or len(key) > 4096 or not all(33 <= ord(c) <= 126 for c in key):
        raise Pending("verification", "The configured API credential is invalid.", True)
    return key, (secret["metadata"]["uid"], secret["metadata"]["resourceVersion"])


def chat_valid(response):
    if not isinstance(response, dict) or response.get("model") not in (fs.MODEL, fs.SERVED_MODEL):
        return False
    usage = response.get("usage")
    if not isinstance(usage, dict) or type(usage.get("completion_tokens")) is not int or usage["completion_tokens"] <= 0:
        return False
    choices = response.get("choices")
    if not isinstance(choices, list) or not choices or len(choices) > 16:
        return False
    for choice in choices:
        if not isinstance(choice, dict) or choice.get("finish_reason") not in ("stop", "length"):
            continue
        message = choice.get("message")
        if not isinstance(message, dict) or message.get("role") != "assistant":
            continue
        return True
    return False


def static_model_mapping(response):
    if not isinstance(response, dict) or not isinstance(response.get("data"), list):
        return False
    matches = [model for model in response["data"] if isinstance(model, dict) and model.get("model_name") in (fs.MODEL, f"prism-ml/{fs.MODEL}")]
    return bool(matches) and any(
        model.get("litellm_params", {}).get("model") in ("openai/" + fs.SERVED_MODEL, "openai/Bonsai-2-27B", "openai/prism-ml/bonsai-2-27b", "openai/bonsai-2-27b")
        and model.get("litellm_params", {}).get("api_base") == "http://bonsai-2-27b.oksa.svc.cluster.local:8000/v1"
        for model in matches
    )


def unit_checks(progress):
    states = {unit: fs.unit_state(unit) for unit in fs.CORE_UNITS}
    for unit in ("k3s.service", "postgresql.service", "avahi-daemon.service"):
        value = states[unit]
        if value.get("ActiveState") != "active" or value.get("SubState") != "running":
            raise Pending("services", clean(unit) + " is starting or unavailable. Setup will keep checking.", value.get("ActiveState") == "failed")
    if not fs.unit_completed(states["puu-postgresql.service"]):
        raise Pending("services", "Waiting for database initialization.", states["puu-postgresql.service"].get("ActiveState") == "failed")
    progress.publish("services", "System services and database are ready.", "done")
    if kubectl("get", "--raw=/readyz").strip() != b"ok":
        raise Pending("addons", "Waiting for the Kubernetes API to be ready.")
    if not fs.unit_completed(states["puu-k3s-addons.service"]):
        raise Pending("addons", "Installing cluster add-ons and service credentials.", states["puu-k3s-addons.service"].get("ActiveState") == "failed")
    preseed = states["puu-vllm-preseed.service"]
    if preseed.get("ActiveState") == "activating":
        progress.details.append("Catalog model downloads are in progress; existing download files are reused.")
    elif preseed.get("ActiveState") == "failed":
        progress.details.append("Catalog downloads need attention; checking network connection.")
    calibration = states["puu-bonsai-calibration.service"]
    if not fs.unit_completed(calibration):
        message = "Preparing measured AI capacity calibration."
        failed = calibration.get("ActiveState") == "failed"
        try:
            status = cs.read_record(cs.STATUS_PATH)
            if status.get("boot_id") == fs.boot_id():
                message = clean(status.get("message", message), 512)
                failed = failed or status.get("state") == "error"
        except FileNotFoundError:
            pass
        raise Pending("calibration", message, failed)
    result = cs.applied_result()
    limits = result["limits"]
    message = (f"Measured {limits['max_model_len']} context tokens and {limits['max_num_seqs']} simultaneous requests."
               if limits["max_num_seqs"] else "Calibration complete: no local AI capacity; limits are zero.")
    progress.publish("calibration", message, "done")
    return states


def referenced_configmaps(deployments):
    names = set()
    for deployment in deployments.values():
        spec = deployment["spec"]["template"]["spec"]
        for volume in spec.get("volumes", []):
            if volume.get("configMap", {}).get("name"):
                names.add(volume["configMap"]["name"])
            for source in volume.get("projected", {}).get("sources", []):
                if source.get("configMap", {}).get("name"):
                    names.add(source["configMap"]["name"])
        for container in spec.get("containers", []) + spec.get("initContainers", []):
            for env in container.get("envFrom", []):
                if env.get("configMapRef", {}).get("name"):
                    names.add(env["configMapRef"]["name"])
            for env in container.get("env", []):
                ref = env.get("valueFrom", {}).get("configMapKeyRef", {})
                if ref.get("name"):
                    names.add(ref["name"])
    return names


def snapshot(progress):
    unit_checks(progress)
    calibration = cs.applied_result()
    zero_capacity = calibration["limits"] == cs.ZERO_LIMITS
    progress.publish("addons", "Configuring base components.")
    jobs = items(kube_json("get", "jobs,pods", "-n", "kube-system"))
    progress.details.extend(pod_details(jobs))
    for job in jobs:
        if job.get("kind") != "Job" or not job.get("metadata", {}).get("name", "").startswith("helm-install-"):
            continue
        if not any(c.get("type") == "Complete" and c.get("status") == "True" for c in job.get("status", {}).get("conditions", [])):
            failed = any(c.get("type") == "Failed" and c.get("status") == "True" for c in job.get("status", {}).get("conditions", []))
            raise Pending("addons", "Downloading and installing base components.", failed)
    resources = items(kube_json("get", "deployments,replicasets,pods,services,endpointslices,gateways,httproutes,configmaps", "-n", NAMESPACE))
    progress.details.extend(pod_details(resources))
    progress.publish("addons", "Base components installed.", "done")
    nodes = items(kube_json("get", "nodes"))
    if not zero_capacity and not any(
        node.get("metadata", {}).get("labels", {}).get(f"{label_namespace()}/cuda-ready") == "true"
        and node.get("metadata", {}).get("labels", {}).get(f"{label_namespace()}/cdi-ready") == "true"
        and any(c.get("type") == "Ready" and c.get("status") == "True" for c in node.get("status", {}).get("conditions", []))
        and int(node.get("status", {}).get("allocatable", {}).get("nvidia.com/gpu", "0")) > 0
        for node in nodes
    ):
        raise Pending("model", "Supported NVIDIA GPU not detected. Check hardware and driver configuration.", True)
    deployments = {}
    services = {}
    for name, stage in ((fs.MODEL, "model"), ("litellm", "gateway"), ("open-webui", "webui")):
        deployment = resource(resources, "Deployment", name)
        service = resource(resources, "Service", name)
        deployments[name] = deployment
        services[name] = service
        if name == fs.MODEL and zero_capacity:
            if (deployment.get("spec", {}).get("replicas") != 0
                    or deployment.get("status", {}).get("replicas", 0) != 0
                    or deployment.get("status", {}).get("observedGeneration") != identity(deployment)[1]
                    or any(r.get("kind") == "Pod" and r.get("metadata", {}).get("labels", {}).get("app.kubernetes.io/name") == fs.MODEL
                           for r in resources)):
                raise Pending("model", "Stopping inference after zero-capacity calibration.")
            continue
        if not deployment_ready(deployment) or not ready_endpoint(resources, service, current_pods(resources, deployment)):
            if name == fs.MODEL:
                message = "Downloading and loading AI model…"
            elif name == "litellm":
                message = "Starting API gateway…"
            else:
                message = "Starting desktop services…"
            raise Pending(stage, message)
    containers = deployments["open-webui"]["spec"]["template"]["spec"]["containers"]
    if not any(container.get("name") == "open-webui" and any(
        env.get("name") == "DEFAULT_MODELS" and fs.SERVED_MODEL in env.get("value", "").split(";")
        for env in container.get("env", [])
    ) for container in containers):
        raise Pending("model", "Configuring AI model defaults…", True)
    gateway_class = kube_json("get", "gatewayclass", "agentgateway")
    controller = gateway_class.get("spec", {}).get("controllerName")
    if not isinstance(controller, str) or not controller or "envoy" in controller.lower():
        raise Pending("gateway", "Waiting for the configured agentgateway class controller.")
    gateway = resource(resources, "Gateway", "puu-gateway")
    routes = [resource(resources, "HTTPRoute", name) for name in ("puu-gateway", "puu-api")]
    if not route_ready(routes[0], "puu.local", "open-webui", 8080, controller) or not route_ready(routes[1], "api.puu.local", "litellm", 4000, controller):
        raise Pending("gateway", "Waiting for current public routes to be accepted and their backends resolved.")
    address = gateway_address(gateway, resources)
    key, key_identity = master_key()
    critical = [gateway_class, gateway, *routes, *deployments.values(), *services.values()]
    gateway_services = [r for r in resources if r.get("kind") == "Service"
                        and any(ref.get("kind") == "Gateway" and ref.get("uid") == identity(gateway)[0]
                                for ref in r.get("metadata", {}).get("ownerReferences", []))]
    critical.extend(gateway_services)
    service_names = set(services) | {r["metadata"]["name"] for r in gateway_services}
    config_names = referenced_configmaps(deployments)
    configs = [r for r in resources if r.get("kind") == "ConfigMap" and r["metadata"]["name"] in config_names]
    if {r["metadata"]["name"] for r in configs} != config_names:
        raise Pending("addons", "Configuring service components…")
    fingerprint = hashlib.sha256(json.dumps([
        [(r["kind"], r["metadata"]["uid"], r["metadata"].get("generation"), r.get("spec")) for r in critical],
        [(p["metadata"]["uid"], p.get("spec"), p.get("status", {}).get("containerStatuses"))
         for deployment in deployments.values() for p in current_pods(resources, deployment)],
        sorted((r["metadata"]["uid"], r["metadata"]["resourceVersion"]) for r in configs),
        [(r["metadata"]["uid"], r.get("addressType"), r.get("ports"), r.get("endpoints"))
         for r in resources if r.get("kind") == "EndpointSlice"
         and r.get("metadata", {}).get("labels", {}).get("kubernetes.io/service-name") in service_names],
        address, key_identity, fs.machine_id(), fs.read_enrollment(), calibration,
    ], sort_keys=True).encode("utf-8")).hexdigest()
    return address, key, services, fingerprint, calibration


def verify(progress):
    if fs.pending_identity():
        raise Pending("identity", "User account preparation is in progress.", True)
    enrollment = fs.read_enrollment()
    if enrollment is None:
        raise Pending("identity", "User account setup is not complete.", True)
    progress.publish("identity", "User account setup complete.", "done")
    address, key, services, fingerprint, calibration = snapshot(progress)
    zero_capacity = calibration["limits"] == cs.ZERO_LIMITS
    progress.publish("downloads", "System downloads complete.", "done")
    if zero_capacity:
        progress.publish("model", "Local inference disabled: calibrated limits are zero.", "done")
    else:
        progress.publish("model", "Verifying AI runtime health.")
        model_address = service_address(services[fs.MODEL], 8000)
        http_request(model_address, 8000, "/health")
        progress.publish("model", "Verifying AI model availability.")
        models = http_request(model_address, 8000, "/v1/models")
        if not isinstance(models, dict) or not isinstance(models.get("data"), list) or not any(
            isinstance(model, dict) and model.get("id") in (fs.SERVED_MODEL, "Bonsai-2-27B", "bonsai-2-27b", f"prism-ml/{fs.MODEL}") for model in models["data"]
        ):
            raise Pending("model", "AI runtime is initializing.")
        progress.publish("model", "AI model runtime is ready.", "done")
    progress.publish("gateway", "Checking API gateway configuration.")
    mapping = http_request(service_address(services["litellm"], 4000), 4000, "/model/info", key=key)
    if not static_model_mapping(mapping):
        raise Pending("gateway", "Waiting for API gateway configuration.", True)
    progress.publish("gateway", "Checking API route.")
    models = http_request(address, 80, "/v1/models", "api.puu.local", key)
    if not isinstance(models, dict) or not isinstance(models.get("data"), list) or not any(
        isinstance(model, dict) and model.get("id") in (fs.MODEL, f"prism-ml/{fs.MODEL}") for model in models["data"]
    ):
        raise Pending("gateway", "Waiting for API routes to become active.")
    progress.publish("gateway", "API gateway and routes are ready.", "done")
    progress.publish("webui", "Checking desktop services.")
    health = http_request(address, 80, "/health", "puu.local")
    if not isinstance(health, dict) or health.get("status") is not True:
        raise Pending("webui", "Desktop services are starting.")
    progress.publish("webui", "Desktop services are ready.", "done")
    progress.publish("verification", "Verifying system response.")
    if not zero_capacity:
        response = http_request(address, 80, "/v1/chat/completions", "api.puu.local", key, {
            "model": fs.SERVED_MODEL,
            "messages": [{"role": "user", "content": "Say hello."}],
            "max_tokens": 1,
            "stream": False,
        })
        if not chat_valid(response):
            raise Pending("verification", "Waiting for verification response.")
    progress.publish("verification", "Verifying configuration.")
    mapping = http_request(service_address(services["litellm"], 4000), 4000, "/model/info", key=key)
    if not static_model_mapping(mapping):
        raise Pending("verification", "Verifying configuration changes.")
    progress.publish("verification", "Rechecking configuration.")
    if snapshot(progress)[3] != fingerprint:
        raise Pending("verification", "System state changed during verification. Rechecking.")
    progress.publish("verification", "Saving setup completion status.")
    fs.atomic_record(fs.COMPLETION_PATH, {
        "schema": 1,
        "machine_id": fs.machine_id(),
        "model": fs.MODEL,
        "served_model": fs.SERVED_MODEL,
        "verification": "zero-capacity-calibration" if zero_capacity else "public-chat-completion",
        "calibration_fingerprint": calibration["fingerprint"],
        "completed_at": time.time(),
        "enrolled_at": enrollment["enrolled_at"],
    })
    if not fs.completion_valid():
        raise OSError("Completion could not be validated")
    progress.details = []
    message = "Initial setup complete. Local AI capacity is zero." if zero_capacity else "Initial setup complete."
    progress.publish("complete", message, complete=True)


def main():
    if len(sys.argv) != 1 or os.geteuid() != 0:
        return 1
    if fs.is_live():
        return 0
    progress = Progress()
    try:
        required = fs.setup_required()
    except (OSError, ValueError):
        progress.publish("identity", "Setup enrollment is unreadable or untrusted. Initial setup needs recovery.", "error")
        return 1
    if not required:
        return 0
    if fs.completion_valid():
        progress.publish("complete", "Initial setup complete.", complete=True)
        return 0
    progress.publish("services", "Preparing initial setup…")
    while True:
        progress.reset_cycle()
        try:
            if not fs.setup_required():
                return 0
            verify(progress)
            return 0
        except Pending as pending:
            progress.publish(pending.stage, pending.message, "error" if pending.error else "running")
        except (OSError, ValueError, KeyError, TypeError, AttributeError, RecursionError, subprocess.TimeoutExpired, http.client.HTTPException):
            progress.publish(progress.stage, "Waiting for connectivity and service availability.", "error")
        time.sleep(5)


if __name__ == "__main__":
    try:
        sys.exit(main())
    except (OSError, ValueError):
        print("First-boot monitor could not publish or persist its state.", file=sys.stderr)
        sys.exit(1)
