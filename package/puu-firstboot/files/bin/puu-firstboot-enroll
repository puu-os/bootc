import os
import sys
import time

import puu_firstboot_state as fs


def main():
    if len(sys.argv) != 1 or os.geteuid() != 0:
        return 1
    if fs.is_live() or not fs.pending_identity():
        return 0
    identifier = fs.machine_id()
    enrollment = fs.read_enrollment(current_machine=False)
    if enrollment is None or enrollment["machine_id"] != identifier:
        enrollment = {"schema": 1, "machine_id": identifier, "enrolled_at": time.time()}
    fs.atomic_record(fs.ENROLLMENT_PATH, enrollment)
    directory_fd = os.open(fs.ENROLLMENT_PATH.parent.parent, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    try:
        os.fsync(directory_fd)
    finally:
        os.close(directory_fd)
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except (OSError, ValueError):
        print("First-boot enrollment could not be durably saved; initial account provisioning remains blocked.", file=sys.stderr)
        sys.exit(1)
