import fcntl
import os
from pathlib import Path
import subprocess
import sys
import time

import firstboot_state as fs

RATE_PATH = Path("/run/puu-firstboot/retry.json")
LOCK_PATH = Path("/run/puu-firstboot/retry.lock")


def retry_allowed():
    try:
        record = fs.read_record(RATE_PATH)
    except FileNotFoundError:
        record = {"schema": 1, "boot_id": fs.boot_id(), "attempts": []}
    attempts = record.get("attempts")
    if record.get("boot_id") != fs.boot_id() or not isinstance(attempts, list) or len(attempts) > 3:
        raise ValueError("Invalid retry state")
    now = time.monotonic()
    if not all(type(value) in (int, float) and 0 <= value <= now for value in attempts):
        raise ValueError("Invalid retry timestamp")
    attempts = [value for value in attempts if now - value < 60]
    if len(attempts) >= 3:
        return False
    fs.atomic_record(RATE_PATH, {"schema": 1, "boot_id": fs.boot_id(), "attempts": attempts + [now]})
    return True


def main():
    if len(sys.argv) != 1 or os.geteuid() != 0:
        return 1
    if fs.is_live() or not fs.setup_required() or fs.completion_valid():
        return 0
    fd = os.open(LOCK_PATH, os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW, 0o600)
    with os.fdopen(fd, "r+") as lock:
        fcntl.flock(lock.fileno(), fcntl.LOCK_EX)
        if not retry_allowed():
            print("First-boot retry rate limit reached; wait a minute.", file=sys.stderr)
            return 0
        failures = False
        for unit in fs.RETRY_UNITS:
            if not fs.setup_required() or fs.completion_valid():
                return 1 if failures else 0
            try:
                state = fs.unit_state(unit, timeout=3)
                if (state.get("LoadState") != "loaded" or state.get("ActiveState") not in ("inactive", "failed")
                        or state.get("Job", "") not in ("", "0")):
                    continue
                if state.get("ActiveState") == "failed":
                    fs.command(["systemctl", "reset-failed", unit], timeout=2)
                state = fs.unit_state(unit, timeout=3)
                if (state.get("LoadState") == "loaded" and state.get("ActiveState") in ("inactive", "failed")
                        and state.get("Job", "") in ("", "0")):
                    fs.command(["systemctl", "--no-block", "start", unit], timeout=2)
            except (OSError, ValueError, subprocess.TimeoutExpired):
                failures = True
                print("First-boot retry could not start " + unit + ".", file=sys.stderr)
        return 1 if failures else 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except (OSError, ValueError):
        print("First-boot retry could not read or persist its state.", file=sys.stderr)
        sys.exit(1)
