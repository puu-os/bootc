[Unit]
Description=Retry existing initial Puu setup services
ConditionKernelCommandLine=!puu.live
StartLimitIntervalSec=60s
StartLimitBurst=3

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/libexec/puu/firstboot-retry
TimeoutStartSec=120s
RuntimeDirectory=puu-firstboot
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
StateDirectory=puu/firstboot
StateDirectoryMode=0755
UMask=0022
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=
RestrictSUIDSGID=yes
LockPersonality=yes
