config BR2_PACKAGE_PUU_FIRSTBOOT
	bool "puu-firstboot"
	depends on BR2_INIT_SYSTEMD
	depends on BR2_PACKAGE_GNOME_SHELL
	depends on BR2_PACKAGE_GDM
	depends on BR2_PACKAGE_GNOME_SESSION
	depends on BR2_PACKAGE_GNOME_CONTROL_CENTER
	depends on BR2_PACKAGE_LIBGTK4
	depends on BR2_PACKAGE_LIBADWAITA
	depends on BR2_PACKAGE_OKSA
	depends on BR2_PACKAGE_PYTHON3
	depends on BR2_USE_MMU
	depends on BR2_PACKAGE_GOBJECT_INTROSPECTION_ARCH_SUPPORTS
	depends on BR2_TOOLCHAIN_GCC_AT_LEAST_4_9
	depends on BR2_HOST_GCC_AT_LEAST_8
	depends on BR2_TOOLCHAIN_USES_GLIBC || BR2_TOOLCHAIN_USES_MUSL
	select BR2_PACKAGE_PYTHON_GOBJECT
	select BR2_PACKAGE_DCONF
	help
	  Restricted GNOME first-boot session and unprivileged Python wizard.
	  Normal graphical login requires trusted setup completion.
	  Live installer sessions retain their existing login behavior.
