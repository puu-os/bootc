import os
import sys
from pathlib import Path

for extra_path in ("/usr/libexec/puu", "/usr/local/usr/libexec/puu"):
    if Path(extra_path).is_dir() and extra_path not in sys.path:
        sys.path.insert(0, extra_path)

from nicegui import app, ui

from oksa_client import OksaClient
from oksa_web_ui import OksaWebUI


class OksaWebApplication:
    @staticmethod
    def run() -> None:
        host = os.environ.get("OKSA_WEB_HOST", "0.0.0.0")
        port = int(os.environ.get("OKSA_WEB_PORT", "8088"))
        client = OksaClient()
        app.on_shutdown(client.close)

        @app.get("/health")
        def health() -> dict[str, str]:
            return {"status": "ok"}

        OksaWebUI(client).mount()
        ui.run(host=host, port=port, title="OKSA", show=False, reload=False)


if __name__ == "__main__":
    OksaWebApplication.run()
