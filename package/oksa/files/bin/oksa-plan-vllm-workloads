import argparse
import fcntl
import os
from pathlib import Path
import subprocess
import sys

sys.path.insert(0, str(Path(__file__).resolve().parent))
import oksa_model_serving as ms
from oksa_calibration_state import CalibrationStore, STATUS_PATH, boot_id, read_record
from oksa_workload_evaluation import WorkloadEvaluator
from oksa_workload_manifest import WorkloadManifestBuilder


class WorkloadPlanner:
    def __init__(self, require_reconcile: bool = False):
        self.require_selected = require_reconcile or ms.parse_bool(
            os.environ.get("PUU_VLLM_REQUIRE_SELECTED_MODEL"), False
        )
        self.selected = ""
        self.disabled = False
        self.active_file = Path(os.environ.get("PUU_VLLM_ACTIVE_MODEL_FILE", str(ms.STATE_DIR / "active-model")))
        self.manifest = WorkloadManifestBuilder.manifest_path()
        self.empty_manifest = '{"apiVersion":"v1","kind":"List","items":[]}\n'

    @staticmethod
    def warn(message: str) -> None:
        sys.stderr.write(f"oksa-plan-vllm-workloads: {message}\n")

    def load(self) -> ms.WorkloadState:
        self.disabled = not ms.parse_bool(
            os.environ.get("PUU_VLLM_IGNORE_SERVING_DISABLED"), False
        ) and Path(os.environ.get(
            "PUU_VLLM_SERVING_DISABLED_FILE", str(ms.STATE_DIR / "serving.disabled")
        )).is_file()
        self.selected = os.environ.get("PUU_VLLM_SELECTED_MODEL", "") or ms.read_first_line(
            Path(os.environ.get("PUU_VLLM_SELECTED_MODEL_FILE", str(ms.STATE_DIR / "selected-model")))
        )
        state = ms.WorkloadState.load(
            ms.STATE_DIR, ms.MODELS_DIR, check_model_paths=not self.disabled,
            resolve_public_names=bool(self.selected), selected_model=self.selected,
        )
        if self.selected:
            self.selected = state.resolve_model_name(self.selected)
        if state.snapshot is None:
            raise ValueError(f"Cannot evaluate workloads: {state.capability_error}")
        return state

    def calibrate(self) -> None:
        state = self.load()
        if self.disabled:
            return
        selected = self.selected
        candidates = sorted(
            (model for model in state.snapshot.models
             if model.spec.name == selected or (not selected and model.spec.autostart)),
            key=lambda model: -model.spec.autostart_priority,
        )
        if not candidates and state.snapshot.models:
            raise RuntimeError("No selected model or autostart model is configured")
        rejected = []
        measured = False
        for model in candidates:
            evaluation = WorkloadEvaluator(state.snapshot).evaluate(
                model.spec.name, require_calibration=False
            )
            if evaluation.plan is None and state.snapshot.node.gpu_count > 0:
                rejected.extend(evaluation.reasons)
                for reason in evaluation.reasons:
                    self.warn(reason)
                continue
            needs_calibration = True
            try:
                result = CalibrationStore.load(model.spec)
                aggregate = read_record(STATUS_PATH)
                needs_calibration = not (
                    aggregate.get("model") == model.spec.name and aggregate.get("boot_id") == boot_id()
                    and aggregate.get("state") == "complete"
                    and aggregate.get("fingerprint") == result["fingerprint"]
                )
            except (FileNotFoundError, ValueError):
                pass
            if needs_calibration:
                subprocess.run(
                    [str(Path(__file__).with_name("oksa-calibrate")), "--model", model.spec.name],
                    check=True,
                )
                state = self.load()
                if self.disabled or self.selected != selected:
                    return
                result = CalibrationStore.load(model.spec)
            measured = True
            if result["limits"]["max_num_seqs"] > 0:
                return
        if candidates and not measured:
            raise RuntimeError("No configured model can be calibrated: " + "; ".join(rejected))

    def reconcile(self, dry_run: bool) -> None:
        try:
            state = self.load()
        except ms.InvalidModelSelection as error:
            self.warn(str(error))
            if self.require_selected or not self.disabled:
                raise
            state = ms.WorkloadState.load(ms.STATE_DIR, ms.MODELS_DIR, check_model_paths=False)
        evaluation = WorkloadEvaluator(state.snapshot).evaluate(self.selected, self.disabled)
        for reason in evaluation.reasons:
            self.warn(reason)
        planned = evaluation.plan
        content = WorkloadManifestBuilder(planned, ms.MODELS_DIR).render() if planned else self.empty_manifest
        changed = not self.manifest.is_file() or self.manifest.read_text() != content
        active = planned.spec.name if planned else ""
        previous = ms.read_first_line(self.active_file)
        if not dry_run:
            if changed or previous != active or not active:
                if not ms.sync_litellm_models(None, ms.STATE_DIR):
                    raise RuntimeError("Failed to unpublish model routing before reconciliation")
                self.active_file.unlink(missing_ok=True)
            if changed:
                ms.atomic_write_text(self.manifest, self.empty_manifest)
            WorkloadManifestBuilder.stop_workloads(planned.app_name if planned and not changed else "")
        if changed:
            ms.atomic_write_text(self.manifest, content)
        if active:
            if not dry_run:
                deployment = f"deployment/{planned.app_name}"
                try:
                    ms.run_kubectl(
                        "wait", "--for=create", deployment, "-n", ms.OKSA_NAMESPACE,
                        "--timeout=120s", timeout=130,
                    )
                    # K3s may not yet have restored a previously stopped deployment.
                    ms.run_kubectl(
                        "wait", f"--for=jsonpath={{.spec.replicas}}={planned.replicas}",
                        deployment, "-n", ms.OKSA_NAMESPACE, "--timeout=120s", timeout=130,
                    )
                    ms.run_kubectl(
                        "rollout", "status", deployment, "-n", ms.OKSA_NAMESPACE,
                        "--timeout=600s", timeout=610,
                    )
                except (subprocess.CalledProcessError, subprocess.TimeoutExpired) as error:
                    detail = str(error)
                    if isinstance(error, subprocess.CalledProcessError):
                        detail = (error.stderr or error.stdout or detail).strip()
                    try:
                        self.active_file.unlink(missing_ok=True)
                    except OSError as cleanup_error:
                        detail += f"; failed to clear active model marker: {cleanup_error}"
                    try:
                        if not ms.sync_litellm_models(None, ms.STATE_DIR):
                            detail += "; failed to unpublish model routing"
                    except Exception as cleanup_error:
                        detail += f"; failed to unpublish model routing: {cleanup_error}"
                    raise RuntimeError(f"Failed to start {active}: {detail}") from error
            if not dry_run and not ms.sync_litellm_models(active, ms.STATE_DIR):
                raise RuntimeError(f"Failed to publish {active} to LiteLLM")
            ms.atomic_write_text(self.active_file, f"{active}\n")
        else:
            self.active_file.unlink(missing_ok=True)
        if self.selected and not planned and self.require_selected and not self.disabled:
            raise RuntimeError(f"Selected model {self.selected} has no deployable calibrated profile")

    @classmethod
    def main(cls) -> None:
        parser = argparse.ArgumentParser(description="Reconcile model serving workloads")
        parser.add_argument("--require-reconcile", action="store_true", help="Fail instead of skipping live reconciliation")
        args = parser.parse_args()
        planner = cls(args.require_reconcile)
        dry_run = (ms.parse_bool(os.environ.get("PUU_VLLM_IGNORE_SERVING_DISABLED"), False)
                   or planner.manifest.parent != Path("/var/lib/rancher/k3s/server/manifests"))
        if dry_run:
            if args.require_reconcile:
                sys.exit("Live reconciliation is required; dry-run configuration is active")
            planner.reconcile(dry_run=True)
            return
        ms.STATE_DIR.mkdir(parents=True, exist_ok=True)
        STATUS_PATH.parent.mkdir(parents=True, exist_ok=True)
        with (ms.STATE_DIR / "planner.lock").open("a") as planner_lock:
            fcntl.flock(planner_lock, fcntl.LOCK_EX)
            subprocess.run([str(Path(__file__).with_name("oksa-label-model-serving-node"))], check=True)
            planner.calibrate()
            with (STATUS_PATH.parent / "lock").open("a") as gpu_lock:
                fcntl.flock(gpu_lock, fcntl.LOCK_EX)
                planner.reconcile(dry_run=False)


if __name__ == "__main__":
    WorkloadPlanner.main()
