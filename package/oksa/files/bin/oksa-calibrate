import argparse
import dataclasses
import fcntl
import json
import os
from pathlib import Path
import signal
from statistics import median
import subprocess
import time

import oksa_model_serving as ms
from oksa_calibration_state import (
    CalibrationStore, STATUS_PATH, ZERO_LIMITS, atomic_record, boot_id,
    read_record, result_path, status_path, valid_result,
)
from oksa_workload_evaluation import PlannedWorkload, WorkloadEvaluator
from oksa_workload_manifest import WorkloadManifestBuilder

PROBE_PATH = Path(__file__).with_name("oksa-calibration-probe")
POD = "vllm-calibration"
MAX_TRIALS = 40
MAX_SECONDS = 4 * 60 * 60
TRIAL_SECONDS = 2100


class CalibrationTimeout(TimeoutError):
    def __init__(self, reason, message):
        super().__init__(message)
        self.reason = reason


class CalibrationController:
    CLEANUP_SECONDS = 150
    def __init__(self, model: str = "", force: bool = False):
        self.requested_model = model
        self.model = ""
        self.force = force
        self.fingerprint = ""

    def publish(self, state: str, message: str) -> None:
        value = dict(schema=1, model=self.model, boot_id=boot_id(), state=state,
                     message=message[:512], fingerprint=self.fingerprint, updated_at=time.time())
        if self.model:
            atomic_record(status_path(self.model), value)
        atomic_record(STATUS_PATH, value)

    @staticmethod
    def memory_info() -> dict[str, int]:
        values = {}
        for line in Path("/proc/meminfo").read_text().splitlines():
            key, value = line.split(":", 1)
            if key in ("MemTotal", "MemAvailable"):
                values[key] = int(value.split()[0]) * 1024
        return values

    @staticmethod
    def kubectl(*args, payload=None, request_timeout=20, deadline=None):
        timeout = request_timeout + 20
        if deadline is not None:
            timeout = min(timeout, deadline - time.monotonic())
        if timeout <= 0:
            raise TimeoutError("Calibration Kubernetes operation deadline exhausted")
        command = ["/usr/bin/kubectl", f"--kubeconfig={ms.get_kubeconfig()}",
                   f"--request-timeout={min(request_timeout, timeout):.3f}s", *args]
        result = subprocess.run(command, input=json.dumps(payload) if payload is not None else None,
                                capture_output=True, text=True, timeout=timeout)
        if result.returncode:
            raise RuntimeError(f"kubectl {' '.join(args[:3])}: {result.stderr[-2048:]}")
        return json.loads(result.stdout) if "json" in args and result.stdout.strip() else result.stdout

    @classmethod
    def delete_probe(cls, *, deadline=None) -> None:
        cls.kubectl("delete", "pod", POD, "-n", ms.OKSA_NAMESPACE, "--ignore-not-found",
                    "--wait=true", "--timeout=120s", "-o", "name", request_timeout=130, deadline=deadline)

    @staticmethod
    def context_ceiling(plan: PlannedWorkload) -> int:
        config = json.loads((Path(plan.spec.path) / "config.json").read_text())
        if not isinstance(config, dict):
            raise ValueError("Model config must be a JSON object")
        ceilings = [plan.spec.max_context]
        for section in (config, config.get("text_config", {})):
            if not isinstance(section, dict):
                continue
            for key in ("max_position_embeddings", "max_sequence_length", "n_positions", "seq_length"):
                value = section.get(key)
                if type(value) is int and value > 0:
                    ceilings.append(value)
        return min(ceilings)

    @staticmethod
    def probe_pod(plan: PlannedWorkload, node: str, context: int, sequences: int,
                  utilization: float, memory_bytes: int, reserve: int, seconds: int,
                  *, prefix_caching: bool = False) -> dict:
        candidate = dataclasses.replace(
            plan, spec=dataclasses.replace(plan.spec, max_context=context,
                                           max_concurrent_sequences=sequences),
            gpu_memory_utilization=f"{utilization:.2f}", memory_bytes=memory_bytes,
            max_num_batched_tokens=min(8192, context * sequences),
        )
        manifest = WorkloadManifestBuilder(candidate, ms.MODELS_DIR).build(prefix_caching=prefix_caching)
        spec = manifest["items"][1]["spec"]["template"]["spec"]
        spec.update(restartPolicy="Never", activeDeadlineSeconds=seconds + 60,
                    terminationGracePeriodSeconds=15, automountServiceAccountToken=False)
        spec.setdefault("nodeSelector", {})["kubernetes.io/hostname"] = node
        container = spec["containers"][0]
        command = container["command"]
        container["command"] = ["python3", "/calibration/oksa-calibration-probe"]
        container.pop("readinessProbe", None)
        container.pop("ports", None)
        container["env"].extend([
            dict(name="PUU_PROBE_COMMAND", value=json.dumps(command)),
            dict(name="PUU_PROBE_CONTEXT", value=str(context)),
            dict(name="PUU_PROBE_SEQUENCES", value=str(sequences)),
            dict(name="PUU_PROBE_UTILIZATION", value=str(utilization)),
            dict(name="PUU_PROBE_HOST_RESERVE", value=str(reserve)),
            dict(name="PUU_PROBE_SECONDS", value=str(seconds)),
        ])
        container["volumeMounts"].extend([
            dict(name="calibration", mountPath="/calibration", readOnly=True),
            dict(name="host-meminfo", mountPath="/calibration-host-meminfo", readOnly=True),
        ])
        spec["volumes"].extend([
            dict(name="calibration", hostPath=dict(path=str(PROBE_PATH.resolve().parent), type="Directory")),
            dict(name="host-meminfo", hostPath=dict(path="/proc/meminfo", type="File")),
        ])
        return dict(apiVersion="v1", kind="Pod", metadata=dict(name=POD, namespace=ms.OKSA_NAMESPACE), spec=spec)

    def run_trial(self, plan: PlannedWorkload, node: str, context: int, sequences: int,
                  utilization: float, memory_bytes: int, reserve: int, deadline: float,
                  trial_number: int, *, prefix_caching: bool = False) -> dict:
        started = time.monotonic()
        seconds = min(TRIAL_SECONDS, int(deadline - started - self.CLEANUP_SECONDS))
        if seconds < 1:
            raise CalibrationTimeout("global-time-budget", "Calibration search time budget exhausted")
        trial_deadline = started + seconds
        message = (f"Trial {trial_number}/{MAX_TRIALS}: testing {context} context tokens, "
                   f"{sequences} simultaneous requests; GPU-memory budget {utilization:.0%}; "
                   f"prefix caching {'enabled' if prefix_caching else 'disabled'}.")
        self.publish("running", message)
        pod = self.probe_pod(plan, node, context, sequences, utilization, memory_bytes,
                             reserve, seconds, prefix_caching=prefix_caching)

        def timed_out(message):
            if time.monotonic() >= deadline:
                raise CalibrationTimeout("global-time-budget", "Calibration search time budget exhausted")
            return dict(status="timeout", reason=message, context=context,
                        sequences=sequences, utilization=utilization)

        try:
            self.kubectl("create", "-f", "-", "-o", "json", payload=pod, deadline=trial_deadline)
            next_update = started + 10
            while time.monotonic() < trial_deadline:
                if time.monotonic() >= next_update:
                    self.publish("running", f"{message} Elapsed {int(time.monotonic() - started)}s.")
                    next_update = time.monotonic() + 10
                current = self.kubectl("get", "pod", POD, "-n", ms.OKSA_NAMESPACE, "-o", "json",
                                       deadline=trial_deadline)
                deadline_exceeded = current.get("status", {}).get("reason") == "DeadlineExceeded"
                statuses = current.get("status", {}).get("containerStatuses", [])
                for status in statuses:
                    waiting = status.get("state", {}).get("waiting", {})
                    if waiting.get("reason") in ("ErrImagePull", "ImagePullBackOff", "CreateContainerConfigError",
                                                 "CreateContainerError", "InvalidImageName"):
                        raise RuntimeError(f"Calibration runtime: {waiting}")
                    terminated = status.get("state", {}).get("terminated")
                    if not terminated:
                        continue
                    if terminated.get("reason") == "OOMKilled":
                        return dict(status="capacity", reason="Pod memory limit reached", context=context,
                                    sequences=sequences, utilization=utilization)
                    value = json.loads(terminated.get("message") or "{}")
                    if deadline_exceeded and (not value or value.get("reason") == "InterruptedError: probe interrupted by signal 15"):
                        return timed_out("Calibration pod time budget exhausted")
                    if value.get("status") not in ("passed", "capacity", "timeout"):
                        raise RuntimeError(f"Calibration probe failed: {value or terminated}")
                    if terminated.get("exitCode") != 0:
                        raise RuntimeError(f"Calibration probe exited unsuccessfully: {terminated}")
                    if (value.get("context") != context or value.get("sequences") != sequences
                            or value.get("utilization") != utilization):
                        raise ValueError("Calibration probe returned mismatched parameters")
                    metrics = value.get("metrics") or {}
                    estimated = metrics.get("estimated_max_model_len")
                    if estimated is not None and (type(estimated) is not int or not 0 < estimated < 1e18):
                        raise ValueError("Invalid probe estimated_max_model_len")
                    if value["status"] == "passed":
                        for key in ("tokens_per_second", "peak_gpu_memory_bytes", "peak_host_memory_bytes",
                                    "minimum_host_available_bytes", "kv_cache_tokens"):
                            number = metrics.get(key)
                            if type(number) not in (int, float) or not 0 < number < 1e18:
                                raise ValueError(f"Invalid probe metric: {key}")
                        if (metrics["kv_cache_tokens"] < context * sequences
                                or metrics["minimum_host_available_bytes"] < reserve
                                or metrics["peak_host_memory_bytes"] > memory_bytes + 64 * 1024**2):
                            raise ValueError("Calibration probe exceeded its memory bounds")
                        samples = metrics.get("tokens_per_second_samples")
                        if (not isinstance(samples, list) or len(samples) != 3
                                or any(type(sample) not in (int, float) or not 0 < sample < 1e18 for sample in samples)
                                or metrics["tokens_per_second"] != median(samples)):
                            raise ValueError("Invalid probe throughput samples")
                    if time.monotonic() >= trial_deadline:
                        return timed_out("Calibration candidate time budget exhausted")
                    value["prefix_caching"] = prefix_caching
                    return value
                if deadline_exceeded:
                    return timed_out("Calibration pod time budget exhausted")
                if current.get("status", {}).get("phase") in ("Failed", "Succeeded"):
                    raise RuntimeError(f"Calibration pod ended without a probe result: {current.get('status')}")
                time.sleep(min(2, max(0, trial_deadline - time.monotonic())))
            return timed_out("Calibration candidate time budget exhausted")
        except (subprocess.TimeoutExpired, TimeoutError):
            return timed_out("Calibration Kubernetes operation exceeded its time budget")
        finally:
            self.delete_probe(deadline=deadline)

    @staticmethod
    def search_context(test, trials: list[dict], upper: int) -> int:
        passed, failed = 512, upper // 512 * 512 + 512
        while failed - passed > 512:
            candidate = failed - 512 if failed > upper else (passed + failed) // 1024 * 512
            outcome = test(candidate)
            if outcome == "passed":
                passed = candidate
            elif outcome in ("capacity", "timeout"):
                failed = candidate
                estimated = (trials[-1].get("metrics") or {}).get("estimated_max_model_len", 0)
                if outcome == "capacity" and type(estimated) is int and estimated > passed:
                    failed = min(failed, estimated // 512 * 512 + 512)
            else:
                raise ValueError(f"Invalid context trial outcome: {outcome}")
        return passed

    def calibrate(self, plan: PlannedWorkload, node: str, identity: dict) -> dict:
        memory = self.memory_info()
        reserve = max(2 * 1024**3, memory["MemTotal"] // 5)
        budget = max(0, memory["MemAvailable"] - reserve)
        result = dict(schema=1, model=self.model, state="complete", fingerprint=self.fingerprint,
                      identity=identity, completed_at=time.time(), reason="insufficient-memory",
                      limits=dict(ZERO_LIMITS), trials=[], search_complete=True, incomplete_reasons=[])
        if not budget:
            return result
        ceiling = self.context_ceiling(plan)
        if ceiling < 512:
            raise ValueError("Model context ceiling is below the minimum calibration context of 512")
        deadline = time.monotonic() + MAX_SECONDS
        trials = result["trials"]
        best = None

        def mark_incomplete(reason):
            result["search_complete"] = False
            if reason not in result["incomplete_reasons"]:
                result["incomplete_reasons"].append(reason)

        def measure(context, sequences, utilization, *, prefix_caching=False, memory_bytes=budget):
            if time.monotonic() >= deadline:
                raise CalibrationTimeout("global-time-budget", "Calibration search time budget exhausted")
            if len(trials) >= MAX_TRIALS - (0 if prefix_caching else 3):
                raise CalibrationTimeout("trial-budget", "Calibration trial budget exhausted")
            value = self.run_trial(plan, node, context, sequences, utilization, memory_bytes,
                                   reserve, deadline, len(trials) + 1, prefix_caching=prefix_caching)
            trials.append(value)
            if value["status"] == "timeout":
                mark_incomplete("candidate-timeout")
            return value

        def test(context, sequences, utilization):
            nonlocal best
            value = measure(context, sequences, utilization)
            if value["status"] == "passed":
                best = value
            return value["status"]

        try:
            for utilization in (0.9, 0.85, 0.7, 0.5):
                if test(512, 1, utilization) == "passed":
                    break
            else:
                if not result["search_complete"]:
                    raise CalibrationTimeout("candidate-timeout", "No profile passed before candidate timeouts")
                return result
            upper = min(ceiling, best["metrics"]["kv_cache_tokens"])
            context = self.search_context(lambda tokens: test(tokens, 1, utilization), trials, upper)
            baseline = best["metrics"]["tokens_per_second"]
            cache_tokens = best["metrics"]["kv_cache_tokens"]
            for sequences in (2, 4, 8, 16, 32):
                if sequences > plan.spec.max_concurrent_sequences or context * sequences > cache_tokens:
                    break
                value = measure(context, sequences, utilization)
                if value["status"] == "passed":
                    throughput = value["metrics"]["tokens_per_second"]
                    if throughput / baseline >= 1.1 and throughput > best["metrics"]["tokens_per_second"]:
                        best = value
        except CalibrationTimeout as error:
            if best is None:
                raise
            mark_incomplete(error.reason)
            self.publish("running", f"{error}; validating the best profile with prefix caching enabled.")
        context, sequences, utilization = best["context"], best["sequences"], best["utilization"]
        enabled = measure(context, sequences, utilization, prefix_caching=True)
        if enabled["status"] != "passed":
            raise RuntimeError(f"Serving profile failed prefix-cache validation: {enabled['reason']}")
        peak = max(
            max(trial["metrics"]["peak_host_memory_bytes"] for trial in trials if trial.get("status") == "passed"),
            enabled["metrics"]["peak_host_memory_bytes"] + max(0, plan.spec.storage_mib) * 1024**2,
        )
        memory_bytes = min(budget, (int(peak * 1.2) + 512 * 1024**2 + 1024**2 - 1) // 1024**2 * 1024**2)
        final = measure(context, sequences, utilization, prefix_caching=True, memory_bytes=memory_bytes)
        if final["status"] == "capacity" and memory_bytes < budget:
            memory_bytes = budget
            final = measure(context, sequences, utilization, prefix_caching=True, memory_bytes=memory_bytes)
        if final["status"] != "passed":
            raise RuntimeError(f"Serving profile failed measured-memory validation: {final['reason']}")
        result.update(reason="measured", completed_at=time.time(), metrics=final["metrics"], limits=dict(
            max_model_len=context, max_num_seqs=sequences,
            max_num_batched_tokens=min(8192, context * sequences),
            gpu_memory_utilization=utilization, memory_bytes=memory_bytes))
        return result

    def run(self) -> None:
        selected = self.requested_model or os.environ.get("PUU_VLLM_SELECTED_MODEL", "") or ms.read_first_line(
            Path(os.environ.get("PUU_VLLM_SELECTED_MODEL_FILE", str(ms.STATE_DIR / "selected-model")))
        )
        state = ms.WorkloadState.load(ms.STATE_DIR, ms.MODELS_DIR,
                                     selected_model=selected, resolve_public_names=bool(selected))
        if state.snapshot is None:
            raise ValueError(f"Cannot evaluate workloads: {state.capability_error}")
        if selected:
            self.model = state.resolve_model_name(selected)
        else:
            candidates = sorted((model for model in state.snapshot.models if model.spec.autostart),
                                key=lambda model: -model.spec.autostart_priority)
            if not candidates:
                if state.snapshot.models:
                    raise ValueError("No selected model or autostart model is configured")
                self.publish("complete", "No models available for calibration.")
                print("No models available for calibration.", flush=True)
                return
            self.model = candidates[0].spec.name
        spec = next(model.spec for model in state.snapshot.models if model.spec.name == self.model)
        store = CalibrationStore()
        identity = store.identity(spec)
        self.fingerprint = store.fingerprint(identity)
        cached = None
        if not self.force:
            try:
                cached = read_record(result_path(self.model))
            except (FileNotFoundError, ValueError):
                pass
        if (cached is not None and valid_result(cached, self.model)
                and cached["fingerprint"] == self.fingerprint
                and cached["identity"] == identity
                and (cached["limits"]["max_num_seqs"] > 0 or cached["search_complete"])
                and cached["reason"] != "insufficient-memory"):
            message = (f"Calibration complete with zero limits: {cached['reason']}."
                       if not cached["limits"]["max_num_seqs"]
                       else "Matching measured profile applied for this boot.")
            self.publish("complete", message)
            print(f"Applied cached profile for {self.model}.", flush=True)
            return
        self.publish("running", f"Preparing measured {self.model} calibration.")
        evaluation = WorkloadEvaluator(state.snapshot).evaluate(self.model, require_calibration=False)
        if not identity["gpus"]:
            result = dict(schema=1, model=self.model, state="complete", fingerprint=self.fingerprint,
                          identity=identity, completed_at=time.time(), reason="no-gpu", limits=dict(ZERO_LIMITS),
                          trials=[], search_complete=True, incomplete_reasons=[])
        else:
            if evaluation.plan is None:
                raise ValueError("Cannot probe model: " + "; ".join(evaluation.reasons))
            WorkloadManifestBuilder(evaluation.plan, ms.MODELS_DIR).build()
            self.context_ceiling(evaluation.plan)
            self.kubectl("get", "namespace", ms.OKSA_NAMESPACE, "-o", "json")
            node = self.kubectl("get", "node", identity["node"], "-o", "json")
            hostname = node["metadata"]["labels"]["kubernetes.io/hostname"]
            if not ms.sync_litellm_models(None, ms.STATE_DIR):
                raise RuntimeError("Failed to unpublish model routing before calibration")
            active_file = Path(os.environ.get("PUU_VLLM_ACTIVE_MODEL_FILE", str(ms.STATE_DIR / "active-model")))
            active_file.unlink(missing_ok=True)
            ms.atomic_write_text(WorkloadManifestBuilder.manifest_path(),
                                 '{"apiVersion":"v1","kind":"List","items":[]}\n')
            WorkloadManifestBuilder.stop_workloads()
            self.delete_probe()
            result = self.calibrate(evaluation.plan, hostname, identity)
        if not valid_result(result, self.model):
            raise ValueError("Invalid calibration result")
        current_identity = store.identity(spec)
        if current_identity != identity or store.fingerprint(current_identity) != self.fingerprint:
            raise RuntimeError("Model, runtime or hardware identity changed during calibration; result was not applied")
        atomic_record(result_path(self.model), result)
        limits = result["limits"]
        message = (f"Measured {limits['max_model_len']} context tokens and {limits['max_num_seqs']} "
                   "simultaneous requests; serving profile validated with prefix caching enabled.") if limits["max_num_seqs"] else (
                       f"Calibration complete with zero limits: {result['reason']}.")
        if not result["search_complete"]:
            message += " Maximum capacity was not established; use --force to retry."
        self.publish("complete", message)
        print(message, flush=True)

    @staticmethod
    def interrupted(signum, frame):
        raise InterruptedError(f"Calibration interrupted by signal {signum}")

    @classmethod
    def main(cls) -> int:
        parser = argparse.ArgumentParser(description="Measure local model inference limits")
        parser.add_argument("--force", action="store_true", help="Measure again even if a matching result is cached")
        parser.add_argument("--model", default="", help="Discovered model name (defaults to selected or highest-priority autostart model)")
        arguments = parser.parse_args()
        if os.geteuid() != 0:
            raise PermissionError("Calibration requires root")
        controller = cls(arguments.model, arguments.force)
        STATUS_PATH.parent.mkdir(parents=True, exist_ok=True, mode=0o755)
        signal.signal(signal.SIGTERM, cls.interrupted)
        signal.signal(signal.SIGINT, cls.interrupted)
        with (STATUS_PATH.parent / "lock").open("a") as lock:
            fcntl.flock(lock, fcntl.LOCK_EX)
            try:
                controller.run()
            except CalibrationTimeout as error:
                controller.publish("error", str(error))
                return 75
            except Exception as error:
                controller.publish("error", str(error))
                raise
        return 0


if __name__ == "__main__":
    raise SystemExit(CalibrationController.main())
