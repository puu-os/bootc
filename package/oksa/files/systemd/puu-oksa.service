[Unit]
Description=Puu OKSA D-Bus Administration
Wants=network.target
After=dbus.service network.target puu-postgresql.service
ConditionKernelCommandLine=!puu.live

[Service]
Type=dbus
BusName=org.puu.Oksa
User=root
Group=root
ImportCredential=litellm-master-key
ExecStart=/usr/libexec/puu/oksa-daemon
Restart=on-failure
RestartSec=5s
StateDirectory=oksa
StateDirectoryMode=0700
UMask=0022
KillMode=control-group
TimeoutStopSec=180s
Environment=PYTHONUNBUFFERED=1
Environment=HOME=/var/lib/oksa
NoNewPrivileges=yes
ProtectSystem=full
PrivateTmp=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
