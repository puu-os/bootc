[Unit]
Description=Calibrate and generate per-model vLLM workloads
Wants=k3s.service puu-k3s-addons.service puu-model-serving-labeler.service puu-vllm-preseed.service
After=k3s.service puu-k3s-addons.service puu-model-serving-labeler.service puu-vllm-preseed.service
ConditionKernelCommandLine=!puu.live

[Service]
Type=oneshot
ExecStartPre=/usr/libexec/puu/oksa-discover-vllm-models
ExecStart=/usr/libexec/puu/oksa-plan-vllm-workloads
TimeoutStartSec=5h
TimeoutStopSec=180s
