config BR2_PACKAGE_GNOME_SETTINGS_DAEMON
	bool "gnome-settings-daemon"
	depends on BR2_PACKAGE_NETWORK_MANAGER
	depends on BR2_PACKAGE_PIPEWIRE
	depends on BR2_PACKAGE_UPOWER
	depends on BR2_INIT_SYSTEMD
	depends on BR2_PACKAGE_LIBGTK3
	depends on BR2_PACKAGE_PYTHON3 # gobject-introspection
	select BR2_PACKAGE_ALSA_LIB
	select BR2_PACKAGE_DBUS
	select BR2_PACKAGE_FONTCONFIG
	select BR2_PACKAGE_GEOCLUE
	select BR2_PACKAGE_GEOCODE_GLIB
	select BR2_PACKAGE_GNOME_DESKTOP
	select BR2_PACKAGE_GSETTINGS_DESKTOP_SCHEMAS
	select BR2_PACKAGE_LCMS2
	select BR2_PACKAGE_LIBCANBERRA
	select BR2_PACKAGE_LIBGLIB2
	select BR2_PACKAGE_LIBGUDEV
	select BR2_PACKAGE_LIBGWEATHER
	select BR2_PACKAGE_LIBNOTIFY
	select BR2_PACKAGE_PANGO
	select BR2_PACKAGE_POLKIT
	select BR2_PACKAGE_PULSEAUDIO
	select BR2_PACKAGE_WAYLAND
	select BR2_PACKAGE_XLIB_LIBX11
	select BR2_PACKAGE_XLIB_LIBXEXT
	select BR2_PACKAGE_XLIB_LIBXFIXES
	select BR2_PACKAGE_XLIB_LIBXI
	select BR2_PACKAGE_ADWAITA_FONTS
	select BR2_PACKAGE_SOUND_THEME_FREEDESKTOP
	help
	  GNOME Settings Daemon handles session-wide settings such
	  as keyboard shortcuts, display configuration, power, and
	  media keys.

	  https://gitlab.gnome.org/GNOME/gnome-settings-daemon
