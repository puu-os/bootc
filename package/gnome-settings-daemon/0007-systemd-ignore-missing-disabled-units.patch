+is_missing_unit_error (GError *error)
+{
+        g_autofree char *remote_error = NULL;
+
+        remote_error = g_dbus_error_get_remote_error (error);
+
+        return g_strcmp0 (remote_error, "org.freedesktop.systemd1.NoSuchUnit") == 0;
+}
