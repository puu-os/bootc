config BR2_PACKAGE_MUTTER
	bool "mutter"
	depends on BR2_PACKAGE_MESA3D
	depends on BR2_PACKAGE_GLYCIN
	depends on BR2_PACKAGE_LIBGTK4
	depends on BR2_PACKAGE_PIPEWIRE
	depends on BR2_PACKAGE_WAYLAND
	depends on BR2_PACKAGE_XWAYLAND
	depends on BR2_INIT_SYSTEMD
	depends on BR2_PACKAGE_GOBJECT_INTROSPECTION_ARCH_SUPPORTS
	depends on BR2_PACKAGE_PYTHON3 # gobject-introspection
	select BR2_PACKAGE_CAIRO
	select BR2_PACKAGE_COLORD
	select BR2_PACKAGE_LIBDISPLAY_INFO
	select BR2_PACKAGE_LIBDRM
	select BR2_PACKAGE_LIBEI
	select BR2_PACKAGE_LIBGRAPHEME
	select BR2_PACKAGE_HARFBUZZ
	select BR2_PACKAGE_LIBGLIB2
	select BR2_PACKAGE_GRAPHENE
	select BR2_PACKAGE_LIBINPUT
	select BR2_PACKAGE_PIXMAN
	select BR2_PACKAGE_LIBGUDEV
	select BR2_PACKAGE_GDK_PIXBUF
	select BR2_PACKAGE_GOBJECT_INTROSPECTION
	select BR2_PACKAGE_GNOME_DESKTOP
	select BR2_PACKAGE_GSETTINGS_DESKTOP_SCHEMAS
	select BR2_PACKAGE_WAYLAND_PROTOCOLS
	select BR2_PACKAGE_XKEYBOARD_CONFIG
	select BR2_PACKAGE_XLIB_LIBX11
	select BR2_PACKAGE_XLIB_LIBXAU
	select BR2_PACKAGE_XLIB_LIBXCOMPOSITE
	select BR2_PACKAGE_XLIB_LIBXCURSOR
	select BR2_PACKAGE_XLIB_LIBXDAMAGE
	select BR2_PACKAGE_XLIB_LIBXEXT
	select BR2_PACKAGE_XLIB_LIBXFIXES
	select BR2_PACKAGE_XLIB_LIBXI
	select BR2_PACKAGE_XLIB_LIBXINERAMA
	select BR2_PACKAGE_XLIB_LIBXRANDR
	select BR2_PACKAGE_LIBXCB
	select BR2_PACKAGE_STARTUP_NOTIFICATION
	help
	  Mutter is the Wayland compositor and window manager used
	  by GNOME Shell.

	  https://gitlab.gnome.org/GNOME/mutter

comment "mutter needs GTK4, Xwayland and python3"
	depends on BR2_PACKAGE_GOBJECT_INTROSPECTION_ARCH_SUPPORTS
	depends on BR2_PACKAGE_MESA3D
	depends on BR2_PACKAGE_GLYCIN
	depends on BR2_PACKAGE_PIPEWIRE
	depends on BR2_PACKAGE_WAYLAND
	depends on BR2_INIT_SYSTEMD
	depends on !BR2_PACKAGE_LIBGTK4 || \
		!BR2_PACKAGE_XWAYLAND || \
		!BR2_PACKAGE_PYTHON3
