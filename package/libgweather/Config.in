config BR2_PACKAGE_LIBGWEATHER
	bool "libgweather"
	depends on BR2_PACKAGE_LIBSOUP3
	depends on BR2_PACKAGE_GOBJECT_INTROSPECTION_ARCH_SUPPORTS
	depends on BR2_PACKAGE_PYTHON3 # gobject-introspection
	select BR2_PACKAGE_GEOCODE_GLIB
	select BR2_PACKAGE_GWEATHER_LOCATIONS
	select BR2_PACKAGE_LIBGLIB2
	select BR2_PACKAGE_LIBXML2
	select BR2_PACKAGE_GOBJECT_INTROSPECTION
	select BR2_PACKAGE_JSON_GLIB
	help
	  Library used by GNOME applications to access weather data.
	  gnome-settings-daemon's night-light/location plugin and the
	  GNOME Weather application use this.

	  https://gitlab.gnome.org/GNOME/libgweather

comment "libgweather needs python3"
	depends on BR2_PACKAGE_LIBSOUP3
	depends on BR2_PACKAGE_GOBJECT_INTROSPECTION_ARCH_SUPPORTS
	depends on !BR2_PACKAGE_PYTHON3
