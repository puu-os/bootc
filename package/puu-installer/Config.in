config BR2_PACKAGE_PUU_INSTALLER
	bool "puu-installer"
	depends on BR2_aarch64 || BR2_i386 || BR2_x86_64 # systemd-boot
	depends on BR2_INSTALL_LIBSTDCPP
	depends on BR2_TOOLCHAIN_HAS_THREADS
	depends on BR2_TOOLCHAIN_HEADERS_AT_LEAST_5_9 # xfsprogs
	depends on BR2_USE_MMU
	depends on BR2_USE_WCHAR
	depends on !BR2_STATIC_LIBS
	depends on BR2_TOOLCHAIN_GCC_AT_LEAST_10 # C++20
	depends on BR2_PACKAGE_BOOTC
	depends on BR2_PACKAGE_LIBABSEIL_CPP_ARCH_SUPPORTS
	depends on BR2_PACKAGE_LIBURCU_ARCH_SUPPORTS # xfsprogs
	depends on BR2_INIT_SYSTEMD
	select BR2_PACKAGE_DOSFSTOOLS
	select BR2_PACKAGE_DOSFSTOOLS_MKFS_FAT
	select BR2_PACKAGE_E2FSPROGS
	select BR2_PACKAGE_LIBABSEIL_CPP
	select BR2_PACKAGE_OPENSSL
	select BR2_PACKAGE_SYSTEMD_BOOT
	select BR2_PACKAGE_UTIL_LINUX
	select BR2_PACKAGE_UTIL_LINUX_LIBBLKID
	select BR2_PACKAGE_UTIL_LINUX_UNSHARE
	select BR2_PACKAGE_XFSPROGS
	help
	  Installer for Puu OS images.

	  https://gitlab.com/puu-os/installer
