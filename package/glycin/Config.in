config BR2_PACKAGE_GLYCIN
	bool "glycin"
	depends on BR2_USE_MMU # bubblewrap
	depends on BR2_INSTALL_LIBSTDCPP
	depends on BR2_PACKAGE_HOST_RUSTC_TARGET_ARCH_SUPPORTS
	depends on BR2_TOOLCHAIN_GCC_AT_LEAST_7 # libjxl
	depends on BR2_TOOLCHAIN_HAS_ATOMIC # libjxl
	depends on BR2_TOOLCHAIN_HAS_THREADS # libjxl
	depends on !BR2_STATIC_LIBS # libjxl
	depends on !BR2_TOOLCHAIN_HAS_GCC_BUG_81426 # libjxl
	select BR2_PACKAGE_BUBBLEWRAP # runtime
	select BR2_PACKAGE_FONTCONFIG
	select BR2_PACKAGE_HOST_RUSTC
	select BR2_PACKAGE_LCMS2
	select BR2_PACKAGE_LIBGLIB2
	select BR2_PACKAGE_LIBJXL
	select BR2_PACKAGE_LIBSECCOMP
	help
	  Glycin is a sandboxed and extendable image loading and
	  editing library, used by mutter to load wallpaper and
	  background images.  Includes the JPEG XL loader used
	  by GNOME 49 wallpapers.

	  https://gitlab.gnome.org/GNOME/glycin

comment "glycin needs a toolchain w/ C++, threads, gcc >= 7, dynamic library"
	depends on BR2_USE_MMU
	depends on BR2_PACKAGE_HOST_RUSTC_TARGET_ARCH_SUPPORTS
	depends on BR2_TOOLCHAIN_HAS_ATOMIC
	depends on !BR2_TOOLCHAIN_HAS_GCC_BUG_81426
	depends on !BR2_INSTALL_LIBSTDCPP || \
		!BR2_TOOLCHAIN_GCC_AT_LEAST_7 || \
		!BR2_TOOLCHAIN_HAS_THREADS || \
		BR2_STATIC_LIBS
