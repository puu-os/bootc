+        ret_spec->type = FSCRYPT_KEY_SPEC_TYPE_DESCRIPTOR;
+        memcpy(ret_spec->u.descriptor, policy_v1.master_key_descriptor, FSCRYPT_KEY_DESCRIPTOR_SIZE);
+        return 0;
+}
